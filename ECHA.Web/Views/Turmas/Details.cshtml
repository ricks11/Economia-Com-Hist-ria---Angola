@model EconomiaComHistoria.Core.DTOs.TurmaDetalheDto
@using EconomiaComHistoria.Core.DTOs

@{
    ViewData["Title"] = $"Detalhes da Turma: {Model.Nome}";
    // Resgata a lista de alunos que podem ser adicionados à turma
    var alunosDisponiveis = ViewData["AlunosDisponiveis"] as IEnumerable<UtilizadorModeracaoDto>
    ?? new List<UtilizadorModeracaoDto>
        ();
        var semAlunosDisponiveis = !alunosDisponiveis.Any();
        }

        <main class="pt-12 pb-12 px-6 max-w-7xl mx-auto">
            @if (TempData["SuccessMessage"] != null)
            {
            <div class="mb-6 p-4 bg-green-50 dark:bg-green-950/30 border-l-4 border-green-500 text-green-800 dark:text-green-300 rounded-r-xl shadow-sm flex items-center gap-3">
                <span class="material-symbols-outlined text-green-600">check_circle</span>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
            <div class="mb-6 p-4 bg-red-50 dark:bg-red-950/30 border-l-4 border-red-500 text-red-800 dark:text-red-300 rounded-r-xl shadow-sm flex items-center gap-3">
                <span class="material-symbols-outlined text-red-600">error</span>
                <span class="font-medium">@TempData["ErrorMessage"]</span>
            </div>
            }

            <!-- Header -->
            <header class="mb-8 flex justify-between items-start flex-wrap gap-4">
                <div>
                    <h1 class="text-3xl font-headline font-extrabold text-primary tracking-tight">@Model.Nome</h1>
                    <p class="text-stone-500 text-sm mt-1">
                        @Model.EscolaNome • Professor: <span class="font-semibold text-stone-700">@(Model.ProfessorNome ?? "Não atribuído")</span>
                    </p>
                </div>
                <div class="flex gap-3">
                    <button onclick="document.getElementById('add-aluno-modal').showModal()"
                            class="px-5 py-2.5 rounded-full bg-primary text-white font-bold hover:shadow-lg transition-colors decoration-none flex items-center gap-2 text-sm">
                        <span class="material-symbols-outlined text-sm">person_add</span> Adicionar Aluno
                    </button>
                    <a asp-action="Index" asp-route-escolaId="@Model.EscolaId" class="px-5 py-2.5 rounded-full bg-stone-100 text-stone-600 font-bold hover:bg-stone-200 transition-colors decoration-none flex items-center gap-2 text-sm">
                        <span class="material-symbols-outlined text-sm">arrow_back</span> Voltar
                    </a>
                </div>
            </header>

            <!-- Students Performance Card & Table -->
            <div class="bg-surface-container-lowest rounded-3xl p-6 border border-stone-200/60 shadow-sm overflow-hidden">
                <h2 class="text-lg font-headline font-bold text-stone-800 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">groups</span>
                    Alunos da Turma (@Model.Alunos.Count)
                </h2>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-stone-100 table-fixed sm:table-auto">
                        <thead>
                            <tr class="text-stone-400 text-xs font-bold uppercase tracking-wider">
                                <th class="px-6 py-4 text-left w-2/5">Nome</th>
                                <th class="px-6 py-4 text-left w-2/5">Email</th>
                                <th class="px-6 py-4 text-center w-1/5">Pontos Totais</th>
                                <th class="px-6 py-4 text-center w-1/5">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-stone-100 text-stone-700">
                            @foreach (var aluno in Model.Alunos)
                            {
                            <tr class="hover:bg-stone-50/50 transition">
                                <td class="px-6 py-4 font-medium text-stone-900 truncate">
                                    @aluno.Nome
                                </td>
                                <td class="px-6 py-4 text-sm text-stone-500 truncate">
                                    @aluno.Email
                                </td>
                                <td class="px-6 py-4 text-center text-sm font-bold text-primary">
                                    @aluno.PontosTotais PTS
                                </td>
                                <td class="px-6 py-4 text-center text-sm">
                                    <form asp-action="RemoverAluno" asp-route-turmaId="@Model.Id" asp-route-alunoId="@aluno.Id" method="post" class="inline" onsubmit="return confirm('Remover este aluno da turma?')">
                                        <button type="submit" class="text-red-500 hover:text-red-700 transition-colors" title="Remover aluno">
                                            <span class="material-symbols-outlined text-sm">person_remove</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            }
                            @if (!Model.Alunos.Any())
                            {
                            <tr>
                                <td colspan="4" class="text-center py-10 text-stone-400">
                                    <span class="material-symbols-outlined text-4xl block mb-2 opacity-50">group_off</span>
                                    Nenhum aluno associado a esta turma.
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <!-- Modal para Adicionar Aluno Atualizado -->
        <dialog id="add-aluno-modal" class="backdrop:bg-stone-900/60 p-0 rounded-2xl border-0 shadow-xl max-w-md w-full bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-200">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100 dark:border-stone-800">
                    <h3 class="font-headline font-bold text-lg text-primary flex items-center gap-1.5">
                        <span class="material-symbols-outlined">person_add</span> Adicionar Aluno
                    </h3>
                    <button type="button" onclick="document.getElementById('add-aluno-modal').close()" class="text-stone-400 hover:text-stone-600">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <form asp-action="AdicionarAluno" method="post" class="space-y-4">
                    <input type="hidden" name="turmaId" value="@Model.Id" />

                    <div>
                        <label class="block text-xs font-bold text-stone-500 uppercase tracking-wider mb-2">Selecionar Aluno</label>
                        <select name="alunoId" required
                                class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 text-stone-900 dark:text-stone-100"
                                @(semAlunosDisponiveis ? "disabled" : "" )>
                            <option value="">Escolha um estudante...</option>
                            @foreach (var aluno in alunosDisponiveis)
                            {
                            <option value="@aluno.Id">@aluno.Nome (@aluno.Email)</option>
                            }
                        </select>

                        @if (semAlunosDisponiveis)
                        {
                        <p class="text-amber-600 dark:text-amber-400 text-xs mt-2 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">warning</span> Não existem alunos novos disponíveis no sistema para associar.
                        </p>
                        }
                        else
                        {
                        <p class="text-xs text-stone-400 mt-1">Apenas são listados os utilizadores registados com a função de Aluno.</p>
                        }
                    </div>

                    <div class="flex justify-end gap-2 pt-2">
                        <button type="button" onclick="document.getElementById('add-aluno-modal').close()"
                                class="px-4 py-2 text-sm font-semibold rounded-xl text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="px-5 py-2 text-sm font-bold rounded-xl bg-primary hover:bg-primary/90 text-white shadow-sm @(semAlunosDisponiveis ? "opacity-50 cursor-not-allowed" : "" )"
                                @(semAlunosDisponiveis ? "disabled" : "" )>
                            Adicionar
                        </button>
                    </div>
                </form>
            </div>
        </dialog>
