@model IEnumerable<EconomiaComHistoria.Core.DTOs.TurmaResponseDto>
    @{
    ViewData["Title"] = "Gestão de Turmas";
    var escolaIdQuery = Context.Request.Query["escolaId"].ToString();
    }

    <main class="max-w-7xl mx-auto px-4 py-8 space-y-8">
        <!-- Alertas de feedback -->
        @if (TempData["SuccessMessage"] != null)
        {
        <div class="p-4 bg-green-50 dark:bg-green-950/20 border-l-4 border-green-500 text-green-800 dark:text-green-300 rounded-r-xl shadow-sm flex items-center gap-3 transition-all">
            <span class="material-symbols-outlined text-green-600 dark:text-green-400">check_circle</span>
            <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
        </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
        <div class="p-4 bg-red-50 dark:bg-red-950/20 border-l-4 border-red-500 text-red-800 dark:text-red-300 rounded-r-xl shadow-sm flex items-center gap-3 transition-all">
            <span class="material-symbols-outlined text-red-600 dark:text-red-400">error</span>
            <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
        </div>
        }

        <!-- Cabeçalho Principal (Largura Total) -->
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-stone-100 dark:border-stone-800/80">
            <div>
                <h1 class="text-2xl md:text-3xl font-headline font-extrabold text-stone-900 dark:text-stone-100 tracking-tight">
                    Gestão de Turmas
                </h1>
                <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 mt-1">
                    Visualize e gerencie as turmas ativas nas escolas parceiras.
                </p>
            </div>
            @if (!string.IsNullOrEmpty(escolaIdQuery))
            {
            <a asp-action="Create" asp-route-escolaId="@escolaIdQuery" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-stone-900 hover:bg-stone-800 dark:bg-stone-100 dark:hover:bg-stone-200 text-white dark:text-stone-900 font-bold text-sm shadow-sm transition-all decoration-none">
                <span class="material-symbols-outlined text-sm font-bold">add</span> Nova Turma
            </a>
            }
        </header>

        <!-- Grelha de Turmas -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
            <div class="bg-white dark:bg-stone-900 rounded-3xl p-6 border border-stone-200/70 dark:border-stone-800/80 ambient-shadow flex flex-col justify-between hover:border-stone-300 dark:hover:border-stone-700/80 transition-all">
                <div>
                    <!-- Nome da Turma -->
                    <div class="flex justify-between items-start gap-4 mb-4">
                        <h3 class="font-headline font-bold text-lg md:text-xl text-stone-900 dark:text-stone-100 line-clamp-1">
                            @item.Nome
                        </h3>
                        <span class="shrink-0 text-[11px] bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400 px-2.5 py-0.5 rounded-md font-mono font-bold">
                            Ano @item.Ano
                        </span>
                    </div>

                    <!-- Detalhes da Associação -->
                    <div class="space-y-2.5 text-xs text-stone-600 dark:text-stone-400 mb-6">
                        <p class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-stone-400 text-base">school</span>
                            <span class="truncate"><strong>Escola:</strong> @item.EscolaNome</span>
                        </p>
                        <p class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-stone-400 text-base">badge</span>
                            <span class="truncate"><strong>Professor:</strong> @item.ProfessorNome</span>
                        </p>
                    </div>

                    <!-- Métrica de Alunos -->
                    <div class="py-3 px-4 mb-6 rounded-2xl bg-stone-50 dark:bg-stone-850/40 border border-stone-100 dark:border-stone-800/60 flex items-center justify-between">
                        <span class="text-xs text-stone-500 dark:text-stone-400 font-medium flex items-center gap-2">
                            <span class="material-symbols-outlined text-stone-400 text-base">group</span> Total de Alunos
                        </span>
                        <strong class="text-sm font-extrabold text-stone-900 dark:text-stone-100">@item.TotalAlunos</strong>
                    </div>
                </div>

                <!-- Ações Operacionais -->
                <div class="space-y-2 pt-2 border-t border-stone-50 dark:border-stone-850/40">
                    <a asp-action="Details" asp-route-id="@item.Id" class="block w-full py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 dark:bg-stone-100 dark:hover:bg-stone-200 text-white dark:text-stone-900 font-bold text-xs text-center transition-colors decoration-none shadow-sm">
                        Ver Progresso
                    </a>

                    <div class="grid grid-cols-2 gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="py-2 rounded-xl bg-stone-100 hover:bg-stone-200 dark:bg-stone-800 dark:hover:bg-stone-750 text-stone-700 dark:text-stone-300 font-bold text-xs text-center transition-colors decoration-none">
                            Editar
                        </a>
                        <button type="button" onclick="abrirModalEliminar('@Url.Action("Delete", new { id=item.Id, escolaId=item.EscolaId })', '@item.Nome' )"
                                class="w-full py-2 rounded-xl bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/30 text-red-600 dark:text-red-400 font-bold text-xs transition-colors border border-red-100/30 dark:border-red-900/20">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>
            }

            <!-- Empty State Modernizado -->
            @if (!Model.Any())
            {
            <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-16 bg-white dark:bg-stone-900 rounded-3xl border border-dashed border-stone-200 dark:border-stone-800/80 p-8">
                <span class="material-symbols-outlined text-5xl text-stone-300 dark:text-stone-700 block mb-3">group_off</span>
                <h4 class="font-headline font-bold text-stone-900 dark:text-stone-100 text-base">Nenhuma turma registada</h4>
                <p class="text-xs text-stone-500 dark:text-stone-400 mt-1 max-w-xs mx-auto">
                    Não encontrámos turmas ativas configuradas para os parâmetros selecionados.
                </p>
                @if (!string.IsNullOrEmpty(escolaIdQuery))
                {
                <a asp-action="Create" asp-route-escolaId="@escolaIdQuery" class="inline-flex items-center gap-2 mt-4 px-5 py-2 rounded-full bg-stone-100 hover:bg-stone-200 dark:bg-stone-800 dark:hover:bg-stone-750 text-stone-800 dark:text-stone-200 font-bold text-xs transition-colors decoration-none">
                    Criar Primeira Turma
                </a>
                }
            </div>
            }
        </section>
    </main>

    <!-- Modal Nativo HTML5 para Confirmação de Eliminação -->
    <dialog id="modalEliminar" class="backdrop:bg-stone-900/60 p-0 rounded-2xl border-0 shadow-xl max-w-md w-full bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-200">
        <div class="p-6">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100 dark:border-stone-800">
                <h3 class="font-headline font-bold text-lg text-stone-900 dark:text-stone-100 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-red-600">delete_forever</span> Eliminar Turma
                </h3>
                <button type="button" onclick="fecharModalEliminar()" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <p class="text-xs text-stone-500 dark:text-stone-400 mb-6 leading-relaxed">
                Tens a certeza absoluta que pretendes eliminar a turma <span id="nomeTurmaTarget" class="font-bold text-stone-900 dark:text-stone-100"></span>?<br><br>
                Esta ação é irreversível e irá desligar permanentemente todos os alunos associados e históricos de progresso ligados a esta turma.
            </p>

            <form id="formEliminar" method="post" class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="fecharModalEliminar()" class="px-4 py-2 text-sm font-semibold rounded-xl text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 text-sm font-bold rounded-xl bg-red-600 hover:bg-red-700 text-white shadow-sm transition-colors">
                    Confirmar Eliminação
                </button>
            </form>
        </div>
    </dialog>

    <script>
        function abrirModalEliminar(actionUrl, nomeTurma) {
            const targetText = document.getElementById('nomeTurmaTarget');
            if (targetText) targetText.innerText = nomeTurma;

            const form = document.getElementById('formEliminar');
            if (form) {
                form.action = actionUrl;
            }

            const dialog = document.getElementById('modalEliminar');
            if (dialog) {
                dialog.showModal();
            }
        }

        function fecharModalEliminar() {
            const dialog = document.getElementById('modalEliminar');
            if (dialog) {
                dialog.close();
            }
        }
    </script>
