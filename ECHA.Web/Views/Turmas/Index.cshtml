@model IEnumerable<EconomiaComHistoria.Core.DTOs.TurmaResponseDto>
@{
    ViewData["Title"] = "Gestão de Turmas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    @if (Context.Request.Query.ContainsKey("escolaId")) {
        <a asp-action="Create" asp-route-escolaId="@Context.Request.Query["escolaId"]" class="btn btn-success">Nova Turma</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover bg-white border">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Ano</th>
                <th>Escola</th>
                <th>Professor</th>
                <th class="text-center">Alunos</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Nome</strong></td>
                    <td>@item.Ano</td>
                    <td>@item.EscolaNome</td>
                    <td>@item.ProfessorNome</td>
                    <td class="text-center">@item.TotalAlunos</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver Progresso</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
