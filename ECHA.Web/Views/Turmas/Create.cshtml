@model EconomiaComHistoria.Core.DTOs.CreateTurmaDto
@{
    ViewData["Title"] = "Criar Nova Turma";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" class="card shadow-sm p-4">
            <input type="hidden" asp-for="EscolaId" />
            
            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome da Turma (ex: 10ª A)</label>
                <input asp-for="Nome" class="form-control" required />
            </div>
            
            <div class="mb-3">
                <label asp-for="Ano" class="form-label">Ano Letivo</label>
                <input asp-for="Ano" type="number" class="form-control" value="2026" />
            </div>

            <div class="mb-3">
                <label asp-for="ProfessorId" class="form-label">ID do Professor (Opcional)</label>
                <input asp-for="ProfessorId" type="number" class="form-control" />
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Criar Turma</button>
                <a asp-action="Index" asp-route-escolaId="@Model.EscolaId" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
