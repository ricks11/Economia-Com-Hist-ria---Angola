@using EconomiaComHistoria.Core.DTOs
@model EconomiaComHistoria.Core.DTOs.UpdateTurmaDto

@{
    ViewData["Title"] = "Editar Turma";
    var professores = ViewData["Professores"] as IEnumerable<UtilizadorModeracaoDto>
    ?? new List<UtilizadorModeracaoDto>
        ();
        var semProfessores = !professores.Any();
        var escolaId = ViewData["EscolaId"];
        }

        <main class="max-w-4xl mx-auto px-4 py-8 space-y-8">
            <!-- Alertas de feedback -->
            @if (TempData["SuccessMessage"] != null)
            {
            <div class="p-4 bg-green-50 dark:bg-green-950/20 border-l-4 border-green-500 text-green-800 dark:text-green-300 rounded-r-xl shadow-sm flex items-center gap-3 transition-all">
                <span class="material-symbols-outlined text-green-600 dark:text-green-400">check_circle</span>
                <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
            </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
            <div class="p-4 bg-red-50 dark:bg-red-950/20 border-l-4 border-red-500 text-red-800 dark:text-red-300 rounded-r-xl shadow-sm flex items-center gap-3 transition-all">
                <span class="material-symbols-outlined text-red-600 dark:text-red-400">error</span>
                <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
            </div>
            }

            <!-- Cabeçalho -->
            <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-stone-100 dark:border-stone-800/80">
                <div>
                    <h1 class="text-2xl md:text-3xl font-headline font-extrabold text-stone-900 dark:text-stone-100 tracking-tight">
                        Editar Turma
                    </h1>
                    <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 mt-1">
                        Atualizar as informações de registo e atribuição da turma.
                    </p>
                </div>
                <a asp-action="Index" asp-route-escolaId="@escolaId" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-stone-100 hover:bg-stone-200 dark:bg-stone-800 dark:hover:bg-stone-750 text-stone-700 dark:text-stone-300 font-bold text-sm shadow-sm transition-all decoration-none">
                    Voltar
                </a>
            </header>

            <!-- Formulário Operacional -->
            <section class="bg-white dark:bg-stone-900 rounded-3xl p-6 md:p-8 border border-stone-200/70 dark:border-stone-800/80 ambient-shadow">
                <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values[" id"]" method="post" class="space-y-6">

                    <div>
                        <label asp-for="Nome" class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">Nome da Turma</label>
                        <input asp-for="Nome" class="w-full px-4 py-3 rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-850/40 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-500 text-sm" placeholder="Ex: 10ª Classe - Turma A" required />
                        <span asp-validation-for="Nome" class="text-red-600 dark:text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Ano" class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">Ano Letivo</label>
                        <input asp-for="Ano" type="number" class="w-full px-4 py-3 rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-850/40 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-500 text-sm" required />
                        <span asp-validation-for="Ano" class="text-red-600 dark:text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <!-- Dropdown de Professores Unificado -->
                    <div>
                        <label asp-for="ProfessorId" class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">Professor Responsável</label>
                        <select asp-for="ProfessorId" class="w-full px-4 py-3 rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-850/40 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-500 text-sm" required>
                            <option value="">Selecione um professor...</option>
                            @foreach (var prof in professores)
                            {
                            <option value="@prof.Id">@prof.Nome</option>
                            }
                        </select>
                        <span asp-validation-for="ProfessorId" class="text-red-600 dark:text-red-400 text-xs mt-1 block"></span>
                        @if (semProfessores)
                        {
                        <p class="text-amber-600 dark:text-amber-400 text-xs mt-2 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">warning</span> Não existem professores registados. <a asp-controller="Admin" asp-action="Utilizadores" class="underline font-semibold">Crie um professor primeiro.</a>
                        </p>
                        }
                    </div>

                    <!-- Botões de Ação -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-stone-100 dark:border-stone-800/60">
                        <button type="submit" class="flex-1 order-2 sm:order-1 py-3 rounded-xl bg-stone-900 hover:bg-stone-800 dark:bg-stone-100 dark:hover:bg-stone-200 text-white dark:text-stone-900 font-bold text-sm transition-all border-none @(semProfessores ? " opacity-50 cursor-not-allowed" : "" )" @(semProfessores ? "disabled" : "" )>
                            Salvar Alterações
                        </button>
                        <a asp-action="Index" asp-route-escolaId="@escolaId" class="flex-1 order-1 sm:order-2 py-3 rounded-xl bg-stone-100 hover:bg-stone-200 dark:bg-stone-800 dark:hover:bg-stone-750 text-stone-700 dark:text-stone-300 font-bold text-sm text-center transition-colors decoration-none">
                            Cancelar
                        </a>
                    </div>
                </form>
            </section>
        </main>

        @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        }
