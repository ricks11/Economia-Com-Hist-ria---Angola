@{
    ViewData["Title"] = "Painel do Explorador";
}

<div class="max-w-7xl mx-auto px-6">
    <!-- Welcome Section -->
    <header class="mb-12">
        <h1 class="font-headline font-extrabold text-4xl md:text-5xl text-primary tracking-tight mb-2">Painel do Explorador</h1>
        <p class="font-body text-lg text-secondary max-w-2xl leading-relaxed">
            Bem-vindo ao centro nevrálgico da investigação económica angolana. Seleccione um dos eixos abaixo para iniciar a sua jornada histórica.
        </p>
    </header>

    <!-- Bento Grid Menu -->
    <div class="grid grid-cols-1 md:grid-cols-6 lg:grid-cols-12 gap-6">
        <!-- Large Card: Explorar Conteúdos -->
        <a asp-controller="Conteudos" asp-action="Index" class="md:col-span-6 lg:col-span-8 group relative overflow-hidden bg-surface-container-lowest rounded-[20px] p-8 text-left soft-elevation hover:-translate-y-1 transition-all duration-300 decoration-none">
            <div class="relative z-10 flex flex-col h-full justify-between">
                <div>
                    <div class="bg-primary/5 w-14 h-14 rounded-full flex items-center justify-center mb-6 text-primary">
                        <span class="material-symbols-outlined text-3xl">library_books</span>
                    </div>
                    <h2 class="font-headline font-bold text-2xl text-on-surface mb-2">Explorar Conteúdos</h2>
                    <p class="text-secondary leading-snug max-w-md">Aceda ao arquivo completo de lições, documentos históricos e análise macroeconómica de Angola.</p>
                </div>
                <div class="mt-8 flex items-center text-primary font-semibold">
                    <span>Iniciar Pesquisa</span>
                    <span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </div>
            </div>
            <div class="absolute right-0 bottom-0 w-1/2 h-full opacity-10 grayscale group-hover:grayscale-0 group-hover:opacity-20 transition-all duration-500">
                <img alt="Old manuscripts and books" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBH-frLzmNnKNQJTNpwZKRIKQKXaV9c7lk-pttPygLK4_uxMBCW5cLpl2HtVLMIsSeoG3Y7iqisiK8JJ7Zmw55MZgMmQ4OgrrIMSUul0gTva5q11lw_AkPcdCXIRIkV4js-MS-6KtFqwtw6LoY_uZXsz20vSm0fvMnBs7LhDFNTsLi7v522tXnV2U-N2ZOAO9-CYM58snbL86ZVrwNtLB8VyEYkLFEXLLmjPNS3Okdv6CWnq3FaRz-ak6g35uQBkODkxCrnEpFi8Qw"/>
            </div>
        </a>

        <!-- Card: Quiz Interactivo -->
        <a asp-controller="Quizzes" asp-action="Index" class="md:col-span-3 lg:col-span-4 bg-surface-container-lowest rounded-[20px] p-8 text-left soft-elevation hover:-translate-y-1 transition-all duration-300 group decoration-none">
            <div class="bg-tertiary-container/20 w-12 h-12 rounded-full flex items-center justify-center mb-6 text-tertiary-container">
                <span class="material-symbols-outlined text-2xl">quiz</span>
            </div>
            <h2 class="font-headline font-bold text-xl text-on-surface mb-2">Quiz Interactivo</h2>
            <p class="text-secondary text-sm">Teste os seus conhecimentos sobre a evolução económica do país através de desafios dinâmicos.</p>
            <div class="mt-6 flex items-center text-tertiary font-semibold text-sm">
                <span>Desafiar-se</span>
                <span class="material-symbols-outlined ml-1 text-base">chevron_right</span>
            </div>
        </a>

        <!-- Card: Fórum de Discussão -->
        <a href="#" class="md:col-span-3 lg:col-span-4 bg-surface-container-lowest rounded-[20px] p-8 text-left soft-elevation hover:-translate-y-1 transition-all duration-300 group decoration-none">
            <div class="bg-secondary-container w-12 h-12 rounded-full flex items-center justify-center mb-6 text-secondary">
                <span class="material-symbols-outlined text-2xl">forum</span>
            </div>
            <h2 class="font-headline font-bold text-xl text-on-surface mb-2">Fórum de Discussão</h2>
            <p class="text-secondary text-sm">Participe em debates académicos e troque ideias com outros investigadores e estudantes.</p>
            <div class="mt-6 flex items-center text-primary font-semibold text-sm">
                <span>Entrar no Debate</span>
                <span class="material-symbols-outlined ml-1 text-base">chevron_right</span>
            </div>
        </a>

        <!-- Card: Comentários e Participação -->
        <a href="#" class="md:col-span-3 lg:col-span-4 bg-surface-container-lowest rounded-[20px] p-8 text-left soft-elevation hover:-translate-y-1 transition-all duration-300 group decoration-none">
            <div class="bg-primary/5 w-12 h-12 rounded-full flex items-center justify-center mb-6 text-primary">
                <span class="material-symbols-outlined text-2xl">rate_review</span>
            </div>
            <h2 class="font-headline font-bold text-xl text-on-surface mb-2">Comentários</h2>
            <p class="text-secondary text-sm">A sua voz é fundamental. Partilhe as suas reflexões sobre as lições e conteúdos disponíveis.</p>
            <div class="mt-6 flex items-center text-primary font-semibold text-sm">
                <span>Ver Participações</span>
                <span class="material-symbols-outlined ml-1 text-base">chevron_right</span>
            </div>
        </a>

        <!-- Card: Subscrição e Perfil -->
        <a asp-controller="Perfil" asp-action="Index" class="md:col-span-3 lg:col-span-4 bg-surface-container-lowest rounded-[20px] p-8 text-left soft-elevation hover:-translate-y-1 transition-all duration-300 group overflow-hidden relative decoration-none">
            <div class="relative z-10">
                <div class="bg-primary/5 w-12 h-12 rounded-full flex items-center justify-center mb-6 text-primary">
                    <span class="material-symbols-outlined text-2xl">person_add</span>
                </div>
                <h2 class="font-headline font-bold text-xl text-on-surface mb-2">Perfil e Progresso</h2>
                <p class="text-secondary text-sm">Gerencie a sua conta e acompanhe o seu progresso na exploração do património angolano.</p>
            </div>
            <div class="absolute -right-4 -bottom-4 opacity-5">
                <span class="material-symbols-outlined text-[100px]">notifications</span>
            </div>
        </a>
    </div>
</div>
