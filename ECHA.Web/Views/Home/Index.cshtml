@using EconomiaComHistoria.Core.DTOs
@{
    // Extração e casting seguro de dados para evitar código repetitivo no HTML
    var perfil = ViewData["Perfil"] as PerfilResponseDto;
    var progresso = ViewData["Progresso"] as ProgressoUtilizadorDto;

    // Definição de fallbacks limpos
    var nomeUtilizador = perfil?.Nome ?? "Explorador";
    var pontos = progresso?.PontosTotais ?? 0;
    var nivel = progresso?.Nivel ?? 1;
    var streak = progresso?.StreakAtual ?? 0;
    var percentagemNivel = progresso?.PercentagemNivel ?? 0.0;
    var ultimoBadge = progresso?.Badges?.LastOrDefault();
}

@if (User.Identity?.IsAuthenticated == true)
{
    ViewData["Title"] = "Início - Economia com História – Angola";

<!-- Main Content Area -->
<div class="grid grid-cols-12 gap-6 lg:gap-8 relative animate-fade-in">

    <!-- Center Column: Welcome & Map -->
    <section class="col-span-12 lg:col-span-8 space-y-6 lg:space-y-8">

        <!-- Welcome Banner -->
        <div class="relative overflow-hidden bg-surface-container-lowest p-8 md:p-10 rounded-2xl border border-stone-200/40 shadow-sm transition-all hover:shadow-md duration-300">
            <div class="relative z-10 max-w-lg">
                <span class="inline-flex items-center gap-1.5 bg-rose-50 dark:bg-rose-950/30 text-primary dark:text-rose-300 text-xs font-bold px-3 py-1 rounded-full mb-4">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary dark:bg-rose-400 animate-pulse"></span>
                    Portal do Conhecimento
                </span>
                <h2 class="text-3xl md:text-4xl font-extrabold text-primary tracking-tight mb-3 font-headline">
                    Bem-vindo, @nomeUtilizador.
                </h2>
                <p class="text-on-surface-variant text-base md:text-lg leading-relaxed font-normal mb-6">
                    Explore o rico tapeçário da economia angolana através dos séculos. Hoje, o arquivo destaca a transição monetária da era colonial para a independência.
                </p>
                <a href="@Url.Action("Index", "Conteudos" )" class="bg-accent-yellow text-on-accent-yellow px-6 py-3.5 rounded-xl font-bold inline-flex items-center gap-2 hover:bg-yellow-500 hover:scale-[1.02] transition-all duration-200 no-underline shadow-sm hover:shadow-md">
                    Iniciar Jornada Histórica
                    <span class="material-symbols-outlined text-base">arrow_forward</span>
                </a>
            </div>

            <!-- Stylized Background Map Fragment -->
            <div class="absolute -right-16 -bottom-16 w-80 md:w-[500px] opacity-[0.06] dark:opacity-[0.03] pointer-events-none transform -rotate-12 transition-transform duration-700 hover:rotate-0">
                <img class="w-full grayscale contrast-125 select-none" alt="Mapa de Angola" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAaknjhJy_-l6CFHYhqe_5mAgvSAwuH14KdV2Et5Wv1OPqiNrf3fv2CZ75TbWKCkfN4zGJWGh5xERX4mrFZZ_-grtdKi8Ew6rhOWmR392qWZzjiz_L1ylF2TKoZ8AsbJsI85vO_hmWWSc6hs0h01vIYMmm2Nl_-0A-cd4kBP4VXIqtk8anJUbyfEahdgx-oLaHiTUdhSNu7b7zHJt_xhmsnwXU3Sk43Bc-ZjeoAtoxrER6GQl5G2shtjDqzX18_Dt88anAwCLhI1aJw" />
            </div>
        </div>

        <!-- Bento Card Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Bento Card: Featured Era -->
            <a href="@Url.Action("Index", "Conteudos" )" class="bg-surface-container-low p-5 rounded-2xl relative group cursor-pointer hover:shadow-md transition-all duration-300 border border-stone-200/30 flex flex-col justify-between no-underline text-on-surface">
                <div>
                    <div class="h-44 mb-4 rounded-xl overflow-hidden bg-stone-200 relative">
                        <div class="absolute inset-0 bg-gradient-to-t from-stone-950/40 via-transparent to-transparent z-10 opacity-60 group-hover:opacity-40 transition-opacity"></div>
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Ciclo do Sal" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCZOq7POI16IzSbZj3dU__oLDl5-E94mw7j2LP_ftWsmNvR6zuxrlt6_mMZGz8tNN4_4Q6XJZh1ZmX859zIvIdE6zHIfYujM5HE7WaavBZ0TLmOSwKvXsHr8wBxHKTPDRNwjJqbr5jS-1P-6Rck1LMIEAW0UmUC-XJEjmtoAhZBuqmWfQU0kIDtlqdnLQIijjvUZ6t3bXVlgDK1cZWTCU9ylAnSEq3Yh3tDpmrUr6qQEog0iRdIVsEJ2q4iJAYH_SCISMfsngB1bIbJ" />
                    </div>
                    <span class="text-[10px] font-bold text-primary dark:text-rose-400 uppercase tracking-[0.2em] mb-1.5 block font-headline">Era do Ouro Branco</span>
                    <h3 class="text-xl font-bold mb-2 font-headline group-hover:text-primary transition-colors">O Ciclo do Sal</h3>
                    <p class="text-sm text-on-surface-variant line-clamp-2 leading-relaxed">Descubra como o sal moldou as primeiras rotas comerciais e alianças estratégicas no território...</p>
                </div>
                <div class="mt-4 flex items-center gap-1 text-xs font-bold text-primary dark:text-rose-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    Ler artigo completo <span class="material-symbols-outlined text-sm">arrow_right_alt</span>
                </div>
            </a>

            <!-- Bento Card: Economic Data (Gamificação) -->
            <div class="bg-gradient-to-br from-primary to-primary-container text-white p-6 rounded-2xl flex flex-col justify-between shadow-sm border border-primary/20 relative overflow-hidden group">
                <!-- Subtle pattern overlay -->
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-white/5 rounded-full pointer-events-none group-hover:scale-110 transition-transform duration-500"></div>

                <div class="flex justify-between items-start mb-6 z-10">
                    <div>
                        <span class="text-xs text-white/70 block mb-1 font-semibold uppercase tracking-wider font-label">Os Seus Pontos</span>
                        <p class="text-4xl font-black font-headline tracking-tight text-accent-yellow">@pontos <span class="text-sm font-bold text-white/80">PTS</span></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center backdrop-blur-sm">
                        <span class="material-symbols-outlined text-accent-yellow" style="font-variation-settings: 'FILL' 1;">trending_up</span>
                    </div>
                </div>

                <div class="space-y-3 z-10">
                    <div class="flex justify-between items-center text-sm border-b border-white/10 pb-2.5">
                        <span class="text-white/80 font-light">Nível Atual</span>
                        <span class="font-bold bg-white/10 px-2.5 py-0.5 rounded-full text-xs">Nível @nivel</span>
                    </div>
                    <div class="flex justify-between items-center text-sm border-b border-white/10 pb-2.5">
                        <span class="text-white/80 font-light">Streak de Acesso</span>
                        <span class="font-bold flex items-center gap-1 bg-amber-500/20 text-accent-yellow px-2 py-0.5 rounded-full text-xs">
                            @streak dias
                            <span class="material-symbols-outlined text-xs animate-bounce" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
                        </span>
                    </div>
                </div>

                <a href="@Url.Action("MeuProgresso", "Gamificacao" )" class="mt-6 w-full py-3 bg-white text-primary rounded-xl font-bold text-xs hover:bg-accent-yellow hover:text-on-accent-yellow transition-all duration-200 uppercase tracking-widest text-center no-underline inline-block shadow-sm">
                    Ver Meu Progresso
                </a>
            </div>
        </div>
    </section>

    <!-- Right Column: Highlights & Progress -->
    <aside class="col-span-12 lg:col-span-4 space-y-6 lg:space-y-8">

        <!-- Highlights Section -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl border-l-4 border-accent-yellow border border-stone-200/40 shadow-sm">
            <div class="flex items-center gap-2 mb-6">
                <span class="material-symbols-outlined text-accent-yellow" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
                <h3 class="text-xs font-bold uppercase tracking-widest text-on-surface font-headline">Destaques do Mês</h3>
            </div>
            <div class="space-y-5">
                <div class="flex gap-4 group cursor-pointer">
                    <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-stone-100 dark:bg-stone-800 border border-stone-200/50 flex flex-col items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                        <span class="text-base font-extrabold leading-none">15</span>
                        <span class="text-[9px] uppercase font-bold tracking-tighter opacity-80">Jan</span>
                    </div>
                    <div class="flex-1">
                        <p class="text-[10px] text-primary dark:text-rose-400 font-bold uppercase tracking-tighter mb-0.5">Exposição Virtual</p>
                        <h4 class="text-sm font-bold leading-snug group-hover:text-primary transition-colors line-clamp-2">O Kwanza através das gerações</h4>
                    </div>
                </div>

                <div class="flex gap-4 group cursor-pointer">
                    <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-stone-100 dark:bg-stone-800 border border-stone-200/50 flex flex-col items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                        <span class="text-base font-extrabold leading-none">22</span>
                        <span class="text-[9px] uppercase font-bold tracking-tighter opacity-80">Jan</span>
                    </div>
                    <div class="flex-1">
                        <p class="text-[10px] text-primary dark:text-rose-400 font-bold uppercase tracking-tighter mb-0.5">Webinar Directo</p>
                        <h4 class="text-sm font-bold leading-snug group-hover:text-primary transition-colors line-clamp-2">Economia Azul e o potencial costeiro</h4>
                    </div>
                </div>
            </div>
            <button class="mt-8 w-full py-2.5 border border-stone-200 hover:border-primary/30 rounded-xl text-stone-600 hover:text-primary font-bold text-xs flex items-center justify-center gap-2 group transition-all">
                Ver Calendário Completo
                <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">chevron_right</span>
            </button>
        </div>

        <!-- Fast Progress Section -->
        <div class="bg-surface-container-low p-6 rounded-2xl border border-stone-200/30">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-xs font-bold uppercase tracking-widest text-on-surface font-headline">Progresso Rápido</h3>
                <span class="text-[11px] font-bold text-primary bg-primary-fixed px-2.5 py-1 rounded-lg">Nível @nivel</span>
            </div>

            <div class="space-y-4">
                <div class="space-y-2">
                    <div class="flex justify-between text-xs font-bold">
                        <span class="text-on-surface-variant font-medium">Progresso do Nível Atual</span>
                        <span class="text-primary">@percentagemNivel.ToString("0")%</span>
                    </div>
                    <div class="h-2 w-full bg-surface-container-highest rounded-full overflow-hidden p-[1px]">
                        <div class="h-full bg-primary rounded-full transition-all duration-500 ease-out" style="width: @percentagemNivel.ToString("0")%"></div>
                    </div>
                </div>
            </div>

            <!-- Badge Area -->
            <div class="mt-6 pt-5 border-t border-stone-200/50">
                @if (ultimoBadge != null)
                {
                <p class="text-[10px] uppercase font-black text-stone-400 mb-3 tracking-wider font-headline">Último Distintivo Ganho</p>
                <div class="flex items-center gap-3 bg-white/60 dark:bg-stone-900/40 p-3 rounded-xl border border-stone-200/30">
                    <div class="w-10 h-10 rounded-full bg-accent-yellow/20 flex items-center justify-center text-accent-yellow font-bold flex-shrink-0 shadow-sm">
                        <span class="material-symbols-outlined">@(string.IsNullOrEmpty(ultimoBadge.Icone) ? "military_tech" : ultimoBadge.Icone)</span>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-bold truncate">@ultimoBadge.Nome</p>
                        <p class="text-[10px] text-stone-500 truncate">@ultimoBadge.Descricao</p>
                    </div>
                </div>
                }
                else
                {
                <p class="text-[10px] uppercase font-black text-stone-400 mb-3 tracking-wider font-headline">Próxima Conquista</p>
                <div class="flex items-center gap-3 bg-white/60 dark:bg-stone-900/40 p-3 rounded-xl border border-stone-200/30">
                    <div class="w-10 h-10 rounded-full bg-accent-yellow/10 flex items-center justify-center text-accent-yellow flex-shrink-0">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">military_tech</span>
                    </div>
                    <div>
                        <p class="text-xs font-bold">Iniciante Histórico</p>
                        <p class="text-[10px] text-stone-500">Conclua o primeiro módulo para obter a sua insígnia!</p>
                    </div>
                </div>
                }
            </div>
        </div>

        <!-- Mini CTA Card -->
        <a href="@Url.Action("Contribuir", "Conteudos" )" class="block relative h-40 rounded-2xl overflow-hidden group cursor-pointer shadow-sm hover:shadow-md transition-shadow duration-300">
            <img class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="CTA Card" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBRLfCkcBCrk2Ev8eLuvGcDbmK_uVjybsVcPai55a5Cd5pU5tOYQ8R0469WRdLMweMnNjOrDVyz0M5uKM2hb_IG9R-U7rWB5I7jy82BncunXvnQNvJsTNq-MgtD163Upu_-6CQQKdhO39rrHK9a66pee91v3lLvZGp6QzjaTPsyCLDcyXtYnj-EmEjNwsB61wK40BkGnBinSRxVzy81JWyOwTi6_obIEy5gVmJWOsn6Fwxq-r9iCuvkB8MLDDS2QxwwfoFpRQNKpAA9" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/50 to-black/20 p-6 flex flex-col justify-end">
                <p class="text-white font-bold leading-tight font-headline text-lg group-hover:text-accent-yellow transition-colors">Contribuir para o Arquivo Público</p>
                <p class="text-white/80 text-[10px] uppercase tracking-widest mt-1 font-semibold">Envie documentos ou fotos raras</p>
            </div>
        </a>
    </aside>
</div>
}
else
{
    ViewData["Title"] = "Economia com História — Angola";

<!-- Landing Page (Anonymous) -->
<div class="relative w-full overflow-hidden animate-fade-in">

    <!-- Subtle Map Watermark Background -->
    <div class="absolute inset-0 z-0 opacity-[0.04] dark:opacity-[0.02] pointer-events-none mix-blend-multiply flex justify-center items-center overflow-hidden">
        <img alt="Topografia de Angola" class="w-full h-full object-cover select-none scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCB1IqoMXdmHK4OA39uptmjQJKCqSkqVz7fkurNcw9URxGo-x-PJ825fOg6nhVi38Z494y0TxiQZOHcSlYuoxZ5BX97_P0Aksnu9WgyA4j0_JusoLOGRgQlr9zx05SYsRL2ciLKJUzGMw-QU8pcHrNShfjBrTand-0niWewx742ICI7m0vb29d1GS9Xa83msccbegv9CAz6nw1u30J3fEcK4r76V6yizjQMIrrrLPVLjBp3PM2CLvHpUM00PDvpPAZ4QypeVQ8-FmAK" />
    </div>

    <!-- Hero Section -->
    <section class="relative z-10 max-w-screen-xl mx-auto px-6 lg:px-8 pt-16 pb-24 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <div class="lg:w-1/2 pr-0 lg:pr-8 text-center lg:text-left">
            <h1 class="font-headline font-bold text-4xl sm:text-5xl lg:text-6xl text-on-surface leading-tight mb-6">
                Descubra o Valor<br />
                <span class="text-primary bg-gradient-to-r from-primary to-rose-700 bg-clip-text text-transparent">da Nossa História</span>
            </h1>
            <p class="font-body text-base sm:text-lg text-on-surface-variant mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                Economia com História — Angola é a sua plataforma definitiva para entender o desenvolvimento económico através dos tempos. Uma jornada educativa, interativa e totalmente colaborativa.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                <a href="@Url.Action("Login", "Auth" )" class="px-8 py-4 rounded-xl font-label font-bold text-base shadow-md hover:shadow-lg hover:scale-[1.02] transition-all flex items-center justify-center gap-2 no-underline text-center text-on-accent-yellow bg-accent-yellow hover:bg-yellow-500">
                    Começar Agora
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
                <a href="@Url.Action("Index", "Conteudos" )" class="px-8 py-4 rounded-xl font-label font-bold text-base text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 border border-stone-200 dark:border-stone-700 transition-colors bg-white/50 backdrop-blur-sm no-underline text-center">
                    Saber Mais
                </a>
            </div>
        </div>

        <div class="lg:w-1/2 w-full">
            <!-- Asymmetric Bento-style Hero Grid -->
            <div class="grid grid-cols-2 gap-4 auto-rows-[160px] sm:auto-rows-[200px]">
                <div class="col-span-2 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow bg-surface-container-lowest border border-stone-200/30">
                    <img alt="Luanda Skyline" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBjGlTd5TANbSqHOW_ukwgI2bkpeFYmiO8hX6eKa2U_nSmZq5HAehK-XirODNq-qHakJd92KIYqItBydCr8fH8YqkOMT8i-DxIr8pA1nvoHgK4gAipTFs2PRQkHLZywJeJEnktfc90CRU9peCmXzOl7Koea2tkNV_Ks1euk2imauRcJ4dpPGoV3KxCjVH-p_0RhvIKdjj_0GcjAuiuI1h_3GCJbLE3d8yyHE9wCBMQtzjnF84NpDr774lEd3216hdxI-sX_fTquk4BD" />
                </div>
                <div class="rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow bg-surface-container-lowest border border-stone-200/30">
                    <img alt="Dados Economicos" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBwsSENOO1Ffl2VeHMcuhkl7sjn9TnSxsSNmVIkflpGJenrY8nbIGguWvLVQWSIuuyWRFtIbrowco-0LVFEuQiusbpNPPTdcB-G-IAhL84srlNAOLn04OSMZQg4uJC6c4cGlYhCrSsndYcmV6nC4-oqmKGnhc07h-1BDWsln0wJuyvV2w6Wo_r4o1rRtZNSQfkaTN13OgOqlicQNm1Sa6KP1GDsKfsOULtbq57mwH0RoHYkZzv-6Uwi7nJ6KBrgGj3ZADhL5-iPITZM" />
                </div>
                <div class="rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow bg-gradient-to-br from-surface-container-low to-surface flex flex-col justify-center p-6 border border-stone-200/30">
                    <span class="material-symbols-outlined text-primary text-4xl mb-2" style="font-variation-settings: 'FILL' 1;">account_balance</span>
                    <h3 class="font-headline font-bold text-lg text-on-surface">500 Anos</h3>
                    <p class="font-label text-xs text-on-surface-variant font-medium">de dados históricos e análises compiladas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Pillars Section (Bento Grid) -->
    <section class="relative z-10 max-w-screen-xl mx-auto px-6 lg:px-8 py-20 bg-surface-container-low rounded-t-[2.5rem] border-t border-stone-200/40">
        <div class="text-center mb-16 max-w-2xl mx-auto">
            <h2 class="font-headline font-bold text-3xl lg:text-4xl text-on-surface mb-3">Três Pilares do Conhecimento</h2>
            <p class="font-body text-base text-on-surface-variant">Uma abordagem dinâmica e engajante para dominar a história económica nacional.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Pillar 1: Explorar -->
            <div class="bg-surface-container-lowest rounded-2xl p-8 shadow-sm hover:shadow-md transform hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group border border-stone-200/20">
                <div class="absolute -top-4 -right-4 p-4 opacity-[0.03] group-hover:opacity-[0.07] group-hover:scale-110 transition-all duration-500">
                    <span class="material-symbols-outlined text-9xl text-primary">travel_explore</span>
                </div>
                <div class="w-12 h-12 bg-stone-100 dark:bg-stone-800 rounded-xl flex items-center justify-center mb-6 border border-stone-200/50">
                    <span class="material-symbols-outlined text-primary">menu_book</span>
                </div>
                <h3 class="font-headline font-bold text-xl text-on-surface mb-3">Educação e Foco</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                    Módulos interativos estruturados de forma cronológica. Do comércio pré-colonial e rotas do sal aos modernos mercados de exportação. Fontes rigorosas e verificadas.
                </p>
            </div>

            <!-- Pillar 2: Jogar -->
            <div class="bg-surface-container-lowest rounded-2xl p-8 shadow-sm hover:shadow-md transform hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group border border-stone-200/20">
                <div class="absolute -top-4 -right-4 p-4 opacity-[0.03] group-hover:opacity-[0.07] group-hover:scale-110 transition-all duration-500">
                    <span class="material-symbols-outlined text-9xl text-primary">sports_esports</span>
                </div>
                <div class="w-12 h-12 bg-primary-fixed rounded-xl flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-primary">emoji_events</span>
                </div>
                <h3 class="font-headline font-bold text-xl text-on-surface mb-3">Gamificação Ativa</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                    Teste as suas capacidades históricas. Resolva questionários interativos, simule decisões de política económica antiga e acumule pontos para atingir o topo do ranking.
                </p>
            </div>

            <!-- Pillar 3: Participar -->
            <div class="bg-surface-container-lowest rounded-2xl p-8 shadow-sm hover:shadow-md transform hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group border border-stone-200/20">
                <div class="absolute -top-4 -right-4 p-4 opacity-[0.03] group-hover:opacity-[0.07] group-hover:scale-110 transition-all duration-500">
                    <span class="material-symbols-outlined text-9xl text-primary">forum</span>
                </div>
                <div class="w-12 h-12 bg-tertiary-fixed rounded-xl flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-on-tertiary-fixed">groups</span>
                </div>
                <h3 class="font-headline font-bold text-xl text-on-surface mb-3">Colaboração Pública</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                    Colabore com a nossa comunidade académica. Discuta tópicos e dinâmicas regionais nos fóruns integrados e submeta registos e arquivos históricos adicionais.
                </p>
            </div>
        </div>
    </section>
</div>
}