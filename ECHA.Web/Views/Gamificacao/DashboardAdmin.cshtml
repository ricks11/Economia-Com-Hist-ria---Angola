@model IEnumerable<EconomiaComHistoria.Core.DTOs.BadgeAdminDto>
@{
    ViewData["Title"] = "Dashboard de Gamificação";
    var metricas = ViewData["Metricas"] as System.Text.Json.JsonElement?;
}

<main class="pt-12 pb-12 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <aside class="md:col-span-3 bg-surface-container-lowest rounded-3xl p-6 h-fit sticky top-24">
            <nav class="space-y-2">
                <a asp-controller="Home" asp-action="PainelEditor" class="flex items-center gap-3 px-4 py-3 rounded-xl text-stone-600 hover:bg-surface-container-high transition decoration-none">
                    <span class="material-symbols-outlined">dashboard</span> Painel
                </a>
                <a asp-controller="Gamificacao" asp-action="DashboardAdmin" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/5 text-primary font-bold decoration-none">
                    <span class="material-symbols-outlined">military_tech</span> Gamificação
                </a>
                <a asp-controller="Escolas" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-stone-600 hover:bg-surface-container-high transition decoration-none">
                    <span class="material-symbols-outlined">school</span> Escolas
                </a>
                <a asp-controller="Turmas" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-stone-600 hover:bg-surface-container-high transition decoration-none">
                    <span class="material-symbols-outlined">group</span> Turmas
                </a>
                <a asp-controller="Relatorios" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-stone-600 hover:bg-surface-container-high transition decoration-none">
                    <span class="material-symbols-outlined">bar_chart</span> Relatórios
                </a>
            </nav>
        </aside>

        <div class="md:col-span-9 space-y-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="bg-surface-container-lowest rounded-2xl p-6">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary/60 text-4xl">local_fire_department</span>
                        <div>
                            <p class="text-secondary text-sm">Média de Streak</p>
                            <p class="text-3xl font-headline font-bold text-primary">
                                @if (metricas.HasValue && metricas.Value.TryGetProperty("mediaStreak", out var mediaStreak))
                                {
                                    @mediaStreak.GetDouble().ToString("F1")
                                }
                                else
                                {
                                    @:0.0
                                }
                            </p>
                            <p class="text-xs text-stone-500">dias consecutivos</p>
                        </div>
                    </div>
                </div>
                <div class="bg-surface-container-lowest rounded-2xl p-6">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary/60 text-4xl">emoji_events</span>
                        <div>
                            <p class="text-secondary text-sm">Total de Badges</p>
                            <p class="text-3xl font-headline font-bold text-primary">@Model.Count()</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-6">
                <h2 class="text-xl font-headline font-bold text-primary mb-6">Badges Disponíveis</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var badge in Model)
                    {
                        <div class="border border-stone-200 rounded-2xl p-4">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary">emoji_events</span>
                                </div>
                                <div class="flex-1">
                                    <h3 class="font-bold text-primary">@badge.Nome</h3>
                                    <p class="text-sm text-secondary mb-2">@badge.Descricao</p>
                                    <div class="flex items-center gap-2 text-xs text-stone-500">
                                        <span>Critério: @badge.CriterioTipo</span>
                                        <span>•</span>
                                        <span>Valor: @badge.CriterioValor</span>
                                        <span>•</span>
                                        <span>Conquistados: @badge.TotalConquistados</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>
