@model IEnumerable<EconomiaComHistoria.Core.DTOs.DenunciaSummaryDto>
    @{
    ViewData["Title"] = "Denúncias Recebidas";
    }

    <div class="container mx-auto px-4 py-6">
        <h1 class="text-3xl font-bold text-gray-800 mb-6">Denúncias Ativas</h1>

        @if (!Model.Any())
        {
        <div class="bg-green-50 border border-green-200 p-6 rounded-lg text-green-700">
            <p class="font-medium">Excelente! Não existem denúncias pendentes de tratamento no sistema.</p>
        </div>
        }
        else
        {
        <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tipo</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Conteúdo/Alvo</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Autor</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Denúncias</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Última Alerta</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    @foreach (var item in Model)
                    {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2.5 py-1 text-xs font-semibold rounded-full @(item.Tipo == " Topico" ? "bg-amber-100 text-amber-800" : "bg-purple-100 text-purple-800" )">
                                @item.Tipo
                            </span>
                        </td>

                        <td class="px-6 py-4 max-w-xs truncate font-medium text-gray-900">
                            @item.TituloOuConteudo
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            @item.AutorNome
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-bold text-red-600 bg-red-50">
                            @item.TotalDenuncias
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                            <div class="flex items-center justify-end gap-3">
                                <form asp-action="@(item.Tipo == " Topico" ? "AprovarTopico" : "AprovarResposta" )" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="text-green-600 hover:text-green-900 font-semibold">Manter Conteúdo</button>
                                </form>

                                <button onclick="abrirModalRejeicao('@item.Id', '@item.Tipo')" class="text-red-600 hover:text-red-900 font-semibold">
                                    Remover Conteúdo
                                </button>
                            </div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    </div>

    <div id="modalRejeicao" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Remover Conteúdo Denunciado</h3>
            <form id="formRejeicao" method="post">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Motivo da remoção do conteúdo:</label>
                    <textarea id="motivo" name="motivo" required rows="4" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-red-500 focus:border-transparent" placeholder="Indique a regra infringida pelo utilizador..."></textarea>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" onclick="fecharModalRejeicao()" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded font-medium text-sm transition">Cancelar</button>
                    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded font-medium text-sm transition">Aplicar Penalização</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function abrirModalRejeicao(id, tipo) {
            const form = document.getElementById('formRejeicao');
            form.action = `/Moderacao/Rejeitar${tipo}/${id}`;
            document.getElementById('modalRejeicao').classList.remove('hidden');
        }
        function fecharModalRejeicao() {
            document.getElementById('modalRejeicao').classList.add('hidden');
            document.getElementById('motivo').value = '';
        }
    </script>
