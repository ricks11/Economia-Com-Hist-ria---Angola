@model IEnumerable<EconomiaComHistoria.Core.DTOs.DenunciaSummaryDto>
@{
    ViewData["Title"] = "Conteúdos Denunciados";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-warning mb-4">
    Esta lista está ordenada pelo número de denúncias (prioridade).
</div>

<div class="table-responsive">
    <table class="table table-hover border">
        <thead class="bg-light">
            <tr>
                <th>Tipo</th>
                <th>Título/Conteúdo</th>
                <th>Autor</th>
                <th class="text-center">Denúncias</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.TotalDenuncias > 5 ? "table-danger" : "")">
                    <td><span class="badge @(item.Tipo == "Topico" ? "badge-primary" : "badge-secondary")">@item.Tipo</span></td>
                    <td>@item.TituloOuConteudo</td>
                    <td>@item.AutorNome</td>
                    <td class="text-center"><strong>@item.TotalDenuncias</strong></td>
                    <td>
                        @if (item.Tipo == "Topico")
                        {
                            <button type="button" class="btn btn-sm btn-danger" onclick="rejeitarTopico(@item.Id)">Rejeitar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Reutilizar Modal de Rejeição se necessário ou criar um específico -->
<div class="modal fade" id="rejeitarModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <form id="rejeitarForm" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rejeitar Conteúdo Denunciado</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Motivo da Rejeição</label>
                        <textarea name="motivo" class="form-control" required rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Confirmar Rejeição</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function rejeitarTopico(id) {
            document.getElementById('rejeitarForm').action = '/Moderacao/RejeitarTopico/' + id;
            $('#rejeitarModal').modal('show');
        }
    </script>
}
