@model EconomiaComHistoria.Core.DTOs.ModeracaoPendentesResponse
@{
    ViewData["Title"] = "Fila de Moderação";
}

<div class="container mx-auto px-4 py-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Fila de Aprovação</h1>

    <section class="mb-10">
        <h2 class="text-xl font-semibold text-gray-700 mb-4 border-b pb-2">Tópicos a Aguardar Revisão (@Model.Topicos.Count)</h2>
        @if (!Model.Topicos.Any())
        {
        <p class="text-gray-500 bg-gray-50 p-4 rounded-lg">Não existem tópicos pendentes de aprovação.</p>
        }
        else
        {
        <div class="grid gap-4">
            @foreach (var topico in Model.Topicos)
            {
            <div class="bg-white p-5 rounded-lg shadow border border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center">
                <div class="flex-1">
                    <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded mb-2 font-medium">@topico.CategoriaNome</span>
                    <h3 class="text-lg font-bold text-gray-900">@topico.TituloOuConteudo</h3>
                    <p class="text-sm text-gray-500">Autor: @topico.AutorNome | Criado em: @topico.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="flex gap-2 mt-4 md:mt-0">
                    <form asp-action="AprovarTopico" asp-route-id="@topico.Id" method="post">
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm font-medium transition">Aprovar</button>
                    </form>
                    <button onclick="abrirModalRejeicao('@topico.Id', 'Topico')" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded text-sm font-medium transition">Rejeitar</button>
                </div>
            </div>
            }
        </div>
        }
    </section>

    <section>
        <h2 class="text-xl font-semibold text-gray-700 mb-4 border-b pb-2">Respostas a Aguardar Revisão (@Model.Respostas.Count)</h2>
        @if (!Model.Respostas.Any())
        {
        <p class="text-gray-500 bg-gray-50 p-4 rounded-lg">Não existem respostas pendentes de aprovação.</p>
        }
        else
        {
        <div class="grid gap-4">
            @foreach (var resposta in Model.Respostas)
            {
            <div class="bg-white p-5 rounded-lg shadow border border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center">
                <div class="flex-1">
                    <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Em resposta ao Tópico #@resposta.TopicoId</h4>
                    <p class="text-gray-800 italic bg-gray-50 p-3 rounded mb-2 border-l-4 border-gray-300">"@resposta.TituloOuConteudo"</p>
                    <p class="text-sm text-gray-500">Autor: @resposta.AutorNome | Submetido em: @resposta.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="flex gap-2 mt-4 md:mt-0">
                    <form asp-action="AprovarResposta" asp-route-id="@resposta.Id" method="post">
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm font-medium transition">Aprovar</button>
                    </form>
                    <button onclick="abrirModalRejeicao('@resposta.Id', 'Resposta')" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded text-sm font-medium transition">Rejeitar</button>
                </div>
            </div>
            }
        </div>
        }
    </section>
</div>

<div id="modalRejeicao" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Motivo da Rejeição</h3>
        <form id="formRejeicao" method="post">
            <input type="hidden" id="rejeicaoId" name="id" />
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Por favor, indique a razão de rejeição:</label>
                <textarea id="motivo" name="motivo" required rows="4" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-red-500 focus:border-transparent" placeholder="Ex: Linguagem imprópria, fora do âmbito económico-histórico..."></textarea>
            </div>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="fecharModalRejeicao()" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded font-medium text-sm transition">Cancelar</button>
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded font-medium text-sm transition">Confirmar Rejeição</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalRejeicao(id, tipo) {
        document.getElementById('rejeicaoId').value = id;
        const form = document.getElementById('formRejeicao');
        form.action = `/Moderacao/Rejeitar${tipo}/${id}`;
        document.getElementById('modalRejeicao').classList.remove('hidden');
    }
    function fecharModalRejeicao() {
        document.getElementById('modalRejeicao').classList.add('hidden');
        document.getElementById('motivo').value = '';
    }
</script>