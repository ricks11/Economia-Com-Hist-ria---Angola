@model EconomiaComHistoria.Core.DTOs.ModeracaoPendentesResponse
@{
    ViewData["Title"] = "Fila de Moderação";
}

<div class="max-w-5xl mx-auto px-6 pt-12">
    <div class="mb-10">
        <h1 class="text-4xl font-headline font-extrabold text-primary tracking-tight">Moderação de Conteúdo</h1>
        <p class="text-on-surface-variant">Analise e aprove tópicos do fórum e respostas pendentes.</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="bg-surface-container-lowest rounded-2xl p-6 text-center shadow-sm">
            <span class="text-4xl font-headline font-bold text-primary">@Model.Topicos.Count</span>
            <p class="text-secondary text-sm font-medium mt-1">Tópicos pendentes</p>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-6 text-center shadow-sm">
            <span class="text-4xl font-headline font-bold text-primary">@Model.Respostas.Count</span>
            <p class="text-secondary text-sm font-medium mt-1">Respostas pendentes</p>
        </div>
    </div>

    <!-- Tópicos -->
    <div class="space-y-8">
        <div>
            <h2 class="text-2xl font-headline font-bold text-primary mb-6">Tópicos pendentes</h2>
            @if (!Model.Topicos.Any())
            {
                <p class="text-secondary italic">Nenhum tópico pendente.</p>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var item in Model.Topicos)
                    {
                        <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-stone-100">
                            <div class="flex justify-between items-start mb-2">
                                <span class="bg-secondary-container text-xs font-bold px-3 py-1 rounded-full text-on-secondary-container uppercase">@item.CategoriaNome</span>
                                <span class="text-xs text-stone-400">@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <h3 class="font-headline font-bold text-lg text-primary mb-2">@item.TituloOuConteudo</h3>
                            <p class="text-sm text-secondary mb-4">por @item.AutorNome</p>
                            <div class="flex gap-3">
                                <form asp-action="AprovarTopico" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="px-5 py-2 rounded-full bg-primary text-white text-sm font-bold hover:shadow-md transition-all">Aprovar</button>
                                </form>
                                <button type="button" class="px-5 py-2 rounded-full bg-error-container/20 text-error text-sm font-bold hover:bg-error-container/30 transition-all" onclick="rejeitarConteudo('@Url.Action("RejeitarTopico", "Moderacao")', @item.Id)">Rejeitar</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Respostas -->
        <div>
            <h2 class="text-2xl font-headline font-bold text-primary mb-6">Respostas pendentes</h2>
            @if (!Model.Respostas.Any())
            {
                <p class="text-secondary italic">Nenhuma resposta pendente.</p>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var item in Model.Respostas)
                    {
                        <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-stone-100">
                            <p class="text-on-surface mb-4">"@item.TituloOuConteudo"</p>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-secondary font-medium">por @item.AutorNome</span>
                                <div class="flex gap-3">
                                    <form asp-action="AprovarResposta" asp-route-id="@item.Id" method="post" class="inline">
                                        <button type="submit" class="px-5 py-2 rounded-full bg-primary text-white text-sm font-bold hover:shadow-md transition-all">Aprovar</button>
                                    </form>
                                    <button type="button" class="px-5 py-2 rounded-full bg-error-container/20 text-error text-sm font-bold hover:bg-error-container/30 transition-all" onclick="rejeitarConteudo('@Url.Action("RejeitarResposta", "Moderacao")', @item.Id)">Rejeitar</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para Rejeição -->
<div id="rejeitarModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden">
    <div class="bg-white p-8 rounded-3xl w-full max-w-md shadow-2xl">
        <h3 class="text-xl font-headline font-bold text-primary mb-6">Motivo da Rejeição</h3>
        <form id="rejeitarForm" method="post">
            <textarea name="motivo" class="w-full bg-surface-container-low border-none rounded-2xl p-4 mb-6 focus:ring-2 focus:ring-primary/20" required rows="3" placeholder="Insira o motivo..."></textarea>
            <div class="flex gap-3 justify-end">
                <button type="button" class="px-6 py-3 rounded-full bg-surface-container font-bold" onclick="fecharModal()">Cancelar</button>
                <button type="submit" class="px-6 py-3 rounded-full bg-error text-white font-bold">Confirmar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function rejeitarConteudo(actionUrl, id) {
            document.getElementById('rejeitarForm').action = actionUrl + '/' + id;
            document.getElementById('rejeitarModal').classList.remove('hidden');
        }
        function fecharModal() {
            document.getElementById('rejeitarModal').classList.add('hidden');
        }
    </script>
}
