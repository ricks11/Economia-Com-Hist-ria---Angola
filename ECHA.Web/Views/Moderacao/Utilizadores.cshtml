@model IEnumerable<EconomiaComHistoria.Core.DTOs.UtilizadorModeracaoDto>
    @{
    ViewData["Title"] = "Gestão de Utilizadores";
    }

    <main class="max-w-7xl mx-auto px-4 py-8">
        <!-- Cabeçalho Principal -->
        <div class="mb-10 pb-4 border-b border-stone-100 dark:border-stone-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl md:text-3xl font-headline font-extrabold text-stone-900 dark:text-stone-100">
                    Moderação de Utilizadores
                </h1>
                <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">
                    Gere permissões, aplica suspensões temporárias ou revoga banimentos da plataforma.
                </p>
            </div>
            <span class="self-start sm:self-center bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400 px-3 py-1 rounded-full text-xs font-bold font-mono shadow-sm">
                Total: @Model.Count()
            </span>
        </div>

        <!-- Content Card e Tabela -->
        <div class="bg-white dark:bg-stone-900 rounded-2xl border border-stone-200/70 dark:border-stone-800/80 ambient-shadow overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-stone-100 dark:divide-stone-800/60 table-fixed sm:table-auto">
                    <thead class="bg-stone-50/50 dark:bg-stone-850/40">
                        <tr class="text-stone-400 dark:text-stone-500 text-xs font-bold uppercase tracking-wider">
                            <th class="px-6 py-4 text-left w-1/4">Nome</th>
                            <th class="px-6 py-4 text-left w-1/4">Email</th>
                            <th class="px-6 py-4 text-left w-1/6">Grupo / Role</th>
                            <th class="px-6 py-4 text-left w-1/6">Estado</th>
                            <th class="px-6 py-4 text-right w-1/6">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 dark:divide-stone-800/40 text-stone-700 dark:text-stone-300">
                        @foreach (var user in Model)
                        {
                        <tr class="hover:bg-stone-50/40 dark:hover:bg-stone-850/30 transition-colors">
                            <!-- Nome -->
                            <td class="px-6 py-4 font-medium text-stone-900 dark:text-stone-100 truncate">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-stone-400 text-lg">account_circle</span>
                                    @user.Nome
                                </div>
                            </td>

                            <!-- Email -->
                            <td class="px-6 py-4 text-sm text-stone-500 dark:text-stone-400 truncate font-mono text-[13px]">
                                @user.Email
                            </td>

                            <!-- Grupo / Role -->
                            <td class="px-6 py-4 text-sm">
                                <span class="bg-stone-100 text-stone-800 dark:bg-stone-800 dark:text-stone-300 text-[11px] px-2.5 py-1 rounded-md font-bold uppercase tracking-wider">
                                    @(string.IsNullOrEmpty(user.Tipo) ? "Investigador" : user.Tipo)
                                </span>
                            </td>

                            <!-- Estado -->
                            <td class="px-6 py-4 text-sm">
                                @if (user.Suspenso)
                                {
                                <span class="bg-red-50 text-red-700 border border-red-200/40 dark:bg-red-950/20 dark:text-red-400 dark:border-red-900/30 text-xs px-2.5 py-1 rounded-full font-semibold inline-flex items-center gap-1"
                                      title="Suspenso até: @user.SuspensoAte">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                                    @(user.SuspensaoPermanente ? "Banido" : $"Suspenso ({user.SuspensoAte?.ToString("dd/MM/yyyy")})")
                                </span>
                                }
                                else
                                {
                                <span class="bg-green-50 text-green-700 border border-green-200/40 dark:bg-green-950/20 dark:text-green-400 dark:border-green-900/30 text-xs px-2.5 py-1 rounded-full font-semibold inline-flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                    Ativo
                                </span>
                                }
                            </td>

                            <!-- Ações -->
                            <td class="px-6 py-4 text-right text-sm font-medium">
                                @if (user.Suspenso)
                                {
                                <form asp-action="ReativarUtilizador" asp-route-id="@user.Id" method="post" class="inline">
                                    <button type="submit" class="inline-flex items-center gap-1 text-green-700 hover:text-green-800 dark:text-green-400 dark:hover:text-green-300 font-bold bg-green-50 hover:bg-green-100 dark:bg-green-950/20 px-3 py-1.5 rounded-xl transition-all text-xs border border-green-200/20 dark:border-green-900/20">
                                        <span class="material-symbols-outlined text-sm">lock_open</span> Reativar Conta
                                    </button>
                                </form>
                                }
                                else
                                {
                                <button onclick="abrirModalSuspensao('@user.Id', '@user.Nome')"
                                        class="inline-flex items-center gap-1 text-red-700 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 font-bold bg-red-50 hover:bg-red-100 dark:bg-red-950/20 px-4 py-1.5 rounded-xl transition-all text-xs border border-red-200/20 dark:border-red-900/20">
                                    <span class="material-symbols-outlined text-sm">gavel</span> Suspender
                                </button>
                                }
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal Nativo HTML5 para Sanções -->
    <dialog id="modalSuspensao" class="backdrop:bg-stone-900/60 p-0 rounded-2xl border-0 shadow-xl max-w-md w-full bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-200">
        <div class="p-6">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100 dark:border-stone-800">
                <h3 class="font-headline font-bold text-lg text-stone-900 dark:text-stone-100 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-red-600">block</span> Aplicar Sanção
                </h3>
                <button type="button" onclick="fecharModalSuspensao()" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <p class="text-xs text-stone-500 dark:text-stone-400 mb-6 leading-relaxed">
                Estás a restringir o acesso do utilizador: <span id="nomeUtilizadorTarget" class="font-bold text-stone-800 dark:text-stone-200"></span>. O utilizador será impedido de interagir na plataforma durante o período estipulado.
            </p>

            <form id="formSuspensao" method="post" class="space-y-4">
                <div>
                    <label for="dias" class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">
                        Tempo de Suspensão (em dias)
                    </label>
                    <input type="number" id="dias" name="dias" min="1"
                           class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl p-3 text-sm text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-red-500/20 focus:border-transparent outline-none transition-all"
                           placeholder="Ex: 7" />
                    <p class="text-[11px] text-stone-400 dark:text-stone-500 mt-2 italic">
                        * Deixa o campo vazio caso pretendas aplicar um banimento permanente.
                    </p>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="fecharModalSuspensao()" class="px-4 py-2 text-sm font-semibold rounded-xl text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" class="px-5 py-2 text-sm font-bold rounded-xl bg-red-600 hover:bg-red-700 text-white shadow-sm transition-colors">
                        Confirmar Sanção
                    </button>
                </div>
            </form>
        </div>
    </dialog>

    <script>
        function abrirModalSuspensao(id, nome) {
            const targetText = document.getElementById('nomeUtilizadorTarget');
            if (targetText) targetText.innerText = nome;

            const form = document.getElementById('formSuspensao');
            if (form) {
                form.action = `/Moderacao/SuspenderUtilizador/${id}`;
            }

            const dialog = document.getElementById('modalSuspensao');
            if (dialog) {
                dialog.showModal();
            }
        }

        function fecharModalSuspensao() {
            const dialog = document.getElementById('modalSuspensao');
            if (dialog) {
                dialog.close();
            }
            const diasInput = document.getElementById('dias');
            if (diasInput) {
                diasInput.value = '';
            }
        }
    </script>
