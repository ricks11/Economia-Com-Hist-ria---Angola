@model IEnumerable<EconomiaComHistoria.Core.DTOs.UtilizadorModeracaoDto>
    @{
    ViewData["Title"] = "Gestão de Utilizadores";
    }

    <main class="pt-12 pb-12 px-6 max-w-7xl mx-auto">
        <!-- Cabeçalho -->
        <div class="mb-8">
            <h1 class="text-3xl font-headline font-bold text-stone-900">Moderação de Utilizadores</h1>
            <p class="text-stone-500 text-sm mt-1">Gere permissões, aplica suspensões ou reativa contas da plataforma.</p>
        </div>

        <!-- Content Card e Tabela -->
        <div class="bg-surface-container-lowest rounded-3xl p-6 border border-stone-200/60 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-stone-100 table-fixed sm:table-auto">
                    <thead>
                        <tr class="text-stone-400 text-xs font-bold uppercase tracking-wider">
                            <th class="px-6 py-4 text-left w-1/4">Nome</th>
                            <th class="px-6 py-4 text-left w-1/4">Email</th>
                            <th class="px-6 py-4 text-left w-1/6">Grupo / Role</th>
                            <th class="px-6 py-4 text-left w-1/6">Estado</th>
                            <th class="px-6 py-4 text-right w-1/6">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 text-stone-700">
                        @foreach (var user in Model)
                        {
                        <tr class="hover:bg-stone-50/50 transition">
                            <!-- Nome -->
                            <td class="px-6 py-4 font-medium text-stone-900 truncate">
                                @user.Nome
                            </td>

                            <!-- Email -->
                            <td class="px-6 py-4 text-sm text-stone-500 truncate">
                                @user.Email
                            </td>

                            <!-- Grupo / Role -->
                            <td class="px-6 py-4 text-sm">
                                <span class="bg-stone-100 text-stone-800 text-xs px-2.5 py-1 rounded-md font-medium uppercase tracking-wider">
                                    @(string.IsNullOrEmpty(user.Tipo) ? "Investigador" : user.Tipo)
                                </span>
                            </td>

                            <!-- Estado -->
                            <td class="px-6 py-4 text-sm">
                                @if (user.Suspenso)
                                {
                                <span class="bg-red-50 text-red-700 border border-red-100 text-xs px-2.5 py-1 rounded-full font-medium inline-block" title="Suspenso até: @user.SuspensoAte">
                                    @(user.SuspensaoPermanente ? "Banido Permanente" : $"Suspenso até {user.SuspensoAte?.ToString("dd/MM/yyyy")}")
                                </span>
                                }
                                else
                                {
                                <span class="bg-green-50 text-green-700 border border-green-100 text-xs px-2.5 py-1 rounded-full font-medium inline-block">
                                    Ativo
                                </span>
                                }
                            </td>

                            <!-- Ações -->
                            <td class="px-6 py-4 text-right text-sm font-medium">
                                @if (user.Suspenso)
                                {
                                <form asp-action="ReativarUtilizador" asp-route-id="@user.Id" method="post" class="inline">
                                    <button type="submit" class="text-green-600 hover:text-green-700 font-bold bg-green-50 hover:bg-green-100 px-3 py-1.5 rounded-full transition">
                                        Reativar Conta
                                    </button>
                                </form>
                                }
                                else
                                {
                                <button onclick="abrirModalSuspensao('@user.Id', '@user.Nome')" class="text-red-600 hover:text-red-700 font-bold bg-red-50 hover:bg-red-100 px-4 py-1.5 rounded-full transition">
                                    Suspender
                                </button>
                                }
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal de Suspensão Modernizado -->
    <div id="modalSuspensao" class="hidden fixed inset-0 bg-stone-900/40 backdrop-blur-sm flex items-center justify-center z-50 transition-all">
        <div class="bg-white rounded-3xl shadow-xl p-6 max-w-md w-full mx-4 border border-stone-100">
            <h3 class="text-xl font-headline font-bold text-stone-900 mb-1">Aplicar Sanção</h3>
            <p class="text-sm text-stone-500 mb-6">Estás a aplicar restrições ao utilizador: <span id="nomeUtilizadorTarget" class="font-bold text-stone-800"></span></p>

            <form id="formSuspensao" method="post">
                <div class="mb-5">
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-400 mb-2">Tempo de Suspensão (em dias):</label>
                    <input type="number" id="dias" name="dias" min="1" class="w-full border border-stone-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-red-500/20 focus:border-red-500 transition text-sm" placeholder="Ex: 7" />
                    <p class="text-xs text-stone-400 mt-2">Deixa em branco para aplicar um banimento permanente.</p>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="fecharModalSuspensao()" class="bg-stone-100 hover:bg-stone-200 text-stone-600 px-5 py-2.5 rounded-full font-bold text-sm transition">
                        Cancelar
                    </button>
                    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2.5 rounded-full font-bold text-sm transition shadow-sm shadow-red-600/10">
                        Confirmar Sanção
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function abrirModalSuspensao(id, nome) {
            document.getElementById('nomeUtilizadorTarget').innerText = nome;
            const form = document.getElementById('formSuspensao');
            form.action = `/Moderacao/SuspenderUtilizador/${id}`;
            document.getElementById('modalSuspensao').classList.remove('hidden');
        }

        function fecharModalSuspensao() {
            document.getElementById('modalSuspensao').classList.add('hidden');
            document.getElementById('dias').value = '';
        }
    </script>
