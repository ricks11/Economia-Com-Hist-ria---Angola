@model EconomiaComHistoria.Core.DTOs.ConteudoResponseDto
@{
    ViewData["Title"] = "Editar Conteúdo";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
        @TempData["SuccessMessage"]
    </div>
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Titulo" class="control-label">Título</label>
                <input asp-for="Titulo" class="form-control" required />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Resumo" class="control-label">Resumo</label>
                <textarea asp-for="Resumo" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Resumo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CorpoTexto" class="control-label">Texto</label>
                <textarea asp-for="CorpoTexto" class="form-control" id="TextoEditor"></textarea>
                <span asp-validation-for="CorpoTexto" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Tema" class="control-label">Tema</label>
                        <input asp-for="Tema" class="form-control" required />
                        <span asp-validation-for="Tema" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Nivel" class="control-label">Nível</label>
                        <select asp-for="Nivel" class="form-control" required>
                            <option value="">Selecione...</option>
                            <option value="Primário" selected="@(Model.Nivel == "Primário")">Primário</option>
                            <option value="Secundário" selected="@(Model.Nivel == "Secundário")">Secundário</option>
                            <option value="Superior" selected="@(Model.Nivel == "Superior")">Superior</option>
                            <option value="Geral" selected="@(Model.Nivel == "Geral")">Geral</option>
                        </select>
                        <span asp-validation-for="Nivel" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Regiao" class="control-label">Região</label>
                        <input asp-for="Regiao" class="form-control" required />
                        <span asp-validation-for="Regiao" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Tipo" class="control-label">Tipo</label>
                        <select asp-for="Tipo" class="form-control" required>
                            <option value="">Selecione...</option>
                            <option value="Artigo" selected="@(Model.Tipo == "Artigo")">Artigo</option>
                            <option value="Video" selected="@(Model.Tipo == "Video")">Vídeo</option>
                            <option value="Audio" selected="@(Model.Tipo == "Audio")">Áudio</option>
                            <option value="Documento" selected="@(Model.Tipo == "Documento")">Documento</option>
                        </select>
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group mb-3">
                        <label asp-for="Estado" class="control-label">Estado</label>
                        <select asp-for="Estado" class="form-control" required>
                            <option value="">Selecione...</option>
                            <option value="Rascunho" selected="@(Model.Estado == EstadoConteudo.Rascunho)">Rascunho</option>
                            <option value="EmRevisao" selected="@(Model.Estado == EstadoConteudo.EmRevisao)">Em Revisão</option>
                            <option value="Publicado" selected="@(Model.Estado == EstadoConteudo.Publicado)">Publicado</option>
                            <option value="Arquivado" selected="@(Model.Estado == EstadoConteudo.Arquivado)">Arquivado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="DataAgendada" class="control-label">Data de Agendamento</label>
                        <input asp-for="DataAgendada" type="date" class="form-control" />
                        <span asp-validation-for="DataAgendada" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <!-- Empty for alignment -->
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VideoUrl" class="control-label">URL de Vídeo (Embed)</label>
                <input asp-for="VideoUrl" class="form-control" placeholder="https://youtube.com/embed/..." />
                <span asp-validation-for="VideoUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AudioUrl" class="control-label">URL de Áudio (Embed)</label>
                <input asp-for="AudioUrl" class="form-control" placeholder="https://soundcloud.com/..." />
                <span asp-validation-for="AudioUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label name="imagemCapa" class="control-label">Imagem de Capa (deixe vazio para manter a atual)</label>
                @if (!string.IsNullOrEmpty(Model.ImagemCapa)) {
                    <div class="mb-2">
                        <img src="@Model.ImagemCapa" alt="Capa Atual" style="max-width: 200px;" />
                    </div>
                }
                <input type="file" name="imagemCapa" class="form-control" accept="image/*" />
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Alterações" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#TextoEditor',
            plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
            height: 400
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
