@model EconomiaComHistoria.Core.DTOs.CreateConteudoDto
@{
    ViewData["Title"] = "Criar Conteúdo";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 text-green-800 rounded-r-xl shadow-sm flex items-center gap-3">
        <span class="material-symbols-outlined text-green-600">check_circle</span>
        <span class="font-medium">@TempData["SuccessMessage"]</span>
    </div>
    }

    <!-- Header -->
    <header class="mb-8">
        <h1 class="text-3xl font-black text-primary tracking-tight">@ViewData["Title"]</h1>
        <p class="text-sm text-stone-500 mt-1">Preencha os campos abaixo para publicar um novo conteúdo na plataforma.</p>
    </header>

    <!-- Main Card Form -->
    <div class="bg-surface-container-lowest rounded-3xl p-6 md:p-8 shadow-sm border border-stone-100">
        <form asp-action="Create" enctype="multipart/form-data" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-medium"></div>

            <!-- Título -->
            <div class="flex flex-col gap-1.5">
                <label asp-for="Titulo" class="text-sm font-semibold text-secondary">Título do Conteúdo</label>
                <input asp-for="Titulo" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none placeholder:text-stone-400" placeholder="Ex: A rota das especiarias e o impacto global" required />
                <span asp-validation-for="Titulo" class="text-red-500 text-xs"></span>
            </div>

            <!-- Resumo -->
            <div class="flex flex-col gap-1.5">
                <label asp-for="Resumo" class="text-sm font-semibold text-secondary">Resumo</label>
                <textarea asp-for="Resumo" rows="2" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none placeholder:text-stone-400" placeholder="Uma breve introdução para capturar a atenção nas listagens..."></textarea>
                <span asp-validation-for="Resumo" class="text-red-500 text-xs"></span>
            </div>

            <!-- Texto Completo (Editor) -->
            <div class="flex flex-col gap-1.5">
                <label asp-for="CorpoTexto" class="text-sm font-semibold text-secondary">Corpo do Texto</label>
                <div class="rounded-xl overflow-hidden border border-stone-200">
                    <textarea asp-for="CorpoTexto" id="TextoEditor"></textarea>
                </div>
                <span asp-validation-for="CorpoTexto" class="text-red-500 text-xs"></span>
            </div>

            <!-- Grid: Tema e Nível -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Tema" class="text-sm font-semibold text-secondary">Tema / Categoria</label>
                    <input asp-for="Tema" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none" placeholder="Ex: Macroeconomia" required />
                    <span asp-validation-for="Tema" class="text-red-500 text-xs"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Nivel" class="text-sm font-semibold text-secondary">Nível Académico</label>
                    <select asp-for="Nivel" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none appearance-none" asp-items="Html.GetEnumSelectList<EconomiaComHistoria.Core.Enums.NivelDificuldade>()" required>
                        <option value="">Selecione o nível...</option>
                    </select>
                    <span asp-validation-for="Nivel" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <!-- Grid: Região e Tipo -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Regiao" class="text-sm font-semibold text-secondary">Região Geográfica</label>
                    <input asp-for="Regiao" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none" placeholder="Ex: Angola, Global, Europa" required />
                    <span asp-validation-for="Regiao" class="text-red-500 text-xs"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Tipo" class="text-sm font-semibold text-secondary">Tipo de Formato</label>
                    <select asp-for="Tipo" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none" asp-items="Html.GetEnumSelectList<EconomiaComHistoria.Core.Enums.TipoConteudo>()" required>
                        <option value="">Selecione o formato...</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <!-- Jindungo Toggle Switch & Factual Reference -->
            <div class="p-4 bg-stone-50 rounded-2xl border border-stone-200/60 space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex flex-col">
                        <label for="IsJindungo" class="text-sm font-semibold text-secondary flex items-center gap-1">
                            <span class="material-symbols-outlined text-orange-500 text-[18px]">local_fire_department</span>
                            Conteúdo com Jindungo?
                        </label>
                        <span class="text-xs text-stone-500">Ative se este artigo contiver análises picantes ou debates intensos.</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="IsJindungo" name="IsJindungo" value="true" class="sr-only peer">
                        <div class="w-11 h-6 bg-stone-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-stone-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <!-- Campo Condicional Animado via JS -->
                <div id="ReferenciaFactualGroup" style="display: none;" class="flex flex-col gap-1.5 pt-2 border-t border-stone-200/40">
                    <label for="ReferenciaFactual" class="text-sm font-semibold text-secondary">Referência Factual / Fonte Histórica</label>
                    <input type="text" id="ReferenciaFactual" name="ReferenciaFactual" class="w-full px-4 py-2.5 bg-white border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none text-sm" placeholder="Ex: Arquivo Nacional de Angola, Códice 412" />
                </div>
            </div>

            <!-- Grid: Estado e Agendamento -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Estado" class="text-sm font-semibold text-secondary">Estado de Publicação</label>
                    <select asp-for="Estado" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none" asp-items="Html.GetEnumSelectList<EconomiaComHistoria.Core.Enums.EstadoConteudo>()" required>
                        <option value="">Selecione o estado...</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-red-500 text-xs"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="DataAgendada" class="text-sm font-semibold text-secondary">Data de Agendamento <span class="text-xs font-normal text-stone-400">(Opcional)</span></label>
                    <input asp-for="DataAgendada" type="date" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none" />
                    <span asp-validation-for="DataAgendada" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <!-- Média Integrada -->
            <div class="flex flex-col gap-1.5">
                <label asp-for="VideoUrl" class="text-sm font-semibold text-secondary">URL de Media <span class="text-xs font-normal text-stone-400">(Embed de Vídeo ou Áudio)</span></label>
                <input asp-for="VideoUrl" class="w-full px-4 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface outline-none placeholder:text-stone-400" placeholder="https://youtube.com/embed/..." />
                <span asp-validation-for="VideoUrl" class="text-red-500 text-xs"></span>
            </div>

            <!-- Upload de Capa -->
            <div class="flex flex-col gap-1.5">
                <label name="imagemCapa" class="text-sm font-semibold text-secondary">Imagem de Capa</label>
                <div class="flex items-center justify-center w-full">
                    <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-stone-200 border-dashed rounded-xl cursor-pointer bg-stone-50 hover:bg-stone-100/50 transition-colors">
                        <div class="flex flex-col items-center justify-center pt-5 pb-6">
                            <span class="material-symbols-outlined text-stone-400 text-3xl mb-1">cloud_upload</span>
                            <p class="text-xs text-stone-500 font-medium">Clique para carregar ou arraste a imagem</p>
                            <p class="text-[10px] text-stone-400 mt-0.5">PNG, JPG ou WEBP</p>
                        </div>
                        <input type="file" name="imagemCapa" class="hidden" accept="image/*" />
                    </label>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-stone-100 text-secondary font-semibold text-sm hover:bg-stone-200 transition-colors decoration-none">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-white font-semibold text-sm shadow-md shadow-primary/10 hover:opacity-95 transition-all">
                    Criar Conteúdo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '#TextoEditor',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
        height: 400,
        branding: false, // Remove o logo do TinyMCE
        promotion: false // Remove o botão de upgrade/aviso de licença
    });
</script>
<script>
    // Lógica condicional melhorada para o painel de Jindungo
    document.getElementById('IsJindungo').addEventListener('change', function () {
        const group = document.getElementById('ReferenciaFactualGroup');
        const input = document.getElementById('ReferenciaFactual');
        if (this.checked) {
            group.style.display = 'flex';
            input.setAttribute('required', 'required');
        } else {
            group.style.display = 'none';
            input.removeAttribute('required');
            input.value = '';
        }
    });
</script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
