@model EconomiaComHistoria.Core.DTOs.ConteudoResponseDto
@{
    ViewData["Title"] = Model.Titulo;
    var solicitacaoStatus = ViewData["SolicitacaoStatus"] as string ?? "Nenhuma";
    var temAcesso = !Model.IsJindungo || !string.IsNullOrEmpty(Model.CorpoTexto);

    // Lê o estado real passado pelo Controller
    var isFavorito = ViewData["IsFavorito"] as bool? ?? false;
}

<main class="max-w-4xl mx-auto px-4 sm:px-6 py-8">

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 text-green-800 rounded-r-xl shadow-sm flex items-center gap-3">
        <span class="material-symbols-outlined text-green-600">check_circle</span>
        <span class="font-medium">@TempData["SuccessMessage"]</span>
    </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-800 rounded-r-xl shadow-sm flex items-center gap-3">
        <span class="material-symbols-outlined text-red-600">error</span>
        <span class="font-medium">@TempData["ErrorMessage"]</span>
    </div>
    }

    <header class="mb-12">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <div class="flex flex-wrap items-center gap-2">
                <span class="px-3 py-1 bg-tertiary/10 text-tertiary text-xs font-bold rounded-full uppercase tracking-wider">@Model.Tema</span>
                <span class="px-3 py-1 bg-stone-100 text-secondary text-xs font-semibold rounded-full">@Model.Nivel</span>
                <span class="px-3 py-1 bg-stone-100 text-secondary text-xs font-semibold rounded-full flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">public</span> @Model.Regiao
                </span>
                @if (Model.IsJindungo)
                {
                <span class="px-3 py-1 bg-orange-50 text-orange-700 text-xs font-bold rounded-full uppercase flex items-center gap-1 border border-orange-200">
                    <span class="material-symbols-outlined text-sm">local_fire_department</span> Jindungo
                </span>
                }
            </div>

            <!-- Botão de Favorito Rápido -->
            @if (User.Identity?.IsAuthenticated == true)
            {
            <form asp-action="ToggleFavorito" asp-route-id="@Model.Id" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border transition-all shadow-sm text-xs font-bold @(isFavorito ? " bg-amber-50 border-amber-300 text-amber-700" : "bg-white border-stone-200 text-stone-600 hover:bg-stone-50" )">

                    <!-- Força o preenchimento do ícone usando as variações nativas do Google Material Symbols -->
                    <span class="material-symbols-outlined text-[18px] @(isFavorito ? " text-amber-500" : "text-stone-400" )"
                          style="@(isFavorito ? " font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;" : "font-variation-settings: 'FILL' 0;" )">
                        star
                    </span>

                    @(isFavorito ? "Guardado" : "Guardar")
                </button>
            </form>
            }
        </div>

        <h1 class="font-headline font-black text-3xl md:text-5xl text-primary leading-tight mb-8">@Model.Titulo</h1>

        <div class="flex items-center justify-between gap-4 p-5 bg-surface-container-low rounded-2xl border border-stone-100">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-surface-container rounded-full flex items-center justify-center border border-stone-200/50">
                    <span class="material-symbols-outlined text-stone-500">person</span>
                </div>
                <div>
                    <p class="font-bold text-primary text-sm sm:text-base">@(Model.EditorNome ?? "Editor Editorial")</p>
                    <p class="text-xs text-secondary">
                        @(Model.DataPublicacao?.ToString("dd \\de MMMM \\de yyyy") ?? "Rascunho")
                        @if(Model.Estado.ToString() != "Publicado") { <span class="ml-1 px-1.5 py-0.5 bg-amber-100 text-amber-800 font-bold rounded text-[10px]">@Model.Estado</span> }
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1 text-xs font-semibold text-stone-500 bg-stone-100 px-3 py-1.5 rounded-xl">
                <span class="material-symbols-outlined text-[18px]">visibility</span>
                <span>@Model.Visualizacoes <span class="hidden sm:inline">visitas</span></span>
            </div>
        </div>
    </header>

    @if (Model.IsJindungo)
    {
    <div class="mb-12 p-5 bg-orange-50/40 border-l-4 border-orange-500 rounded-r-2xl">
        <div class="flex items-start gap-3.5">
            <span class="material-symbols-outlined text-orange-600 text-2xl">campaign</span>
            <div>
                <h4 class="font-bold text-orange-950 text-sm sm:text-base font-headline">Conteúdo Crítico e de Opinião</h4>
                <p class="text-xs sm:text-sm text-orange-900/80 mt-0.5 leading-relaxed">Este texto expressa análises profundas e perspetivas interpretativas sobre a história e narrativa económica angolana.</p>
            </div>
        </div>
    </div>
    }

    @if (!temAcesso)
    {
    <section class="bg-surface-container-lowest rounded-3xl p-8 sm:p-12 border border-stone-100 text-center mb-12 shadow-sm">
        <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-3xl text-stone-600">lock</span>
        </div>
        <h2 class="text-2xl font-headline font-black text-primary mb-2">Acesso Restrito</h2>
        <p class="text-sm text-stone-500 mb-6 max-w-md mx-auto leading-relaxed">Este debate com Jindungo requer uma credencial ou aprovação da equipa editorial antes de poder ler o ensaio na íntegra.</p>

        @if (!string.IsNullOrEmpty(Model.Resumo))
        {
        <div class="bg-stone-50 p-4 rounded-xl max-w-xl mx-auto mb-8 border border-stone-200/40">
            <p class="text-sm text-stone-600 italic font-medium">"@Model.Resumo"</p>
        </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
        @if (solicitacaoStatus == "Pendente")
        {
        <div class="inline-flex items-center gap-2 bg-amber-50 text-amber-800 border border-amber-200 px-6 py-3 rounded-xl font-bold text-sm">
            <span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span>
            Pedido enviado. Aguarda validação dos Editores.
        </div>
        }
        else if (solicitacaoStatus == "Aprovado")
        {
        <div class="p-4 bg-green-50 text-green-800 font-bold text-sm rounded-xl inline-flex items-center gap-2 border border-green-200">
            <span class="material-symbols-outlined">verified</span> Acesso autorizado! Por favor, atualize o seu navegador.
        </div>
        }
        else
        {
        <form asp-action="SolicitarAcesso" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="bg-primary text-white px-8 py-3.5 rounded-xl font-bold text-sm hover:opacity-95 shadow-md shadow-primary/10 transition-all">
                Solicitar Acesso ao Ensaio Completo
            </button>
        </form>
        }
        }
        else
        {
        <a asp-controller="Auth" asp-action="Login" class="inline-block bg-primary text-white px-8 py-3.5 rounded-xl font-bold text-sm no-underline hover:opacity-95 shadow-md shadow-primary/10 transition-all">
            Iniciar Sessão para Solicitar Acesso
        </a>
        }
    </section>
    }
    else
    {
    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
    {
    <figure class="mb-10 group overflow-hidden rounded-3xl border border-stone-100 shadow-sm">
        <img src="@Model.ThumbnailUrl" class="w-full h-[240px] sm:h-[420px] object-cover transition-transform duration-500 group-hover:scale-[1.01]" alt="@Model.Titulo">
    </figure>
    }

    @if (!string.IsNullOrEmpty(Model.Resumo))
    {
    <p class="text-lg sm:text-xl text-stone-600 leading-relaxed mb-8 font-medium border-l-2 border-stone-300 pl-4 sm:pl-6">@Model.Resumo</p>
    }

    <article class="prose prose-stone prose-base sm:prose-lg max-w-none text-stone-800 leading-relaxed space-y-6 mb-12 font-serif">
        @if (!string.IsNullOrEmpty(Model.CorpoTexto))
        {
        @Html.Raw(Model.CorpoTexto)
        }
    </article>

    @if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
    <div class="mb-12 aspect-video rounded-3xl overflow-hidden shadow-sm border border-stone-200/60">
        <iframe src="@Model.VideoUrl" class="w-full h-full border-0" allowfullscreen></iframe>
    </div>
    }

    @if (!string.IsNullOrEmpty(Model.ReferenciaFactual))
    {
    <aside class="bg-stone-50 border border-stone-200/60 rounded-2xl p-5 mb-12">
        <div class="flex items-center gap-2 text-stone-500 font-bold uppercase tracking-wider text-xs mb-2">
            <span class="material-symbols-outlined text-[16px]">menu_book</span>
            <span>Fundamentação de Fontes</span>
        </div>
        <p class="text-sm text-stone-700 leading-relaxed font-mono">@Model.ReferenciaFactual</p>
    </aside>
    }
    }

    <!-- Barra Inferior de Ações Dinâmicas -->
    <footer class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-stone-100">
        <a asp-action="Index" class="flex items-center gap-2 text-stone-600 font-semibold text-sm hover:text-primary no-underline transition-colors py-2">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Voltar ao arquivo principal
        </a>

        @if (User.IsInRole("Editor") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Professor"))
        {
        <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
            <button type="button" id="abrirDeleteModalBtn" class="w-full sm:w-auto px-5 py-2.5 rounded-xl border border-red-200 bg-red-50 text-red-700 font-bold text-xs hover:bg-red-100 transition-colors">
                Eliminar Artigo
            </button>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-primary text-white font-bold text-xs text-center no-underline hover:opacity-95 shadow-md shadow-primary/5 transition-all">
                Editar Dados
            </a>
        </div>
        }
    </footer>
</main>

<!-- Modal UI para Confirmação de Remoção (Delete) -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-stone-900/40 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-surface-container-lowest rounded-3xl p-6 max-w-md w-full border border-stone-100 scale-95 transition-transform duration-300 ambient-shadow">
        <div class="flex items-start gap-4">
            <div class="p-3 bg-red-100 text-red-700 rounded-2xl flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">delete_forever</span>
            </div>
            <div class="flex-1">
                <h3 class="text-lg font-bold font-headline text-stone-900 mb-1">Arquivar Conteúdo?</h3>
                <p class="text-sm text-stone-500 leading-relaxed">Tens a certeza de que desejas remover o artigo <span class="font-semibold text-stone-800">"@Model.Titulo"</span> do arquivo público?</p>
                <p class="text-xs text-stone-400 mt-2">Esta operação pode ser revertida apenas através do painel direto de auditoria da base de dados.</p>
            </div>
        </div>

        <div class="flex justify-end gap-2 mt-6 pt-4 border-t border-stone-100">
            <button type="button" id="cancelarDeleteBtn" class="px-4 py-2.5 bg-stone-100 text-stone-600 font-semibold text-xs rounded-xl hover:bg-stone-200 transition-all">
                Manter Artigo
            </button>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-2.5 bg-red-600 text-white font-bold text-xs rounded-xl hover:bg-red-700 shadow-md shadow-red-600/10 transition-all">
                    Sim, Confirmar Remoção
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<!-- ✅ Script que corrige o ícone de favorito ao carregar a página-->
<script>
    (function () {
        const conteudoId = @Model.Id;
        // Procura o formulário do botão de favorito
        const form = document.querySelector(`form[action$="ToggleFavorito"][action*="${conteudoId}"]`);
        if (!form) return;

        const button = form.querySelector('button');
        const icon = button?.querySelector('.material-symbols-outlined');
        const textSpan = button?.childNodes[button.childNodes.length - 1]; // último texto do botão

        function aplicarEstado(favorito) {
            if (favorito) {
                // Amarelo preenchido
                button.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-700');
                button.classList.remove('bg-white', 'border-stone-200', 'text-stone-600', 'hover:bg-stone-50');
                icon.style.fontVariationSettings = "'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24";
                icon.classList.add('text-amber-500');
                icon.classList.remove('text-stone-400');
                if (textSpan) textSpan.textContent = ' Guardado';
            } else {
                // Cinza vazio
                button.classList.add('bg-white', 'border-stone-200', 'text-stone-600', 'hover:bg-stone-50');
                button.classList.remove('bg-amber-50', 'border-amber-300', 'text-amber-700');
                icon.style.fontVariationSettings = "'FILL' 0";
                icon.classList.add('text-stone-400');
                icon.classList.remove('text-amber-500');
                if (textSpan) textSpan.textContent = ' Guardar';
            }
        }

        // Chama a API com as credenciais do browser
        fetch(`/api/conteudos/${conteudoId}`, { credentials: 'include' })
            .then(res => res.json())
            .then(data => {
                aplicarEstado(data.ehFavorito === true);
            })
            .catch(err => console.log('Falha ao verificar favorito:', err));
    })();
</script>
<script>
    const deleteModal = document.getElementById('deleteModal');
    const abrirBtn = document.getElementById('abrirDeleteModalBtn');
    const cancelarBtn = document.getElementById('cancelarDeleteBtn');

    if (abrirBtn) {
        abrirBtn.addEventListener('click', () => {
            deleteModal.classList.remove('hidden');
            deleteModal.classList.add('flex');
        });
    }

    if (cancelarBtn) {
        cancelarBtn.addEventListener('click', () => {
            deleteModal.classList.remove('flex');
            deleteModal.classList.add('hidden');
        });
    }

    deleteModal.addEventListener('click', (e) => {
        if (e.target === deleteModal) {
            deleteModal.classList.remove('flex');
            deleteModal.classList.add('hidden');
        }
    });
</script>
}