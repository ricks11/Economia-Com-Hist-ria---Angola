@model EconomiaComHistoria.Core.DTOs.ConteudoResponseDto
@{
    ViewData["Title"] = Model.Titulo;
}

<main class="pt-12 pb-20 px-6 max-w-4xl mx-auto">
    <!-- Article Header -->
    <header class="mb-12">
        <div class="flex items-center gap-3 mb-6">
            <span class="px-3 py-1 bg-tertiary/10 text-tertiary text-xs font-bold rounded-full uppercase">@Model.Tema</span>
            <span class="text-secondary text-sm">@Model.Nivel</span>
        </div>
        <h1 class="font-headline font-extrabold text-4xl md:text-6xl text-primary leading-tight mb-8">@Model.Titulo</h1>
        
        <div class="flex items-center gap-4 p-6 bg-stone-50 rounded-2xl border border-stone-100">
            <div class="w-12 h-12 bg-stone-200 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-stone-500">person</span>
            </div>
            <div>
                <p class="font-bold text-primary">@Model.AutorNome</p>
                <p class="text-xs text-secondary">Publicado em @Model.DataPublicacao.ToString("dd/MM/yyyy") • @Model.Visualizacoes visualizações</p>
            </div>
        </div>
    </header>

    @if (Model.IsJindungo)
    {
        <div class="mb-12 p-6 bg-tertiary-container/10 border-l-4 border-tertiary-container rounded-r-2xl">
            <div class="flex items-start gap-4">
                <span class="material-symbols-outlined text-tertiary text-2xl">warning</span>
                <div>
                    <h4 class="font-bold text-tertiary">Conteúdo de Opinião (Jindungo)</h4>
                    <p class="text-sm text-secondary">As opiniões expressas neste artigo são de cariz crítico.</p>
                </div>
            </div>
        </div>
    }

    <!-- Featured Image -->
    @if (!string.IsNullOrEmpty(Model.ImagemCapa))
    {
        <figure class="mb-12">
            <img src="@Model.ImagemCapa" class="w-full h-[400px] object-cover rounded-[2.5rem] shadow-xl" alt="@Model.Titulo">
        </figure>
    }

    <!-- Article Content -->
    <article class="prose prose-stone prose-lg max-w-none text-stone-700 leading-relaxed space-y-8">
        <div class="content-text">
            @Html.Raw(Model.Texto)
        </div>
    </article>

    <!-- Navigation Footer -->
    <footer class="mt-20 pt-12 border-t border-stone-100 flex justify-between gap-6">
        <a asp-action="Index" class="flex items-center gap-2 text-primary font-bold hover:underline">
            <span class="material-symbols-outlined">arrow_back</span> Voltar à lista
        </a>
        @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
        {
            <div class="flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-6 py-3 rounded-full bg-primary text-white font-bold hover:shadow-lg transition-all">Editar</a>
            </div>
        }
    </footer>
</main>

