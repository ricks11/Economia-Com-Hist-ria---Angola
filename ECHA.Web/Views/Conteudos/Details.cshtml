@model ECHA.Core.DTOs.ConteudoResponseDto
@{
    ViewData["Title"] = Model.Titulo;
}

<article class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            @if (!string.IsNullOrEmpty(Model.ImagemCapa))
            {
                <img src="@Model.ImagemCapa" class="img-fluid rounded mb-4 w-100" alt="@Model.Titulo" style="max-height: 500px; object-fit: cover;">
            }

            <header class="mb-4">
                <h1 class="fw-bold mb-3">@Model.Titulo</h1>
                <div class="d-flex align-items-center text-muted mb-3">
                    <span class="me-3"><i class="bi bi-person"></i> @Model.AutorNome</span>
                    <span class="me-3"><i class="bi bi-calendar"></i> @Model.DataPublicacao.ToString("dd/MM/yyyy")</span>
                    <span><i class="bi bi-eye"></i> @Model.Visualizacoes visualizações</span>
                </div>
                <div class="mb-3">
                    <span class="badge bg-secondary">@Model.Tema</span>
                    <span class="badge bg-info text-dark">@Model.Nivel</span>
                    <span class="badge bg-dark">@Model.Regiao</span>
                    <span class="badge bg-primary">@Model.Tipo</span>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(Model.UrlMedia))
            {
                <div class="ratio ratio-16x9 mb-4">
                    <iframe src="@Model.UrlMedia" title="Media content" allowfullscreen></iframe>
                </div>
            }

            <div class="content-text lead mb-5">
                @Html.Raw(Model.Texto)
            </div>

            @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
            {
                <div class="border-top pt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                    <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
                </div>
            }
            else
            {
                <div class="border-top pt-4">
                    <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
                </div>
            }
        </div>
    </div>
</article>
