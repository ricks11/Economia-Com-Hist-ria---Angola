@model IEnumerable<ECHA.Core.DTOs.ConteudoResponseDto>
@{
    ViewData["Title"] = "Explorar Conteúdos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">Novo Conteúdo</a>
    }
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.ImagemCapa))
                {
                    <img src="@item.ImagemCapa" class="card-img-top" alt="@item.Titulo" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span>Sem Imagem</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Titulo</h5>
                    <p class="card-text text-muted">@item.Resumo</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">@item.Tema | @item.Nivel</small>
                        <div>
                            @if (item.IsJindungo)
                            {
                                <span class="badge bg-warning text-dark me-1">Jindungo</span>
                            }
                            <span class="badge bg-primary">@item.Tipo</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Ler mais</a>
                    @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Tem a certeza?')">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
