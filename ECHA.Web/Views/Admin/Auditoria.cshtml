@model List<EconomiaComHistoria.Core.DTOs.AuditoriaLogDto>
    @{
    ViewData["Title"] = "Log de Auditoria";
    }

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
        <!-- Cabeçalho -->
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-headline font-extrabold text-primary tracking-tight">Log de Auditoria</h1>
            <p class="text-on-surface-variant mt-2">Registo completo e imutável de ações críticas na plataforma.</p>
        </header>

        <!-- Filtros -->
        <form method="get" class="flex flex-wrap items-end gap-3 mb-8 p-4 bg-surface-container-low rounded-2xl border border-stone-200 dark:border-stone-800/60">
            <div class="flex-1 min-w-[150px]">
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1.5">Utilizador ID</label>
                <input type="number" name="utilizadorId" value="@Context.Request.Query["utilizadorId"]" placeholder="ID do utilizador" class="w-full px-4 py-2.5 bg-surface-container-lowest border border-stone-200 dark:border-stone-800/60 rounded-xl focus:ring-2 focus:ring-primary/20 outline-none transition-all text-on-surface" />
            </div>
            <div class="flex-1 min-w-[150px]">
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1.5">Ação</label>
                <input type="text" name="acao" value="@Context.Request.Query["acao"]" placeholder="Ex: AlterarRole" class="w-full px-4 py-2.5 bg-surface-container-lowest border border-stone-200 dark:border-stone-800/60 rounded-xl focus:ring-2 focus:ring-primary/20 outline-none transition-all text-on-surface" />
            </div>
            <div class="flex-1 min-w-[150px]">
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1.5">Data Início</label>
                <input type="date" name="inicio" value="@Context.Request.Query["inicio"]" class="w-full px-4 py-2.5 bg-surface-container-lowest border border-stone-200 dark:border-stone-800/60 rounded-xl focus:ring-2 focus:ring-primary/20 outline-none transition-all text-on-surface" />
            </div>
            <div class="flex-1 min-w-[150px]">
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1.5">Data Fim</label>
                <input type="date" name="fim" value="@Context.Request.Query["fim"]" class="w-full px-4 py-2.5 bg-surface-container-lowest border border-stone-200 dark:border-stone-800/60 rounded-xl focus:ring-2 focus:ring-primary/20 outline-none transition-all text-on-surface" />
            </div>
            <div class="flex gap-2 flex-shrink-0">
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-bold text-sm shadow-sm hover:opacity-90 transition-all border-none">
                    <span class="material-symbols-outlined text-sm align-middle mr-1">filter_list</span>
                    Filtrar
                </button>
                <a asp-action="Auditoria" class="px-6 py-2.5 rounded-xl bg-surface-container text-on-surface font-bold text-sm hover:bg-surface-container-high transition-colors no-underline">
                    <span class="material-symbols-outlined text-sm align-middle mr-1">refresh</span>
                    Limpar
                </a>
            </div>
        </form>

        <!-- Tabela -->
        <div class="bg-surface-container-lowest rounded-3xl overflow-hidden shadow-sm border border-stone-200 dark:border-stone-800/60">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-surface-container-low border-b border-stone-200 dark:border-stone-800/60">
                        <tr>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Data/Hora</th>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Utilizador</th>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Ação</th>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Entidade</th>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Antes</th>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Depois</th>
                            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">IP</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 dark:divide-stone-800/40">
                        @if (!Model.Any())
                        {
                        <tr>
                            <td colspan="7" class="px-4 py-12 text-center text-stone-400 dark:text-stone-500">
                                <span class="material-symbols-outlined text-4xl block mb-2 opacity-50">search_off</span>
                                Nenhum registo de auditoria encontrado.
                            </td>
                        </tr>
                        }
                        @foreach (var log in Model)
                        {
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="px-4 py-3 whitespace-nowrap font-mono text-xs text-stone-600 dark:text-stone-400">@log.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 py-3 font-medium text-on-surface">@(log.UtilizadorNome ?? log.UtilizadorId?.ToString() ?? "—")</td>
                            <td class="px-4 py-3">
                                <span class="inline-block px-3 py-1 bg-primary/10 text-primary dark:bg-primary/20 dark:text-rose-300 rounded-full text-[11px] font-bold tracking-wide">@log.Acao</span>
                            </td>
                            <td class="px-4 py-3 text-on-surface-variant text-sm">
                                @log.EntidadeAfetada
                                @if (log.IdEntidade.HasValue)
                                {
                                <span class="text-stone-400 dark:text-stone-500 text-xs font-mono">#@log.IdEntidade</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-stone-500 dark:text-stone-400 text-xs font-mono max-w-[120px] truncate" title="@log.ValorAntes">
                                @(log.ValorAntes ?? "—")
                            </td>
                            <td class="px-4 py-3 text-stone-500 dark:text-stone-400 text-xs font-mono max-w-[120px] truncate" title="@log.ValorDepois">
                                @(log.ValorDepois ?? "—")
                            </td>
                            <td class="px-4 py-3 text-stone-400 dark:text-stone-500 text-xs font-mono">@log.Ip</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Contagem -->
        <div class="mt-4 text-xs text-stone-400 dark:text-stone-500 text-right">
            Total: @Model.Count registos
        </div>
    </div>
