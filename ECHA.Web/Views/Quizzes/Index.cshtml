@model IEnumerable<EconomiaComHistoria.Core.DTOs.QuizResponseDto>
    @{
    ViewData["Title"] = "Gestão de Quizzes";
    }

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

        @if (TempData["SuccessMessage"] != null)
        {
        <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 text-green-800 rounded-r-xl shadow-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-green-600">check_circle</span>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
        }

        <header class="mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-black text-primary tracking-tight">Gestão de Quizzes</h1>
                <p class="text-sm text-stone-500 mt-1">Administre os desafios interativos disponíveis para os investigadores.</p>
            </div>
            <div class="flex items-center gap-3 w-full sm:w-auto">
                <a asp-action="Pool" class="inline-flex items-center justify-center gap-2 w-1/2 sm:w-auto px-5 py-2.5 rounded-xl bg-surface-container text-secondary font-semibold hover:bg-surface-container-high transition-all shadow-sm decoration-none text-sm">
                    <span class="material-symbols-outlined text-[18px]">database</span>
                    Pool de Perguntas
                </a>
                <a asp-action="Create" class="inline-flex items-center justify-center gap-2 w-1/2 sm:w-auto px-5 py-2.5 rounded-xl bg-primary text-white font-semibold hover:opacity-95 transition-all shadow-md shadow-primary/10 decoration-none text-sm">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Novo Quiz
                </a>
            </div>
        </header>

        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
            <div class="bg-surface-container-lowest border border-stone-100 rounded-3xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <span class="px-2.5 py-1 bg-stone-100 text-stone-600 text-[10px] font-bold rounded-md uppercase tracking-wider">
                            @item.Tema
                        </span>

                        @if (item.Ativo)
                        {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-green-50 text-green-700 text-xs font-semibold rounded-full border border-green-200/60">
                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                            Ativo
                        </span>
                        }
                        else
                        {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-stone-50 text-stone-400 text-xs font-semibold rounded-full border border-stone-200">
                            <span class="w-1.5 h-1.5 bg-stone-300 rounded-full"></span>
                            Inativo
                        </span>
                        }
                    </div>

                    <h3 class="font-bold text-lg text-primary mb-5 group-hover:text-primary/90 transition-colors line-clamp-2 leading-snug">
                        @item.Titulo
                    </h3>

                    <div class="grid grid-cols-2 gap-y-3 gap-x-2 border-t border-stone-50 pt-4 mb-6 text-xs text-stone-600">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-stone-400 text-[18px]">layers</span>
                            <span>Nível: <strong class="text-primary font-semibold">@item.Nivel</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-stone-400 text-[18px]">quiz</span>
                            <span>Perguntas: <strong class="text-primary font-semibold">@item.TotalPerguntas</strong></span>
                        </div>
                        <div class="flex items-center gap-2 col-span-2">
                            <span class="material-symbols-outlined text-stone-400 text-[18px]">schedule</span>
                            <span>Tempo Limite: <strong class="text-primary font-semibold">@item.TempoLimiteSeg</strong></span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between border-t border-stone-50 pt-4 gap-2">
                    <div class="flex items-center gap-1.5">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="inline-flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-bold text-secondary bg-stone-50 hover:bg-stone-100 transition-colors decoration-none border border-stone-200/40">
                            <span class="material-symbols-outlined text-[16px]">edit</span>
                            Editar
                        </a>
                        <a asp-action="Stats" asp-route-id="@item.Id" class="inline-flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-bold text-primary bg-primary/5 hover:bg-primary/10 transition-colors decoration-none">
                            <span class="material-symbols-outlined text-[16px]">equalizer</span>
                            Estatísticas
                        </a>
                    </div>

                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tem a certeza que deseja eliminar este quiz?')" class="inline m-0">
                        <button type="submit" class="inline-flex items-center justify-center w-8 h-8 rounded-xl border border-stone-100 text-stone-400 hover:text-error hover:bg-error/5 hover:border-error/20 transition-all" title="Eliminar Quiz">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                    </form>
                </div>
            </div>
            }
        </section>
    </div>
