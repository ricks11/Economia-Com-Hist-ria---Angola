@model IEnumerable<EconomiaComHistoria.Core.DTOs.PerguntaDetalheDto>

    @{
    ViewData["Title"] = "Pool de Perguntas";
    }

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
        <header class="mb-10 flex items-center justify-between border-b border-stone-100 pb-6">
            <div>
                <h1 class="text-3xl font-black text-primary tracking-tight">Pool de Perguntas</h1>
                <p class="text-sm text-stone-500 mt-1">Banco global de questões disponíveis para a criação de novos desafios.</p>
            </div>
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 bg-stone-50 text-secondary border border-stone-200/60 rounded-xl text-sm font-semibold hover:bg-stone-100 transition-colors decoration-none">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Voltar aos Quizzes
            </a>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var p in Model)
            {
            <div class="bg-surface-container-lowest border border-stone-200/60 rounded-2xl p-5 shadow-sm">
                <div class="flex justify-between items-start gap-4 mb-3">
                    <h4 class="font-bold text-on-surface text-sm leading-snug">@p.Enunciado</h4>
                </div>

                <div class="space-y-2.5">
                    @foreach (var o in p.Opcoes)
                    {
                    <div class="p-3 rounded-xl text-xs border @(o.IsCorrecta ? " bg-green-50 /70 border-green-200 text-green-900 font-medium" : "bg-stone-50/50 border-stone-100 text-stone-600" )">
                        <div class="flex items-start justify-between gap-3">
                            <span>@o.Texto</span>
                            @if (o.IsCorrecta)
                            {
                            <span class="inline-flex items-center px-2 py-0.5 bg-green-500 text-white rounded-md text-[10px] font-bold uppercase shrink-0">Correta</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(o.Explicacao))
                        {
                        <div class="mt-2 pt-1.5 border-t border-stone-200/40 text-stone-400 text-[11px]">
                            <span class="font-bold">Explicação:</span> @o.Explicacao
                        </div>
                        }
                    </div>
                    }
                </div>
            </div>
            }
        </div>
    </div>
