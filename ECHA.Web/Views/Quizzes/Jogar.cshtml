@model EconomiaComHistoria.Core.DTOs.QuizStartResponseDto
@{
    var quiz = ViewData["Quiz"] as EconomiaComHistoria.Core.DTOs.QuizResponseDto;
    ViewData["Title"] = quiz?.Titulo ?? "Quiz Interactivo";
    var tempoLimite = quiz?.TempoLimiteSeg ?? 120;
}

<div class="max-w-3xl mx-auto" id="quiz-app">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-headline font-extrabold text-primary">@quiz?.Titulo</h1>
            <p class="text-on-surface-variant text-sm mt-1">@quiz?.Tema · @quiz?.TotalPerguntas perguntas</p>
        </div>
        <div class="flex items-center gap-2 bg-surface-container-high px-4 py-2 rounded-full">
            <span class="material-symbols-outlined text-primary">timer</span>
            <span id="timer" class="font-headline font-bold text-primary text-lg">@tempoLimite</span>
            <span class="text-xs text-stone-500">seg</span>
        </div>
    </div>

    <div class="mb-4">
        <div class="h-2 bg-surface-container rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-gradient-to-r from-primary to-primary-container transition-all duration-300" style="width: 0%"></div>
        </div>
        <p class="text-xs text-stone-500 mt-2 text-center"><span id="current-q">1</span> de @Model.Perguntas.Count</p>
    </div>

    <form asp-action="Submeter" method="post" id="quiz-form">
        <input type="hidden" name="TentativaId" value="@Model.TentativaId" />
        <div id="questions-container">
            @for (int i = 0; i < Model.Perguntas.Count; i++)
            {
                var pergunta = Model.Perguntas[i];
                <div class="question-panel @(i == 0 ? "" : "hidden") bg-surface-container-lowest rounded-3xl p-8 ambient-shadow" data-index="@i">
                    <p class="text-xs font-bold uppercase tracking-widest text-tertiary mb-3">Pergunta @(i + 1)</p>
                    <h2 class="text-xl font-headline font-bold text-primary mb-6">@pergunta.Enunciado</h2>
                    <div class="space-y-3">
                        @foreach (var opcao in pergunta.Opcoes)
                        {
                            <label class="flex items-center gap-4 p-4 bg-surface-container-low rounded-2xl cursor-pointer hover:bg-surface-container-high transition-colors has-[:checked]:bg-primary/10 has-[:checked]:ring-2 has-[:checked]:ring-primary/30">
                                <input type="radio" name="Respostas[@i].OpcaoRespostaId" value="@opcao.Id" required class="text-primary" data-pergunta-id="@pergunta.Id" />
                                <input type="hidden" name="Respostas[@i].PerguntaId" value="@pergunta.Id" />
                                <input type="hidden" name="Respostas[@i].TempoRespostaSeg" value="0" class="tempo-input" />
                                <span class="font-medium">@opcao.Texto</span>
                            </label>
                        }
                    </div>
                    <div class="flex justify-between mt-8">
                        @if (i > 0)
                        {
                            <button type="button" class="prev-btn px-6 py-3 rounded-full bg-surface-container text-secondary font-bold" data-index="@i">Anterior</button>
                        }
                        else
                        {
                            <div></div>
                        }
                        @if (i < Model.Perguntas.Count - 1)
                        {
                            <button type="button" class="next-btn px-6 py-3 rounded-full bg-primary text-white font-bold" data-index="@i">Seguinte</button>
                        }
                        else
                        {
                            <button type="submit" class="px-8 py-3 rounded-full bg-gradient-to-br from-primary to-primary-container text-white font-bold">Submeter Quiz</button>
                        }
                    </div>
                </div>
            }
        </div>
    </form>
</div>

@section Scripts {
<script>
(function() {
    const totalQuestions = @Model.Perguntas.Count;
    const timeLimit = @tempoLimite;
    let timeLeft = timeLimit;
    let currentIndex = 0;
    const questionStartTimes = Array(totalQuestions).fill(Date.now());

    const timerEl = document.getElementById('timer');
    const progressBar = document.getElementById('progress-bar');
    const currentQEl = document.getElementById('current-q');
    const panels = document.querySelectorAll('.question-panel');

    function updateProgress() {
        progressBar.style.width = ((currentIndex + 1) / totalQuestions * 100) + '%';
        currentQEl.textContent = currentIndex + 1;
    }

    function showPanel(index) {
        panels.forEach((p, i) => p.classList.toggle('hidden', i !== index));
        questionStartTimes[index] = Date.now();
        currentIndex = index;
        updateProgress();
    }

    document.querySelectorAll('.next-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const idx = parseInt(btn.dataset.index);
            const panel = panels[idx];
            const selected = panel.querySelector('input[type=radio]:checked');
            if (!selected) { alert('Seleccione uma resposta antes de continuar.'); return; }
            const tempoInput = panel.querySelector('.tempo-input');
            tempoInput.value = Math.round((Date.now() - questionStartTimes[idx]) / 1000);
            showPanel(idx + 1);
        });
    });

    document.querySelectorAll('.prev-btn').forEach(btn => {
        btn.addEventListener('click', () => showPanel(parseInt(btn.dataset.index) - 1));
    });

    const interval = setInterval(() => {
        timeLeft--;
        timerEl.textContent = timeLeft;
        if (timeLeft <= 0) {
            clearInterval(interval);
            document.getElementById('quiz-form').submit();
        }
    }, 1000);

    document.getElementById('quiz-form').addEventListener('submit', () => {
        const lastPanel = panels[totalQuestions - 1];
        const tempoInput = lastPanel.querySelector('.tempo-input');
        tempoInput.value = Math.round((Date.now() - questionStartTimes[totalQuestions - 1]) / 1000);
        clearInterval(interval);
    });

    updateProgress();
})();
</script>
}
