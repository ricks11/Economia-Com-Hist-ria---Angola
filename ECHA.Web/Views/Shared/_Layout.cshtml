<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Economia com História – Angola</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Public_Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "inverse-surface": "#2f3131",
                        "on-error": "#ffffff",
                        "on-surface-variant": "#554241",
                        "surface-variant": "#e2e2e2",
                        "on-tertiary-container": "#4f3e00",
                        "tertiary": "#735c00",
                        "secondary-fixed": "#e4e2e1",
                        "on-secondary": "#ffffff",
                        "secondary": "#5f5e5e",
                        "surface-container": "#eeeeee",
                        "on-background": "#1a1c1c",
                        "surface": "#f9f9f9",
                        "on-primary-container": "#f0847f",
                        "inverse-primary": "#ffb3ae",
                        "tertiary-fixed-dim": "#e9c349",
                        "on-surface": "#1a1c1c",
                        "background": "#f9f9f9",
                        "on-secondary-container": "#656464",
                        "inverse-on-surface": "#f1f1f1",
                        "secondary-container": "#e4e2e1",
                        "surface-tint": "#9b423f",
                        "primary-fixed": "#ffdad7",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed": "#1b1c1c",
                        "primary-container": "#6b1e1e",
                        "on-secondary-fixed-variant": "#474747",
                        "tertiary-container": "#cca830",
                        "surface-container-high": "#e8e8e8",
                        "surface-container-low": "#f3f3f3",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#410005",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary": "#ffffff",
                        "on-primary-fixed-variant": "#7d2b2a",
                        "primary": "#4d070b",
                        "surface-bright": "#f9f9f9",
                        "secondary-fixed-dim": "#c8c6c5",
                        "outline-variant": "#dbc0be",
                        "surface-dim": "#dadada",
                        "outline": "#887270",
                        "primary-fixed-dim": "#ffb3ae",
                        "tertiary-fixed": "#ffe088",
                        "on-tertiary-fixed-variant": "#574500",
                        "on-tertiary-fixed": "#241a00",
                        "surface-container-highest": "#e2e2e2",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline": ["Manrope"],
                        "body": ["Public Sans"],
                        "label": ["Public Sans"]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .soft-elevation {
            box-shadow: 0 8px 24px -4px rgba(26, 28, 28, 0.06);
        }
        .hero-gradient {
            background: linear-gradient(135deg, #6b1e1e 0%, #4d070b 100%);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface font-body text-on-surface antialiased flex flex-col min-h-screen">
    <!-- TopAppBar -->
    <nav class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md shadow-sm">
        <div class="flex justify-between items-center px-6 h-16 w-full max-w-7xl mx-auto">
            <a asp-controller="Home" asp-action="Index" class="text-xl font-black text-red-900 font-headline tracking-tight decoration-none">
                Economia com História – Angola
            </a>
            <div class="flex items-center gap-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-sm font-medium text-secondary hidden md:block">@User.Identity.Name</span>
                    <a asp-controller="Perfil" asp-action="Index" class="material-symbols-outlined text-stone-600 p-2 hover:bg-stone-100 transition-colors rounded-full">account_circle</a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="material-symbols-outlined text-stone-600 p-2 hover:bg-stone-100 transition-colors rounded-full">logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="text-primary font-bold hover:underline">Entrar</a>
                }
            </div>
        </div>
    </nav>

    <main class="flex-grow pt-24 pb-12 w-full">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="w-full py-12 px-6 flex flex-col items-center gap-6 mt-auto bg-stone-50 font-['Public_Sans'] text-sm tracking-wide">
        <div class="font-['Manrope'] font-bold text-red-900 text-lg">Economia com História</div>
        <div class="flex gap-8 text-stone-500">
            <a class="hover:text-red-800 underline transition-all opacity-80 hover:opacity-100" asp-controller="Home" asp-action="Privacy">Termos</a>
            <a class="hover:text-red-800 underline transition-all opacity-80 hover:opacity-100" asp-controller="Home" asp-action="Privacy">Privacidade</a>
            <a class="hover:text-red-800 underline transition-all opacity-80 hover:opacity-100" href="#">Contacto</a>
            <a class="hover:text-red-800 underline transition-all opacity-80 hover:opacity-100" href="#">Sobre o Projecto</a>
        </div>
        <p class="text-stone-500 opacity-80">© 2026 Economia com História – Angola. Preservando a narrativa económica.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
