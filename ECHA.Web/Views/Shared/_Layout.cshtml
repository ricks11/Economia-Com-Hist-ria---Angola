@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // Obter o nome completo (tenta a claim "FullName", depois ClaimTypes.Name, fallback para email)
    var fullName = User.FindFirst("Nome")?.Value
                    ?? User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                    ?? User.Identity?.Name
                    ?? "U";

    // Calcular iniciais para o avatar (usa o fullName)
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string initials = parts.Length > 1
        ? $"{parts.First()[0]}{parts.Last()[0]}".ToUpper()
        : fullName.Substring(0, Math.Min(2, fullName.Length)).ToUpper();

    // Função para extrair primeiro e último nome
    string GetDisplayName(string name) {
        if (string.IsNullOrWhiteSpace(name)) return "Utilizador";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "Utilizador";
        if (parts.Length == 1) return parts[0];
        return $"{parts.First()} {parts.Last()}";
    }

    // Função para as classes de navegação ativa
    string GetNavClass(string controller, string action = null) {
        bool isActive = currentController == controller && (action == null || currentAction == action);
        return isActive
            ? "bg-stone-150/70 dark:bg-stone-800/80 text-rose-950 dark:text-yellow-400 font-bold border-r-4 border-yellow-500 shadow-sm"
            : "text-stone-600 dark:text-stone-400 hover:text-rose-900 dark:hover:text-stone-200 hover:bg-stone-100/50 dark:hover:bg-stone-800/40";
    }

    // Flags de permissão
    bool isEditor = User.IsInRole("Editor");
    bool isAdmin = User.IsInRole("Admin");
    bool isModerador = User.IsInRole("Moderador");
    bool isSuperAdmin = User.IsInRole("SuperAdmin");

    bool podeGerirQuizzes = isEditor || isAdmin || isSuperAdmin;
    bool podeGerirTurmas = isEditor || isAdmin || isSuperAdmin;
    bool podeGerirEscolas = isAdmin || isSuperAdmin;
    bool podeModerar = isEditor || isAdmin || isModerador || isSuperAdmin;
    bool podeVerRelatorios = isEditor || isAdmin || isSuperAdmin;
    bool ehSuperAdmin = isSuperAdmin;

    bool mostraSeparadorAdmin = podeGerirQuizzes || podeGerirTurmas || podeGerirEscolas || podeModerar || podeVerRelatorios || ehSuperAdmin;
}

