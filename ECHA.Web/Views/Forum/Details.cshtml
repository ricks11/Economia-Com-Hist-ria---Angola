@using EconomiaComHistoria.Core.Enums
@model EconomiaComHistoria.Core.DTOs.TopicoForumDetalheDto
@{
    ViewData["Title"] = Model.Titulo;
    var isArquivadoOuRejeitado = Model.Estado == EstadoTopicoForum.Arquivado || Model.Estado == EstadoTopicoForum.Rejeitado;
    var isArquivado = Model.Estado == EstadoTopicoForum.Arquivado;
    var acaoArquivar = isArquivado ? "DesarquivarTopico" : "ApagarTopico";
    var textoBotao = isArquivado ? "Desarquivar Tópico" : "Arquivar Tópico";
    var corBotao = isArquivado ? "bg-green-50 hover:bg-green-100 text-green-700 dark:bg-green-950/20 dark:text-green-400" : "bg-red-50 hover:bg-red-100 text-red-700 dark:bg-red-950/20 dark:text-red-400";
    var iconeBotao = isArquivado ? "unarchive" : "archive";
    var tituloModal = isArquivado ? "Desarquivar Tópico" : "Arquivar Tópico";
    var mensagemModal = isArquivado
        ? "Tem a certeza de que deseja desarquivar este tópico? Ele voltará a aparecer na listagem pública ativa."
        : "Tem a certeza de que deseja arquivar este tópico académico? Esta ação irá remover a publicação da listagem pública ativa, mas manterá todos os dados salvaguardados para auditoria da moderação.";
    var textoConfirmacao = isArquivado ? "Confirmar Desarquivo" : "Confirmar Arquivo";
    var corConfirmacao = isArquivado ? "bg-green-600 hover:bg-green-700" : "bg-red-600 hover:bg-red-700";
}

<div class="max-w-4xl mx-auto px-4 py-4">
    <div class="flex items-center justify-between mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-primary dark:text-yellow-500 font-bold hover:underline no-underline">
            <span class="material-symbols-outlined">arrow_back</span> Voltar ao fórum
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("Editor") || User.IsInRole("SuperAdmin"))
        {
        <button type="button" onclick="openArquivarModal()"
                class="flex items-center gap-1 @corBotao px-4 py-2 rounded-xl text-xs font-bold transition-all">
            <span class="material-symbols-outlined text-sm">@iconeBotao</span> @textoBotao
        </button>
        }
    </div>

    <!-- Mensagens de Feedback -->
    @if (TempData["SuccessMessage"] != null)
    {
    <div class="mb-6 flex items-center gap-3 bg-green-50 dark:bg-green-950/20 text-green-800 dark:text-green-300 px-6 py-4 rounded-xl border border-green-200/50">
        <span class="material-symbols-outlined text-green-600">check_circle</span>
        <p class="font-medium text-sm">@TempData["SuccessMessage"]</p>
    </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="mb-6 flex items-center gap-3 bg-red-50 dark:bg-red-950/20 text-red-800 dark:text-red-300 px-6 py-4 rounded-xl border border-red-200/50">
        <span class="material-symbols-outlined text-red-600">error</span>
        <p class="font-medium text-sm">@TempData["ErrorMessage"]</p>
    </div>
    }

    <!-- Artigo do Tópico -->
    <article class="bg-white dark:bg-stone-900 rounded-3xl p-6 md:p-8 mb-8 border border-stone-200/70 dark:border-stone-800 ambient-shadow">
        <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class="bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 px-3 py-1 rounded-full text-xs font-semibold">@Model.CategoriaNome</span>
            @if (Model.Fixado)
            {
            <span class="bg-yellow-100 text-yellow-800 dark:bg-yellow-950/40 dark:text-yellow-400 px-3 py-1 rounded-full text-xs font-bold">Fixado</span>
            }
            @if (Model.Estado == EstadoTopicoForum.Pendente)
            {
            <span class="bg-yellow-100 text-yellow-800 dark:bg-yellow-950/40 dark:text-yellow-400 px-3 py-1 rounded-full text-xs font-bold">Em revisão</span>
            }
            @if (Model.Estado == EstadoTopicoForum.Arquivado)
            {
            <span class="bg-stone-400 text-white dark:bg-stone-700 px-3 py-1 rounded-full text-xs font-bold">Arquivado</span>
            }
            @if (Model.Estado == EstadoTopicoForum.Rejeitado)
            {
            <span class="bg-red-400 text-white dark:bg-red-700 px-3 py-1 rounded-full text-xs font-bold">Rejeitado</span>
            }
            <span class="text-xs text-stone-400 ml-auto font-mono">@Model.CriadoEm.ToString("dd/MM/yyyy HH:mm")</span>
        </div>

        <h1 class="text-2xl md:text-4xl font-headline font-extrabold text-primary dark:text-rose-200 mb-4 leading-tight">@Model.Titulo</h1>
        <p class="text-stone-700 dark:text-stone-300 text-base md:text-lg leading-relaxed mb-6 whitespace-pre-line">@Model.Descricao</p>

        <div class="flex items-center justify-between pt-4 border-t border-stone-100 dark:border-stone-800 text-sm text-stone-500">
            <div class="flex flex-wrap items-center gap-4">
                <span class="flex items-center gap-1 font-semibold text-stone-700 dark:text-stone-400">
                    <span class="material-symbols-outlined text-base">person</span> @Model.AutorNome
                </span>
                <span class="flex items-center gap-1 font-mono text-xs">
                    <span class="material-symbols-outlined text-base">visibility</span> @Model.Visualizacoes visualizações
                </span>
            </div>

            <div class="flex items-center gap-2">
                <!-- Reagir ao Tópico -->
                <form asp-action="Reagir" method="post" class="inline">
                    <input type="hidden" name="topicoId" value="@Model.Id" />
                    <button type="submit"
                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-colors
                                   @(Model.JaReagiu
                                       ? " bg-blue-50 dark:bg-blue-950 /40 text-blue-600 dark:text-blue-400 border-blue-200 dark:border-blue-800"
                            : "bg-stone-50 dark:bg-stone-800 hover:bg-stone-100 dark:hover:bg-stone-700 text-stone-600 dark:text-stone-400 border-stone-200/50 dark:border-stone-700" )">
                        <span class="material-symbols-outlined text-sm" style="@(Model.JaReagiu ? " font-variation-settings: 'FILL' 1" : "" )">
                            thumb_up
                        </span>
                        <span>@(Model.JaReagiu ? "Reagido" : "Reagir") (@Model.TotalReacoes)</span>
                    </button>
                </form>

                <!-- Denunciar Tópico -->
                <button onclick="openDenunciaModal('@Model.Id', null)" class="text-stone-400 hover:text-red-600 p-1.5 transition-colors" title="Denunciar publicação">
                    <span class="material-symbols-outlined text-sm">report</span>
                </button>
            </div>
        </div>
    </article>

    <!-- Listagem de Respostas -->
    <section class="mb-12">
        <h2 class="text-xl font-headline font-bold text-primary dark:text-rose-200 mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined">forum</span>
            Respostas (@Model.Respostas.Count)
        </h2>

        @if (!Model.Respostas.Any())
        {
        <div class="bg-stone-50 dark:bg-stone-900/50 rounded-2xl p-8 text-center text-stone-500 dark:text-stone-400 border border-dashed border-stone-200 dark:border-stone-800">
            Ainda não há respostas. Sê o primeiro a participar neste debate!
        </div>
        }
        else
        {
        @foreach (var resposta in Model.Respostas)
        {
        <div class="bg-white dark:bg-stone-900 rounded-2xl p-6 mb-4 border border-stone-100 dark:border-stone-800/80 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="w-9 h-9 rounded-full bg-primary/10 dark:bg-rose-950/40 flex items-center justify-center text-primary dark:text-rose-300 font-bold shrink-0 text-sm">
                    @(resposta.AutorNome?.Substring(0, Math.Min(1, resposta.AutorNome?.Length ?? 1)) ?? "?")
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1.5">
                        <span class="font-bold text-sm text-stone-800 dark:text-stone-200">@resposta.AutorNome</span>
                        <span class="text-[11px] text-stone-400 font-mono">@resposta.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                        @if (resposta.IsSolucao)
                        {
                        <span class="bg-green-100 text-green-800 dark:bg-green-950/50 dark:text-green-300 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Solução</span>
                        }
                    </div>
                    <p class="text-stone-700 dark:text-stone-300 text-sm leading-relaxed whitespace-pre-line">@resposta.Conteudo</p>

                    <!-- Ações da Resposta -->
                    <div class="flex items-center gap-4 mt-3 pt-2 border-t border-stone-50 dark:border-stone-850 text-xs font-semibold text-stone-500">
                        <form asp-action="Reagir" method="post" class="inline">
                            <input type="hidden" name="topicoId" value="@Model.Id" />
                            <input type="hidden" name="respostaId" value="@resposta.Id" />
                            <button type="submit"
                                    class="flex items-center gap-1 transition-colors
                                                   @(resposta.JaReagiu
                                                       ? " text-blue-600 dark:text-blue-400 font-bold"
                                    : "hover:text-primary dark:hover:text-yellow-500 text-stone-500" )">
                                <span class="material-symbols-outlined text-sm" style="@(resposta.JaReagiu ? " font-variation-settings: 'FILL' 1" : "" )">
                                    thumb_up
                                </span>
                                <span>Reagir (@resposta.TotalReacoes)</span>
                            </button>
                        </form>

                        @if (User.Identity?.IsAuthenticated == true && !isArquivadoOuRejeitado)
                        {
                        <button onclick="toggleReplyForm('@resposta.Id')" class="hover:text-primary dark:hover:text-yellow-500 flex items-center gap-0.5">
                            <span class="material-symbols-outlined text-sm">reply</span> Responder
                        </button>
                        }

                        <button onclick="openDenunciaModal('@Model.Id', '@resposta.Id')" class="text-stone-400 hover:text-red-600 ml-auto flex items-center">
                            <span class="material-symbols-outlined text-sm">report</span>
                        </button>
                    </div>

                    <!-- Formulário de Resposta Alinhada -->
                    @if (User.Identity?.IsAuthenticated == true && !isArquivadoOuRejeitado)
                    {
                    <div id="reply-form-@resposta.Id" class="hidden mt-4 bg-stone-50 dark:bg-stone-800 p-4 rounded-xl border border-stone-200/40 dark:border-stone-700">
                        <form asp-action="Responder" method="post" class="space-y-3">
                            <input type="hidden" name="topicoId" value="@Model.Id" />
                            <input type="hidden" name="respostaPaiId" value="@resposta.Id" />
                            <textarea name="conteudo" rows="2" required class="w-full bg-white dark:bg-stone-900 border-0 rounded-xl p-3 text-xs text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20" placeholder="Escreva a sua resposta direta a @resposta.AutorNome..."></textarea>
                            <div class="flex justify-end gap-2">
                                <button type="button" onclick="toggleReplyForm('@resposta.Id')" class="px-3 py-1.5 rounded-lg text-xs font-bold text-stone-500 hover:bg-stone-200 dark:hover:bg-stone-700">Cancelar</button>
                                <button type="submit" class="bg-primary text-white text-xs px-4 py-1.5 rounded-lg font-bold hover:opacity-95 shadow-sm">Responder</button>
                            </div>
                        </form>
                    </div>
                    }

                    <!-- Respostas Filhas -->
                    @if (resposta.RespostasFilhas != null && resposta.RespostasFilhas.Any())
                    {
                    <div class="mt-4 space-y-3 pl-4 border-l-2 border-stone-200 dark:border-stone-700">
                        @foreach (var filha in resposta.RespostasFilhas)
                        {
                        <div class="bg-stone-50/50 dark:bg-stone-850 p-3.5 rounded-xl">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-bold text-xs text-stone-800 dark:text-stone-300">@filha.AutorNome</span>
                                <span class="text-[10px] text-stone-400 font-mono">@filha.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                                <button onclick="openDenunciaModal('@Model.Id', '@filha.Id')" class="text-stone-400 hover:text-red-600 ml-auto" title="Denunciar resposta">
                                    <span class="material-symbols-outlined text-[14px]">report</span>
                                </button>
                            </div>
                            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed">@filha.Conteudo</p>
                        </div>
                        }
                    </div>
                    }
                </div>
            </div>
        </div>
        }
        }
    </section>

    <!-- Formulário Principal de Resposta -->
    @if (User.Identity?.IsAuthenticated == true)
    {
    if (isArquivadoOuRejeitado)
    {
    <div class="bg-stone-50 dark:bg-stone-900/50 rounded-2xl p-6 text-center text-stone-500 dark:text-stone-400 border border-stone-200/40 dark:border-stone-800">
        <span class="material-symbols-outlined text-2xl align-middle mr-2">block</span>
        Este tópico está @(Model.Estado == EstadoTopicoForum.Arquivado ? "arquivado" : "rejeitado") e não aceita novas respostas.
    </div>
    }
    else
    {
    <section class="bg-stone-50 dark:bg-stone-900 rounded-3xl p-6 md:p-8 border border-stone-200/60 dark:border-stone-800">
        <h3 class="text-lg font-headline font-bold text-primary dark:text-rose-200 mb-4">Adicionar Resposta ao Debate</h3>
        <form asp-action="Responder" method="post">
            <input type="hidden" name="topicoId" value="@Model.Id" />
            <textarea name="conteudo" rows="4" required class="w-full bg-white dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-sm text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20 mb-4" placeholder="Partilhe a sua perspetiva académica fundamentada..."></textarea>
            <button type="submit" class="bg-gradient-to-br from-primary to-primary-container text-white px-8 py-3 rounded-full font-bold hover:opacity-90 transition-opacity shadow-sm text-sm">
                Publicar Resposta
            </button>
        </form>
    </section>
    }
    }
    else
    {
    <div class="text-center py-8 bg-stone-50 dark:bg-stone-900/40 rounded-2xl border border-stone-200/40 dark:border-stone-800">
        <p class="text-sm text-stone-500 mb-2">Pretende expandir este tópico com novos dados económicos?</p>
        <a asp-controller="Auth" asp-action="Login" class="text-primary dark:text-yellow-500 font-bold hover:underline text-sm no-underline">Faça login seguro na sua conta</a> para participar.
    </div>
    }
</div>

<!-- Modal de Arquivamento/Desarquivamento (conteúdo dinâmico) -->
<dialog id="arquivar-dialog" class="backdrop:bg-stone-900/60 p-0 rounded-2xl border-0 shadow-xl max-w-md w-full bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-200">
    <div class="p-6">
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100 dark:border-stone-800">
            <h3 class="font-headline font-bold text-lg text-primary dark:text-rose-300 flex items-center gap-1.5">
                <span class="material-symbols-outlined @(isArquivado ? " text-green-600" : "text-red-600" )">@iconeBotao</span> @tituloModal
            </h3>
            <button type="button" onclick="document.getElementById('arquivar-dialog').close()" class="text-stone-400 hover:text-stone-600">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <p class="text-sm text-stone-600 dark:text-stone-400 mb-6 leading-relaxed">
            @mensagemModal
        </p>

        <form asp-action="@acaoArquivar" asp-route-id="@Model.Id" method="post" class="flex justify-end gap-2">
            @Html.AntiForgeryToken()
            <button type="button" onclick="document.getElementById('arquivar-dialog').close()" class="px-4 py-2 text-sm font-semibold rounded-xl text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800">
                Cancelar
            </button>
            <button type="submit" class="px-5 py-2 text-sm font-bold rounded-xl @corConfirmacao text-white shadow-sm transition-colors">
                @textoConfirmacao
            </button>
        </form>
    </div>
</dialog>

<!-- Modal de Denúncia -->
<dialog id="denuncia-dialog" class="backdrop:bg-stone-900/60 p-0 rounded-2xl border-0 shadow-xl max-w-md w-full bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-200">
    <div class="p-6">
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100 dark:border-stone-800">
            <h3 class="font-headline font-bold text-lg text-primary dark:text-rose-300 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-red-600">report</span> Reportar Conteúdo
            </h3>
            <button onclick="document.getElementById('denuncia-dialog').close()" class="text-stone-400 hover:text-stone-600"><span class="material-symbols-outlined">close</span></button>
        </div>
        <form asp-action="Denunciar" method="post" class="space-y-4">
            <input type="hidden" id="denuncia-topico-id" name="topicoId" />
            <input type="hidden" id="denuncia-resposta-id" name="respostaId" />

            <div>
                <label class="block text-xs font-bold text-stone-500 uppercase tracking-wider mb-2">Motivo da Infração</label>
                <select name="motivo" required class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl p-3 text-sm focus:ring-2 focus:ring-primary/20">
                    <option value="0">Conteúdo Off-Topic / Irrelevante</option>
                    <option value="1">Spam ou Publicidade Comercial</option>
                    <option value="2">Linguagem Imprópria / Ofensiva</option>
                    <option value="3">Falta de Rigor Científico ou Plágio</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-stone-500 uppercase tracking-wider mb-2">Descrição Adicional (Opcional)</label>
                <textarea name="descricao" rows="3" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl p-3 text-sm focus:ring-2 focus:ring-primary/20" placeholder="Insira mais detalhes para a equipa de moderação analisar..."></textarea>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="document.getElementById('denuncia-dialog').close()" class="px-4 py-2 text-sm font-semibold rounded-xl text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800">Cancelar</button>
                <button type="submit" class="px-5 py-2 text-sm font-bold rounded-xl bg-red-600 hover:bg-red-700 text-white shadow-sm">Submeter Relatório</button>
            </div>
        </form>
    </div>
</dialog>

<script>
    function openArquivarModal() {
        const dialog = document.getElementById('arquivar-dialog');
        if (dialog) dialog.showModal();
    }

    function toggleReplyForm(id) {
        const form = document.getElementById('reply-form-' + id);
        if (form) form.classList.toggle('hidden');
    }

    function openDenunciaModal(topicoId, respostaId) {
        const topicoField = document.getElementById('denuncia-topico-id');
        const respostaField = document.getElementById('denuncia-resposta-id');

        if (respostaId) {
            // Denunciar uma resposta
            topicoField.value = '';
            respostaField.value = respostaId;
        } else {
            // Denunciar um tópico
            topicoField.value = topicoId;
            respostaField.value = '';
        }

        const dialog = document.getElementById('denuncia-dialog');
        if (dialog) dialog.showModal();
    }
</script>