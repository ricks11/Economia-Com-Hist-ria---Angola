@using EconomiaComHistoria.Core.DTOs
@using EconomiaComHistoria.Core.Enums
@model EconomiaComHistoria.Core.DTOs.CriarTopicoForumDto
@{
    ViewData["Title"] = "Criar Novo Tópico";
    var categorias = ViewData["Categorias"] as System.Collections.Generic.IEnumerable<CategoriaForumDto>
    ?? new System.Collections.Generic.List<CategoriaForumDto>
        ();
        var escolas = ViewData["Escolas"] as System.Collections.Generic.IEnumerable<EscolaResponseDto>
            ?? new System.Collections.Generic.List<EscolaResponseDto>
                ();
                var turmas = ViewData["Turmas"] as System.Collections.Generic.IEnumerable<TurmaResponseDto>
                    ?? new System.Collections.Generic.List<TurmaResponseDto>
                        ();
                        }

                        <div class="max-w-3xl mx-auto px-4 py-4">
                            <a asp-action="Index" class="inline-flex items-center gap-2 text-primary dark:text-yellow-500 font-bold mb-8 hover:underline no-underline">
                                <span class="material-symbols-outlined">arrow_back</span> Voltar ao fórum
                            </a>

                            <header class="mb-10">
                                <h1 class="text-4xl font-headline font-extrabold text-primary dark:text-rose-200 mb-3">Criar Novo Tópico</h1>
                                <p class="text-stone-500 dark:text-stone-400">Inicie um debate académico sobre a economia e história de Angola.</p>
                            </header>

                            <div class="bg-white dark:bg-stone-900 rounded-3xl p-8 border border-stone-200/80 dark:border-stone-800 ambient-shadow">
                                <form asp-action="Criar" method="post" class="space-y-6">
                                    <!-- Visibilidade -->
                                    <div>
                                        <label class="block text-sm font-bold text-stone-600 dark:text-stone-400 mb-2">Visibilidade</label>
                                        <select asp-for="Visibilidade" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20" onchange="toggleVisibilidadeFields(this.value)">
                                            <option value="0">Público (todos veem)</option>
                                            <option value="1">Privado (apenas autor e moderadores)</option>
                                            <option value="2">Escola (apenas membros da sua escola)</option>
                                            <option value="3">Turma (apenas membros da sua turma)</option>
                                        </select>
                                    </div>

                                    <!-- Escola (visível se Visibilidade == Escola) -->
                                    <div id="escola-field" style="display:none">
                                        <label class="block text-sm font-bold text-stone-600 dark:text-stone-400 mb-2">Escola</label>
                                        <select asp-for="EscolaId" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20">
                                            <option value="">Selecione...</option>
                                            @foreach (var escola in escolas)
                                            {
                                            <option value="@escola.Id">@escola.Nome</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Turma (visível se Visibilidade == Turma) -->
                                    <div id="turma-field" style="display:none">
                                        <label class="block text-sm font-bold text-stone-600 dark:text-stone-400 mb-2">Turma</label>
                                        <select asp-for="TurmaId" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20">
                                            <option value="">Selecione...</option>
                                            @foreach (var turma in turmas)
                                            {
                                            <option value="@turma.Id">@turma.Nome</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Categoria -->
                                    <div>
                                        <label asp-for="CategoriaId" class="block text-sm font-bold text-stone-600 dark:text-stone-400 mb-2">Categoria</label>
                                        <select asp-for="CategoriaId" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20">
                                            @foreach (var cat in categorias)
                                            {
                                            <option value="@cat.Id">@cat.Nome</option>
                                            }
                                        </select>
                                        <span asp-validation-for="CategoriaId" class="text-error text-sm"></span>
                                    </div>

                                    <!-- Título -->
                                    <div>
                                        <label asp-for="Titulo" class="block text-sm font-bold text-stone-600 dark:text-stone-400 mb-2">Título</label>
                                        <input asp-for="Titulo" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20" placeholder="Ex: Impacto do petróleo na economia angolana" />
                                        <span asp-validation-for="Titulo" class="text-error text-sm"></span>
                                    </div>

                                    <!-- Descrição -->
                                    <div>
                                        <label asp-for="Descricao" class="block text-sm font-bold text-stone-600 dark:text-stone-400 mb-2">Descrição / Contexto</label>
                                        <textarea asp-for="Descricao" rows="6" class="w-full bg-stone-50 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700 rounded-2xl p-4 text-stone-800 dark:text-stone-200 focus:ring-2 focus:ring-primary/20" placeholder="Explique a sua tese ou questão de investigação..."></textarea>
                                        <span asp-validation-for="Descricao" class="text-error text-sm"></span>
                                    </div>

                                    <button type="submit" class="w-full bg-gradient-to-br from-primary to-primary-container text-white py-4 rounded-xl font-bold hover:opacity-90 transition-opacity shadow-sm">
                                        Publicar Tópico
                                    </button>
                                </form>
                            </div>
                        </div>

                        <script>
                            function toggleVisibilidadeFields(value) {
                                document.getElementById('escola-field').style.display = (value == '2') ? 'block' : 'none';
                                document.getElementById('turma-field').style.display = (value == '3') ? 'block' : 'none';
                            }

                            document.addEventListener('DOMContentLoaded', function () {
                                var val = document.querySelector('select[name="Visibilidade"]').value;
                                toggleVisibilidadeFields(val);
                            });
                        </script>

                        @section Scripts {
                        <partial name="_ValidationScriptsPartial" />
                        }
