@model EconomiaComHistoria.Core.DTOs.LoginRequestDto

@{
    ViewData["Title"] = "Recuperar Password";
}

<section class="flex min-h-[80vh] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-surface-container-lowest rounded-[2rem] p-8 md:p-10 shadow-xl shadow-stone-200/50 border border-stone-100/50">

        <div class="mb-8 text-center">
            <h2 class="text-2xl font-headline font-bold text-stone-800">Recuperar Conta</h2>
            <p class="text-sm text-stone-400 mt-2">Insira o seu email académico para receber as instruções de recuperação de palavra‑passe.</p>
        </div>

        <form id="forgotPasswordForm" asp-action="ForgotPassword" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-error text-sm font-medium bg-error/10 p-3 rounded-xl"></div>

            <div class="space-y-1">
                <label asp-for="Email" class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Email académico</label>
                <input asp-for="Email" type="email" required
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400 text-stone-800"
                       placeholder="nome@universidade.ao">
                <span asp-validation-for="Email" class="text-error text-xs font-medium ml-1 block mt-1"></span>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-2xl shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 tracking-wide">
                    Enviar instruções
                </button>
            </div>

            <p class="text-center text-sm pt-2">
                <a asp-action="Login" asp-controller="Auth" class="text-stone-500 font-medium hover:text-primary transition-all">Lembrou-se da palavra‑passe? Entrar</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}