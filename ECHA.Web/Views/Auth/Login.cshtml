@model EconomiaComHistoria.Core.DTOs.LoginRequestDto

@{
    ViewData["Title"] = "Login & Registo";
}

<section class="flex min-h-[80vh] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-surface-container-lowest rounded-[2rem] p-8 md:p-10 shadow-xl shadow-stone-200/50 border border-stone-100/50">

        <div class="flex justify-center gap-8 mb-8 border-b border-stone-200/60 pb-3 relative">
            <button id="loginTab" class="text-lg font-headline font-bold text-primary border-b-2 border-primary pb-3 transition-all duration-300 focus:outline-none">
                Entrar
            </button>
            <button id="registerTab" class="text-lg font-headline font-bold text-stone-400 pb-3 transition-all duration-300 focus:outline-none hover:text-stone-600">
                Criar conta
            </button>
        </div>

        <form id="loginForm" asp-action="Login" method="post" class="space-y-6 transition-all duration-300">
            <div asp-validation-summary="ModelOnly" class="text-error text-sm font-medium bg-error/10 p-3 rounded-xl"></div>

            <div class="space-y-1">
                <label asp-for="Email" class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Email académico</label>
                <input asp-for="Email" type="email"
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400 text-stone-800"
                       placeholder="nome@universidade.ao">
                <span asp-validation-for="Email" class="text-error text-xs font-medium ml-1 block mt-1"></span>
            </div>

            <div class="space-y-1">
                <label asp-for="Password" class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Palavra‑passe</label>
                <input asp-for="Password" type="password"
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400"
                       placeholder="••••••••">
                <span asp-validation-for="Password" class="text-error text-xs font-medium ml-1 block mt-1"></span>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-2xl shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 tracking-wide">
                    Aceder ao Arquivo
                </button>
            </div>

            <p class="text-center text-sm pt-2">
                <a asp-action="ForgotPassword" asp-controller="Auth" class="text-tertiary font-medium hover:underline transition-all">Esqueceu a palavra‑passe?</a>
            </p>
        </form>

        <form id="registerForm" asp-action="Register" method="post" class="space-y-6 hidden opacity-0 transition-all duration-300">
            <div class="space-y-1">
                <label class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Nome completo</label>
                <input type="text" name="Nome" required
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400 text-stone-800"
                       placeholder="Maria da Silva">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Email</label>
                <input type="email" name="Email" required
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400 text-stone-800"
                       placeholder="m.silva@academia.ao">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Telemóvel</label>
                <input type="tel" name="Telemovel"
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400 text-stone-800"
                       placeholder="9XXXXXXXX">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-bold text-stone-500 tracking-wide uppercase ml-1">Palavra-passe</label>
                <input type="password" name="Password" required
                       class="w-full bg-surface-container-low border border-transparent rounded-2xl p-4 transition-all duration-200 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none placeholder-stone-400 text-stone-800"
                       placeholder="••••••••">
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full bg-tertiary text-white font-bold py-4 rounded-2xl shadow-lg shadow-tertiary/20 hover:shadow-xl hover:shadow-tertiary/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 tracking-wide">
                    Registar como Investigador
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
    const loginTab = document.getElementById('loginTab');
    const registerTab = document.getElementById('registerTab');
    const loginForm = document.getElementById('loginForm');
    const registerForm = document.getElementById('registerForm');

    function switchTab(activeTab, inactiveTab, showForm, hideForm) {
        // Form Handling com opacidade para transição mais suave
        hideForm.classList.add('hidden');
        hideForm.classList.remove('opacity-100');

        showForm.classList.remove('hidden');
        setTimeout(() => {
            showForm.classList.add('opacity-100');
        }, 50);

        // Tab Handling
        activeTab.classList.add('border-primary', 'text-primary', 'border-b-2');
        activeTab.classList.remove('text-stone-400');

        inactiveTab.classList.remove('border-primary', 'text-primary', 'border-b-2');
        inactiveTab.classList.add('text-stone-400');
    }

    loginTab.onclick = () => switchTab(loginTab, registerTab, loginForm, registerForm);
    registerTab.onclick = () => switchTab(registerTab, loginTab, registerForm, loginForm);

    // Se o servidor indicar que o erro veio do registo, ativa a aba de registo imediatamente no reload
    @if (ViewData["ActiveTab"]?.ToString() == "register") {
        <text>
            switchTab(registerTab, loginTab, registerForm, loginForm);
        </text>
    }
</script>
}