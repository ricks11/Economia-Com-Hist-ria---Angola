@{
    ViewData["Title"] = "Recuperação de Password";
}

<section class="flex items-center justify-center px-6 min-h-[calc(100vh-160px)]">
  <div class="max-w-md w-full bg-surface-container-lowest rounded-3xl p-8 shadow-sm text-center">
    <div class="flex justify-center mb-8">
      <span class="material-symbols-outlined text-primary text-4xl">mail</span>
    </div>
    <h2 class="text-2xl font-headline font-bold text-primary mb-6">Instruções enviadas!</h2>
    <p class="text-secondary mb-6">
      Se existir uma conta associada a este email, você receberá em breve instruções para redefinir sua palavra‑passe.
    </p>
    <a asp-action="Login" asp-controller="Auth" class="w-full bg-primary text-white font-bold py-4 rounded-full shadow-md hover:-translate-y-0.5 transition block mb-4">Voltar ao login</a>
    <a asp-action="Index" asp-controller="Home" class="text-tertiary hover:underline block">Voltar à inicial</a>
  </div>
</section>
