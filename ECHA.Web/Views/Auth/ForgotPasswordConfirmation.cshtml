@{
    ViewData["Title"] = "Recuperação de Password";
}

<section class="flex min-h-[80vh] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-surface-container-lowest rounded-[2rem] p-8 md:p-10 shadow-xl shadow-stone-200/50 border border-stone-100/50 text-center">

        <div class="flex justify-center mb-6">
            <div class="flex items-center justify-center h-16 w-16 bg-primary/10 rounded-full text-primary">
                <span class="material-symbols-outlined text-3xl">mail</span>
            </div>
        </div>

        <h2 class="text-2xl font-headline font-bold text-stone-800 mb-3">Instruções enviadas!</h2>

        <p class="text-stone-500 text-sm leading-relaxed mb-8 px-2">
            Se existir uma conta associada a este email, receberá em breve uma mensagem com as instruções necessárias para redefinir a sua palavra‑passe.
        </p>

        <div class="space-y-4">
            <a asp-action="Login" asp-controller="Auth"
               class="w-full bg-primary text-white font-bold py-4 rounded-2xl shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 tracking-wide block">
                Voltar ao login
            </a>

            <a asp-action="Index" asp-controller="Home"
               class="text-stone-500 text-sm font-medium hover:text-tertiary transition-all block pt-2">
                Voltar à página inicial
            </a>
        </div>
    </div>
</section>