@using EconomiaComHistoria.Core.DTOs
@model RankingResponseDto
@{
    ViewData["Title"] = "Ranking e Leaderboard";

    var tipoAtual = (ViewData["TipoAtual"] as string)?.Trim() ?? "Nacional";
    var periodoAtual = (ViewData["PeriodoAtual"] as string)?.Trim() ?? "Semanal";
    var escolaId = ViewData["EscolaId"] as int?;
    var provincia = ViewData["Provincia"] as string ?? "";
    var municipio = ViewData["Municipio"] as string ?? "";

    // Comparação case-insensitive para evitar falhas entre "escola" e "Escola"
    bool IsTipo(string tipo) => string.Equals(tipoAtual, tipo, StringComparison.OrdinalIgnoreCase);
    bool IsPeriodo(string periodo) => string.Equals(periodoAtual, periodo, StringComparison.OrdinalIgnoreCase);
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <!-- Cabeçalho -->
    <header class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <h1 class="text-3xl md:text-4xl font-headline font-extrabold text-primary tracking-tight">Ranking</h1>
            <p class="text-on-surface-variant mt-2">Classificação dos investigadores mais ativos na plataforma.</p>
        </div>
        @if (Model != null && Model.PosicaoUtilizador > 0)
        {
        <div class="bg-gradient-to-br from-primary to-primary-container text-on-primary px-6 py-4 rounded-2xl text-center shadow-sm">
            <p class="text-xs uppercase tracking-widest opacity-80">A tua posição</p>
            <p class="text-3xl font-headline font-extrabold">#@Model.PosicaoUtilizador</p>
            <p class="text-sm">@Model.PontosUtilizador pontos</p>
        </div>
        }
    </header>

    <!-- Filtros -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-stone-200/60 dark:border-stone-800">
        <!-- Tipo -->
        <div class="flex flex-wrap items-center gap-2">
            <a href="@Url.Action("Index", new { tipo="Nacional" , periodo=periodoAtual })"
               class="px-4 py-2 rounded-xl text-xs font-bold transition-all no-underline border @(IsTipo("Nacional") ? "bg-primary border-primary text-on-primary shadow-sm" : "bg-surface-container-low/50 border-surface-container-low/50 text-on-surface-variant/70 hover:bg-surface-container-low/70" )">
                Nacional
            </a>
            <a href="@Url.Action("Index", new { tipo="Escola" , periodo=periodoAtual, escolaId=escolaId })"
               class="px-4 py-2 rounded-xl text-xs font-bold transition-all no-underline border @(IsTipo("Escola") ? "bg-primary border-primary text-on-primary shadow-sm" : "bg-surface-container-low/50 border-surface-container-low/50 text-on-surface-variant/70 hover:bg-surface-container-low/70" )">
                Escola
            </a>
            <a href="@Url.Action("Index", new { tipo="Provincia" , periodo=periodoAtual, provincia=provincia })"
               class="px-4 py-2 rounded-xl text-xs font-bold transition-all no-underline border @(IsTipo("Provincia") ? "bg-primary border-primary text-on-primary shadow-sm" : "bg-surface-container-low/50 border-surface-container-low/50 text-on-surface-variant/70 hover:bg-surface-container-low/70" )">
                Província
            </a>
            <a href="@Url.Action("Index", new { tipo="Municipio" , periodo=periodoAtual, municipio=municipio })"
               class="px-4 py-2 rounded-xl text-xs font-bold transition-all no-underline border @(IsTipo("Municipio") ? "bg-primary border-primary text-on-primary shadow-sm" : "bg-surface-container-low/50 border-surface-container-low/50 text-on-surface-variant/70 hover:bg-surface-container-low/70" )">
                Município
            </a>
        </div>

        <!-- Período -->
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Index", new { tipo=tipoAtual, periodo="Semanal" })"
               class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all no-underline @(IsPeriodo("Semanal") ? "bg-surface-container-low dark:bg-surface-container-low text-on-primary dark:text-on-primary/90 shadow-sm" : "text-on-surface-variant/70 hover:text-on-surface-variant/50" )">
                Semanal
            </a>
            <a href="@Url.Action("Index", new { tipo=tipoAtual, periodo="Historico" })"
               class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all no-underline @(IsPeriodo("Historico") ? "bg-surface-container-low dark:bg-surface-container-low text-on-primary dark:text-on-primary/90 shadow-sm" : "text-on-surface-variant/70 hover:text-on-surface-variant/50" )">
                Histórico
            </a>
        </div>
    </div>

    <!-- Ranking Table -->
    @if (Model != null && Model.Top100 != null && Model.Top100.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-stone-200 dark:divide-stone-700">
                <thead class="bg-stripe">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider">
                            Pos.
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider">
                            Investigador
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider">
                            Pontos
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider">
                            Quizzes Completados
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider">
                            Escola
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200 dark:divide-stone-700">
                    @foreach (var entrada in Model.Top100)
                    {
                        <tr class="hover:bg-stone-50/50 dark:hover:bg-stone-900/50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-on-surface-variant">
                                #@entrada.Posicao
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-on-surface-variant">
                                @entrada.NomeUtilizador
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-on-surface-variant">
                                @entrada.Pontos.ToString("N0")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-on-surface-variant">
                                @entrada.QuizzesCompletados.ToString("N0")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-on-surface-variant">
                                @(string.IsNullOrEmpty(entrada.EscolaNome) ? "Não informada" : entrada.EscolaNome)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-12">
            <p class="text-on-surface-variant/60">Nenhum dado encontrado para os filtros selecionados.</p>
        </div>
    }
</div>
