@model EconomiaComHistoria.Core.DTOs.SolicitarRelatorioDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Solicitar Relatório";
}

<div class="max-w-4xl mx-auto px-6 pt-12">
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-800 rounded-r-xl shadow-sm flex items-center gap-3">
        <span class="material-symbols-outlined text-red-600">error</span>
        <span class="font-medium">@TempData["ErrorMessage"]</span>
    </div>
    }

    <header class="mb-12 flex justify-between items-center flex-wrap gap-4">
        <div>
            <h1 class="text-4xl font-headline font-extrabold text-primary tracking-tight">Solicitar Novo Relatório</h1>
            <p class="text-secondary mt-2">Escolha o tipo e os filtros para o relatório desejado.</p>
        </div>
        <a asp-action="Index" class="px-6 py-3 rounded-full bg-surface-container text-secondary font-bold hover:bg-surface-container-high transition-colors decoration-none">
            Voltar
        </a>
    </header>

    <section class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm border border-stone-200/60">
        <form asp-action="Criar" method="post" class="space-y-6">
            <div>
                <label asp-for="Titulo" class="block font-bold text-on-surface mb-2">Título do Relatório</label>
                <input asp-for="Titulo" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-surface-container text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Ex: Desempenho da Turma 10ªA - Junho" required />
                <span asp-validation-for="Titulo" class="text-danger text-sm mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Tipo" class="block font-bold text-on-surface mb-2">Formato</label>
                    <select asp-for="Tipo" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-surface-container text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="CSV" selected>CSV (Excel)</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EscolaId" class="block font-bold text-on-surface mb-2">Escola (opcional)</label>
                    <select asp-for="EscolaId" asp-items="@(ViewData["Escolas"] as SelectList)" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-surface-container text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="">Todas as Escolas</option>
                    </select>
                    <span asp-validation-for="EscolaId" class="text-danger text-sm mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="TurmaId" class="block font-bold text-on-surface mb-2">Turma (opcional)</label>
                <select asp-for="TurmaId" asp-items="@(ViewData["Turmas"] as SelectList)" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-surface-container text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="">Todas as Turmas</option>
                </select>
                <span asp-validation-for="TurmaId" class="text-danger text-sm mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Inicio" class="block font-bold text-on-surface mb-2">Data Início</label>
                    <input asp-for="Inicio" type="date" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-surface-container text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label asp-for="Fim" class="block font-bold text-on-surface mb-2">Data Fim</label>
                    <input asp-for="Fim" type="date" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-surface-container text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
            </div>

            <div class="flex gap-4 pt-4">
                <button type="submit" class="flex-1 py-3 rounded-full bg-primary text-white font-bold hover:shadow-lg transition-all border-none">
                    Solicitar Relatório
                </button>
                <a asp-action="Index" class="flex-1 py-3 rounded-full bg-surface-container text-secondary font-bold hover:bg-surface-container-high transition-colors text-center decoration-none">
                    Cancelar
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}