@using EconomiaComHistoria.Core.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@model List<EconomiaComHistoria.Core.DTOs.RelatorioListaDto>
    @{
    ViewData["Title"] = "Relatórios";
    var escolaId = ViewData["EscolaId"] as int?;
    }

    <main class="py-10 px-4 sm:px-6 max-w-5xl mx-auto space-y-8 font-sans">

        <!-- Mensagens de Feedback (Alertas) -->
        @if (TempData["SuccessMessage"] != null)
        {
        <div class="p-4 bg-green-50 border-l-4 border-green-500 text-green-800 rounded-r-xl shadow-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-green-600">check_circle</span>
            <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
        </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="p-4 bg-red-50 border-l-4 border-red-500 text-red-800 rounded-r-xl shadow-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-red-600">error</span>
            <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
        </div>
        }

        <!-- Cabeçalho Principal -->
        <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200/60 pb-6">
            <div>
                <h1 class="text-3xl sm:text-4xl font-black text-primary tracking-tight font-headline">Meus Relatórios</h1>
                <p class="text-sm text-stone-500 mt-1">Lista de relatórios gerados ou em fila de processamento no sistema.</p>
            </div>
            <a asp-action="Criar" asp-route-escolaId="@escolaId"
               class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary text-white font-bold text-sm shadow-md shadow-primary/10 hover:opacity-95 transition-all no-underline self-start sm:self-auto">
                <span class="material-symbols-outlined text-[20px]">add</span>
                Novo Relatório
            </a>
        </header>

        <!-- Barra de Filtros e Ferramentas -->
        <div class="bg-white rounded-2xl p-4 border border-stone-200/70 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            <form method="get" asp-action="Index" class="flex items-center gap-3 flex-1 min-w-0">
                <span class="material-symbols-outlined text-stone-400 shrink-0">filter_list</span>
                <div class="w-full max-w-xs relative">
                    <!-- Correção do espaço na string do ViewData -->
                    <select id="escolaId" name="escolaId" asp-items="@(ViewData["Escolas"] as SelectList)" onchange="this.form.submit()"
                            class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-stone-200 bg-stone-50 text-stone-700 font-medium text-sm focus:outline-none focus:ring-2 focus:ring-primary/25 focus:border-primary transition-all cursor-pointer appearance-none">
                        <option value="">Todas as Escolas</option>
                    </select>
                    <span class="material-symbols-outlined text-stone-400 text-lg absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">expand_more</span>
                </div>
            </form>

            @if (escolaId.HasValue)
            {
            <a asp-action="Index" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-stone-100 text-stone-600 text-xs font-bold hover:bg-stone-200 transition-colors no-underline">
                <span class="material-symbols-outlined text-[16px]">close</span>
                Limpar Filtro
            </a>
            }
        </div>

        <!-- Estado Vazio (Empty State) -->
        @if (!Model.Any())
        {
        <div class="text-center py-16 px-4 bg-stone-50 rounded-2xl border border-dashed border-stone-200">
            <div class="w-14 h-14 bg-white rounded-xl border border-stone-200/60 shadow-sm flex items-center justify-center mx-auto mb-4 text-stone-400">
                <span class="material-symbols-outlined text-2xl">description</span>
            </div>
            <h3 class="text-base font-bold text-stone-800 font-headline">Nenhum relatório encontrado</h3>
            <p class="text-stone-500 max-w-sm mx-auto mt-1 text-xs leading-relaxed">Não existem registos guardados para o filtro selecionado ou ainda não submeteu nenhum pedido de extração.</p>
            <a asp-action="Criar" asp-route-escolaId="@escolaId" class="inline-block mt-5 px-6 py-2.5 rounded-xl bg-primary text-white font-bold text-xs hover:opacity-95 shadow-sm transition-all no-underline">
                Solicitar Primeiro Relatório
            </a>
        </div>
        }
        else
        {
        <!-- Painel da Tabela de Dados -->
        <div class="bg-white rounded-2xl border border-stone-200/70 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-stone-100 table-fixed md:table-auto">
                    <thead>
                        <tr class="bg-stone-50 text-stone-500 text-[11px] font-bold uppercase tracking-wider border-b border-stone-200/60">
                            <th class="px-6 py-4 text-left w-full md:w-2/5 min-w-[220px]">Título do Documento</th>
                            <th class="px-6 py-4 text-left min-w-[130px]">Tipo</th>
                            <th class="px-6 py-4 text-left min-w-[140px]">Estado</th>
                            <th class="px-6 py-4 text-left min-w-[180px]">Data de Solicitação</th>
                            <th class="px-6 py-4 text-right pr-6 min-w-[110px]">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 bg-white">
                        @foreach (var item in Model)
                        {
                        <tr class="hover:bg-stone-50/50 transition-colors group">
                            <td class="px-6 py-4 font-bold text-stone-900 truncate max-w-[240px] md:max-w-none text-sm">
                                @item.Titulo
                            </td>
                            <td class="px-6 py-4 text-sm">
                                <span class="inline-block px-2.5 py-1 bg-stone-100 text-stone-600 rounded-md text-[11px] font-bold tracking-wide border border-stone-200/40">
                                    @item.Tipo
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm">
                                @if (item.Estado == EstadoRelatorio.Concluido)
                                {
                                <span class="inline-flex items-center gap-1 bg-green-50 text-green-700 px-2.5 py-1 rounded-lg text-xs font-bold border border-green-200/60">
                                    <span class="material-symbols-outlined text-[15px] text-green-600">check_circle</span>
                                    Concluído
                                </span>
                                }
                                else if (item.Estado == EstadoRelatorio.Processando || item.Estado == EstadoRelatorio.Pendente)
                                {
                                <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 px-2.5 py-1 rounded-lg text-xs font-bold border border-amber-200/60 animate-pulse">
                                    <span class="material-symbols-outlined text-[15px] text-amber-600 animate-spin">progress_activity</span>
                                    Processando
                                </span>
                                }
                                else if (item.Estado == EstadoRelatorio.Erro || item.Estado == EstadoRelatorio.Expirado)
                                {
                                <span class="inline-flex items-center gap-1 bg-red-50 text-red-700 px-2.5 py-1 rounded-lg text-xs font-bold border border-red-200/60">
                                    <span class="material-symbols-outlined text-[15px] text-red-600">cancel</span>
                                    Erro
                                </span>
                                }
                                else
                                {
                                <span class="inline-flex items-center gap-1 bg-stone-50 text-stone-700 px-2.5 py-1 rounded-lg text-xs font-bold border border-stone-200/60">
                                    @item.Estado
                                </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-xs text-stone-500 font-mono font-medium">
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-stone-400 text-[16px]">calendar_today</span>
                                    <span>@item.DataSolicitacao.ToString("dd/MM/yyyy · HH:mm")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right pr-6 text-xs font-bold">
                                <a asp-action="Status" asp-route-id="@item.Id"
                                   class="text-primary hover:opacity-80 inline-flex items-center justify-end gap-0.5 group-hover:translate-x-0.5 transition-transform no-underline">
                                    Detalhes
                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                </a>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        }
    </main>
