@model EconomiaComHistoria.Core.DTOs.SolicitarRelatorioDto
@{
    ViewData["Title"] = "Relatórios e Exportações";
}

<main class="pt-12 pb-12 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <aside class="md:col-span-3 bg-surface-container-lowest rounded-3xl p-6 h-fit sticky top-24 border border-stone-200/60 shadow-sm">
            <nav class="space-y-2">
                <a asp-controller="Escolas" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-stone-600 hover:bg-surface-container-high transition decoration-none">
                    <span class="material-symbols-outlined">school</span> Escolas
                </a>
                <a asp-controller="Turmas" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-stone-600 hover:bg-surface-container-high transition decoration-none">
                    <span class="material-symbols-outlined">group</span> Turmas
                </a>
                <a asp-controller="Relatorios" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/5 text-primary font-bold decoration-none">
                    <span class="material-symbols-outlined">bar_chart</span> Relatórios
                </a>
            </nav>
        </aside>

        <div class="md:col-span-9 space-y-8">
            <div>
                <h1 class="text-3xl font-headline font-extrabold text-primary tracking-tight">Relatórios e Exportações</h1>
                <p class="text-on-surface-variant mt-2">Gere ficheiros CSV/PDF com dados de utilizadores, comentários, conteúdos e estatísticas de acesso.</p>
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm">
                <h2 class="text-xl font-headline font-bold text-primary mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined">add_chart</span>
                    Configurar Novo Relatório
                </h2>
                <form asp-action="Gerar" class="space-y-5">
                    <div class="space-y-2">
                        <label asp-for="Titulo" class="text-xs font-bold text-stone-600 ml-2">Título do Relatório</label>
                        <input asp-for="Titulo" class="w-full bg-surface-container-low border-none rounded-2xl p-4 focus:ring-2 focus:ring-primary/20" placeholder="Ex: Desempenho Turma 10ªA - Junho" required />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                            <label asp-for="Tipo" class="text-xs font-bold text-stone-600 ml-2">Formato de Exportação</label>
                            <select asp-for="Tipo" class="w-full bg-surface-container-low border-none rounded-2xl p-4 focus:ring-2 focus:ring-primary/20">
                                <option value="PDF">Documento PDF</option>
                                <option value="CSV">Planilha Excel (CSV)</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-stone-600 ml-2">Escopo</label>
                            <select name="Escopo" class="w-full bg-surface-container-low border-none rounded-2xl p-4 focus:ring-2 focus:ring-primary/20">
                                <option value="Escola">Toda a Escola</option>
                                <option value="Turma">Turma Específica</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                            <label asp-for="Inicio" class="text-xs font-bold text-stone-600 ml-2">Data Início</label>
                            <input asp-for="Inicio" type="date" class="w-full bg-surface-container-low border-none rounded-2xl p-4 focus:ring-2 focus:ring-primary/20" />
                        </div>
                        <div class="space-y-2">
                            <label asp-for="Fim" class="text-xs font-bold text-stone-600 ml-2">Data Fim</label>
                            <input asp-for="Fim" type="date" class="w-full bg-surface-container-low border-none rounded-2xl p-4 focus:ring-2 focus:ring-primary/20" />
                        </div>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-full shadow-md hover:shadow-lg transition-all">Solicitar Geração</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
