@model EconomiaComHistoria.Core.DTOs.PerfilResponseDto
@{
    ViewData["Title"] = "Perfil - Economia com História – Angola";
}

<div class="max-w-6xl mx-auto min-h-screen flex flex-col pt-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Profile Header & Avatar Area -->
        <section class="lg:col-span-5 bg-surface-container-lowest rounded-3xl p-8 shadow-sm flex flex-col items-center text-center border border-outline-variant/10">
            <div class="relative group mb-6">
                <div class="w-40 h-40 rounded-full bg-stone-100 overflow-hidden ring-8 ring-surface-container-low shadow-inner">
                    <img class="w-full h-full object-cover" src="https://ui-avatars.com/api/?name=@Model.Nome&background=random" alt="@Model.Nome">
                </div>
            </div>
            <h1 class="text-3xl font-headline font-extrabold text-primary mb-1">@Model.Nome</h1>
            <p class="text-stone-500 font-medium mb-2 font-body">@Model.Email</p>
            @if (!string.IsNullOrEmpty(Model.Telemovel))
            {
                <p class="text-stone-400 text-sm font-body">@Model.Telemovel</p>
            }
            @if (!string.IsNullOrEmpty(Model.Provincia))
            {
                <p class="text-stone-400 text-sm font-body mt-1">@Model.Provincia</p>
            }
        </section>

        <!-- Form Fields & Actions -->
        <section class="lg:col-span-7 space-y-6">
            <!-- Profile Edit Form -->
            <div class="bg-surface-container rounded-3xl p-8 border border-outline-variant/10">
                <h2 class="text-xl font-headline font-bold text-primary mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined">person_edit</span>
                    Informações do Perfil
                </h2>
                <div class="space-y-5">
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-stone-600 ml-2 font-body">Nome</label>
                        <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800 font-body" readonly value="@Model.Nome"/>
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-stone-600 ml-2 font-body">Email</label>
                        <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800 font-body" readonly value="@Model.Email"/>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.EscolaNome))
                    {
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-stone-600 ml-2 font-body">Escola</label>
                            <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800 font-body" readonly value="@Model.EscolaNome"/>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TurmaNome))
                    {
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-stone-600 ml-2 font-body">Turma</label>
                            <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800 font-body" readonly value="@Model.TurmaNome"/>
                        </div>
                    }
                </div>
            </div>
            
            <!-- Stats Section -->
            <div class="bg-surface-container-lowest rounded-3xl p-8 border border-outline-variant/10">
                <h3 class="text-xl font-headline font-bold text-primary mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined">insights</span>
                    Estatísticas
                </h3>
                <div class="grid grid-cols-2 gap-4">
                    <div class="p-6 bg-surface-container rounded-2xl text-center">
                        <div class="text-3xl font-extrabold text-primary mb-1 font-headline">@Model.PontosTotais</div>
                        <div class="text-stone-500 text-sm font-medium font-body">Pontos Totais</div>
                    </div>
                    <div class="p-6 bg-surface-container rounded-2xl text-center">
                        <div class="text-3xl font-extrabold text-primary mb-1 font-headline">@Model.StreakAtual</div>
                        <div class="text-stone-500 text-sm font-medium font-body">Dias consecutivos</div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
