@model EconomiaComHistoria.Core.DTOs.PerfilResponseDto
@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="max-w-6xl mx-auto min-h-screen flex flex-col pt-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <section class="lg:col-span-5 bg-surface-container-lowest rounded-3xl p-8 shadow-sm flex flex-col items-center text-center">
            <div class="relative group mb-6">
                <div class="w-40 h-40 rounded-full bg-stone-100 overflow-hidden ring-8 ring-surface-container-low shadow-inner">
                    <img class="w-full h-full object-cover" src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Nome)&background=random" alt="@Model.Nome">
                </div>
            </div>
            <h1 class="text-3xl font-headline font-extrabold text-primary mb-1">@Model.Nome</h1>
            <p class="text-stone-500 font-medium mb-6">@Model.Email</p>

            @if (!string.IsNullOrEmpty(Model.EscolaNome))
            {
            <p class="text-sm text-stone-600 font-medium">🏫 @Model.EscolaNome</p>
            }
            @if (!string.IsNullOrEmpty(Model.TurmaNome))
            {
            <p class="text-sm text-stone-600 font-medium">👥 Turma: @Model.TurmaNome</p>
            }
        </section>

        <section class="lg:col-span-7 space-y-6">
            <div class="bg-surface-container rounded-3xl p-8">
                <h2 class="text-xl font-headline font-bold text-primary mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined">person_edit</span>
                    Informações do Perfil
                </h2>
                <form class="space-y-5">
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-stone-600 ml-2">Nome Completo</label>
                        <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800" readonly value="@Model.Nome" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-stone-600 ml-2">Email</label>
                        <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800" readonly value="@Model.Email" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-stone-600 ml-2">Província</label>
                        <input class="w-full bg-surface-container-lowest border-0 rounded-2xl p-4 text-stone-800" readonly value="@(Model.Provincia ?? " Não definida")" />
                    </div>
                </form>
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-8 border border-tertiary-container/10">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                    <div class="max-w-md">
                        <h3 class="text-xl font-headline font-bold text-stone-800 mb-2">Acesso Exclusivo</h3>
                        <p class="text-sm text-stone-500 leading-relaxed">Subscreva para receber documentos inéditos do arquivo colonial e análises económicas.</p>
                    </div>
                    <button class="whitespace-nowrap bg-tertiary-container text-white font-bold py-4 px-8 rounded-full shadow-lg hover:-translate-y-0.5 transition-all flex items-center gap-3">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                        Assinar
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>