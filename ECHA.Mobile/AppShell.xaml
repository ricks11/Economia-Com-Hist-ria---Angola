<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ECHA.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:ECHA.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="ECHA.Mobile">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage" />

    <!-- Main Navigation Pages -->
    <ShellContent
        Title="Opening"
        ContentTemplate="{DataTemplate pages:OpeningPage}"
        Route="OpeningPage" />

    <ShellContent
        Title="Landing"
        ContentTemplate="{DataTemplate pages:LandingPage}"
        Route="LandingPage" />
        
    <ShellContent
        Title="Dashboard"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Explorar"
        Icon="{StaticResource IconExplore}"
        ContentTemplate="{DataTemplate pages:ExplorePage}"
        Route="ExplorePage" />

    <ShellContent
        Title="Quizzes"
        Icon="{StaticResource IconQuiz}"
        ContentTemplate="{DataTemplate pages:QuizListPage}"
        Route="QuizListPage" />

    <ShellContent
        Title="Fórum"
        Icon="{StaticResource IconForum}"
        ContentTemplate="{DataTemplate pages:ForumPage}"
        Route="ForumPage" />

    <ShellContent
        Title="Perfil"
        Icon="{StaticResource IconProfile}"
        ContentTemplate="{DataTemplate pages:ProfilePage}"
        Route="ProfilePage" />

    <!-- Additional Page Routes (not in bottom nav) -->
    <ShellContent
        Title="ContentDetail"
        ContentTemplate="{DataTemplate pages:ContentDetailPage}"
        Route="ContentDetailPage" />

    <ShellContent
        Title="CreateTopic"
        ContentTemplate="{DataTemplate pages:CreateTopicPage}"
        Route="CreateTopicPage" />

    <ShellContent
        Title="TopicDetail"
        ContentTemplate="{DataTemplate pages:TopicDetailPage}"
        Route="TopicDetailPage" />

    <ShellContent
        Title="Quiz"
        ContentTemplate="{DataTemplate pages:QuizPage}"
        Route="QuizPage" />

    <ShellContent
        Title="Ranking"
        ContentTemplate="{DataTemplate pages:RankingPage}"
        Route="RankingPage" />

    <ShellContent
        Title="TurmaRanking"
        ContentTemplate="{DataTemplate pages:TurmaRankingPage}"
        Route="TurmaRankingPage" />

    <ShellContent
        Title="TeacherDashboard"
        ContentTemplate="{DataTemplate pages:TeacherDashboardPage}"
        Route="TeacherDashboardPage" />

    <ShellContent
        Title="Map"
        ContentTemplate="{DataTemplate pages:MapPage}"
        Route="MapPage" />

    <ShellContent
        Title="StudyPlan"
        ContentTemplate="{DataTemplate pages:StudyPlanPage}"
        Route="StudyPlanPage" />

    <ShellContent
        Title="Notifications"
        ContentTemplate="{DataTemplate pages:NotificationsPage}"
        Route="NotificationsPage" />

    <ShellContent
        Title="Achievements"
        ContentTemplate="{DataTemplate pages:AchievementsPage}"
        Route="AchievementsPage" />

    <ShellContent
        Title="Faq"
        ContentTemplate="{DataTemplate pages:FaqPage}"
        Route="FaqPage" />

    <ShellContent
        Title="Contact"
        ContentTemplate="{DataTemplate pages:ContactPage}"
        Route="ContactPage" />

    <ShellContent
        Title="TermsAndPrivacy"
        ContentTemplate="{DataTemplate pages:TermsAndPrivacyPage}"
        Route="TermsAndPrivacyPage" />

    <ShellContent
        Title="SearchResults"
        ContentTemplate="{DataTemplate pages:SearchResultsPage}"
        Route="SearchResultsPage" />

    <ShellContent
        Title="Error404"
        ContentTemplate="{DataTemplate pages:Error404Page}"
        Route="Error404Page" />

    <ShellContent
        Title="JindungoAccess"
        ContentTemplate="{DataTemplate pages:JindungoAccessPage}"
        Route="JindungoAccessPage" />

    <ShellContent
        Title="LundaHeritageAbout"
        ContentTemplate="{DataTemplate pages:LundaHeritageAboutPage}"
        Route="LundaHeritageAboutPage" />

    <ShellContent
        Title="LundaHeritageArquivos"
        ContentTemplate="{DataTemplate pages:LundaHeritageArquivosPage}"
        Route="LundaHeritageArquivosPage" />

    <ShellContent
        Title="LundaHeritagePatrimonio"
        ContentTemplate="{DataTemplate pages:LundaHeritagePatrimonioPage}"
        Route="LundaHeritagePatrimonioPage" />

    <ShellContent
        Title="InstitutionalPages"
        ContentTemplate="{DataTemplate pages:InstitutionalPages}"
        Route="InstitutionalPages" />

</Shell>
