<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.TermsAndPrivacyPage"
             x:DataType="pageModels:TermsAndPrivacyPageModel"
             Title="Termos e Privacidade"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Padding="24">
        <VerticalStackLayout Spacing="24">
            <!-- Header -->
            <VerticalStackLayout Spacing="8">
                <Label 
                    Text="Termos de Uso"
                    FontAttributes="Bold"
                    FontSize="32"
                    TextColor="{StaticResource OnSurface}"/>
            </VerticalStackLayout>

            <!-- Terms Content -->
            <VerticalStackLayout Spacing="16">
                <Label 
                    Text="Ao aceder ao portal, concorda com estes termos. O conteúdo destina-se apenas a fins educativos."
                    FontSize="16"
                    TextColor="{StaticResource OnSurfaceVariant}"/>

                <VerticalStackLayout Spacing="8">
                    <Label 
                        Text="Privacidade"
                        FontAttributes="Bold"
                        FontSize="20"
                        TextColor="{StaticResource Primary}"/>
                    <Label 
                        Text="Coletamos apenas dados necessários para a sua conta académica. Não partilhamos dados com terceiros."
                        FontSize="16"
                        TextColor="{StaticResource OnSurfaceVariant}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label 
                        Text="Propriedade Intelectual"
                        FontAttributes="Bold"
                        FontSize="20"
                        TextColor="{StaticResource Primary}"/>
                    <Label 
                        Text="Todo o conteúdo disponível na plataforma é protegido por direitos autorais. É permitido o uso para fins educacionais."
                        FontSize="16"
                        TextColor="{StaticResource OnSurfaceVariant}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label 
                        Text="Responsabilidades"
                        FontAttributes="Bold"
                        FontSize="20"
                        TextColor="{StaticResource Primary}"/>
                    <Label 
                        Text="Os utilizadores são responsáveis por manter a confidencialidade das suas credenciais e por qualquer atividade realizada com as mesmas."
                        FontSize="16"
                        TextColor="{StaticResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
