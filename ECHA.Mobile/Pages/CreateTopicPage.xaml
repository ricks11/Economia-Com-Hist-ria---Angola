<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.CreateTopicPage"
             x:DataType="pageModels:CreateTopicPageModel"
             Title="Novo Tópico">

    <StackLayout Padding="20" Spacing="10">
        <Entry Text="{Binding Titulo}" Placeholder="Título" />
        <Editor Text="{Binding Descricao}" Placeholder="Descrição" HeightRequest="150" />
        <Button Text="Criar Tópico" Command="{Binding CriarTopicoCommand}" />
    </StackLayout>
</ContentPage>
