<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:controls="clr-namespace:ECHA.Mobile.Controls"
             x:Class="ECHA.Mobile.Pages.ProfilePage"
             x:DataType="pageModels:ProfilePageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" Padding="24,16,24,24" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24">
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🗺️" FontSize="22" VerticalTextAlignment="Center" />
                        <Label Text="Economia com História"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="⚙️" FontSize="22" />
                </Grid>

                <!-- Profile header -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Grid WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                        <Border WidthRequest="96" HeightRequest="96"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 48"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}">
                            <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuBDIaofLpZ-tu1GjZnRGTDq65KFZFrSqohRiWmQmyChRj9hsyF6dAnGhnazTJHYBn9u5e0IyVN7XWF1dVOPXKFCNe11bS8nTF-jHaD7Fc6fbbwq_t48HjWCKebmtMjLa7gof9awFzyjAXs9bPV6bStXM6zJwAzBX4dnaOKg9o2JEzA8HKuqF_Kx72yJgj6qaLvZLSA3q2wiqQe09uEzUOQpaZKf9xXw50SDlmBUVLRSBWgQIl6j2-xCMyornIJ1ht-LT5MWZbdHKd1S"
                                   Aspect="AspectFill" />
                        </Border>
                        <Border WidthRequest="28" HeightRequest="28"
                                BackgroundColor="{StaticResource ActionYellow}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Label Text="✓" FontSize="14" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding DisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding DisplaySubtitle}"
                           FontSize="13"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Badges -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Badges Conquistadas" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource OnSurface}" />
                        <Label Grid.Column="1" Text="Ver Todos" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoAchievementsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="100" BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🏅" FontSize="28" HorizontalTextAlignment="Center" />
                                    <Label Text="Pioneira Económica" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurface}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border WidthRequest="100" BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="📜" FontSize="28" HorizontalTextAlignment="Center" />
                                    <Label Text="Historiadora Local" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurface}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border WidthRequest="100" BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="💎" FontSize="28" HorizontalTextAlignment="Center" />
                                    <Label Text="Expert em Diamantes" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurface}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border WidthRequest="100" BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🔒" FontSize="28" HorizontalTextAlignment="Center" />
                                    <Label Text="???" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Premium -->
                <Border BackgroundColor="{StaticResource Tertiary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Premium Access" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource OnTertiary}" />
                        <Label Text="Conteúdos Exclusivos" FontSize="13" TextColor="{StaticResource OnTertiaryContainer}" />
                        <Label Text="Acesse relatórios profundos sobre a economia colonial e dados exclusivos de 2024."
                               FontSize="12" TextColor="{StaticResource OnTertiaryContainer}" LineHeight="1.35" />
                        <Button Text="Subscrever por 1.500 Kz/mês"
                                BackgroundColor="{StaticResource ActionYellow}"
                                TextColor="{StaticResource OnActionYellow}"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="8"
                                Padding="16,12"
                                HorizontalOptions="Start"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Activity -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="📊  Atividade Recente" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource OnSurface}" />
                    <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Histórico de Aprendizagem" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource OnSurface}" />
                            <Label Text="Indústria de Petróleo (1950)" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                            <ProgressBar Progress="0.85" ProgressColor="{StaticResource Primary}" />
                            <Label Text="85% Completo" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="❓" FontSize="20" />
                                <Label Text="Meus Quizzes" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource OnSurface}" />
                                <Label Text="12" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="Concluídos com sucesso" FontSize="11" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="⬇️" FontSize="20" />
                                <Label Text="Offline" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource OnSurface}" />
                                <Label Text="Módulos guardados" FontSize="11" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Settings -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Gestão e Privacidade" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource OnSurface}" Margin="0,0,0,8" />
                    <Border BackgroundColor="{StaticResource SurfaceContainerLowest}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="👤" FontSize="18" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Detalhes da Conta" FontSize="14" TextColor="{StaticResource OnSurface}" VerticalTextAlignment="Center" Margin="12,0" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Gray400}" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="{StaticResource SurfaceContainerLowest}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="☁️" FontSize="18" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Gerenciar Downloads" FontSize="14" TextColor="{StaticResource OnSurface}" VerticalTextAlignment="Center" Margin="12,0" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Gray400}" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="{StaticResource SurfaceContainerLowest}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="🔑" FontSize="18" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Alterar Password" FontSize="14" TextColor="{StaticResource OnSurface}" VerticalTextAlignment="Center" Margin="12,0" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Gray400}" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="{StaticResource ErrorContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,14" Margin="0,8,0,0">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🚪" FontSize="18" VerticalTextAlignment="Center" />
                            <Label Text="Sair da Conta" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Error}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNav Grid.Row="1" ActiveTab="perfil" />
    </Grid>
</ContentPage>
