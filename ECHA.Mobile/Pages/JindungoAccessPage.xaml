<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.JindungoAccessPage"
             x:DataType="pageModels:JindungoAccessPageModel"
             Title="Acesso ao Jindungo"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid>
        <!-- Background Watermark (Placeholder) -->
        <AbsoluteLayout Opacity="0.1">
            <BoxView Color="{StaticResource OutlineVariant}" />
        </AbsoluteLayout>

        <ScrollView>
            <VerticalStackLayout Padding="24, 120, 24, 120" Spacing="24">
                <!-- Context Label -->
                <Border Padding="12, 4" 
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        StrokeShape="RoundRectangle 12"
                        HorizontalOptions="Start">
                    <Label Text="Texto com Jindungo"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="{StaticResource OnSurfaceVariant}"/>
                </Border>

                <!-- Headline -->
                <Label Text="A Economia Informal de Luanda no Pós-Guerra"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}"/>

                <!-- Locked Content Card -->
                <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                        Stroke="{StaticResource OutlineVariant}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="24">
                    <VerticalStackLayout Spacing="20">
                        <!-- Decorative Top Bar -->
                        <BoxView HeightRequest="4" 
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="-24, -24, -24, 0"
                                 CornerRadius="12, 12, 0, 0"/>

                        <!-- Lock Icon -->
                        <Border WidthRequest="80"
                                HeightRequest="80"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                StrokeShape="RoundRectangle 40"
                                HorizontalOptions="Center">
                            <Label Text="lock"
                                   FontFamily="FluentSystemIcons-Regular"
                                   FontSize="40"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- Title & Description -->
                        <Label Text="Arquivo Fechado"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Este documento contém análises aprofundadas e dados sensíveis exclusivos para curadores autorizados. Por favor, solicite acesso para ler a pesquisa completa."
                               FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center"/>

                        <!-- Request Button -->
                        <Button Text="Solicitar Acesso à Leitura"
                                Command="{Binding RequestAccessCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource OnPrimary}"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="8"
                                Padding="24, 16"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
