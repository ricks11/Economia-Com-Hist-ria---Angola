<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:controls="clr-namespace:ECHA.Mobile.Controls"
             x:Class="ECHA.Mobile.Pages.QuizPage"
             x:DataType="pageModels:QuizPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" Padding="24,16,24,24" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24">
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🗺️" FontSize="22" VerticalTextAlignment="Center" />
                        <Label Text="Economia com História"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource ActionYellow}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,6">
                        <Label Text="{Binding XpLabel}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource OnActionYellow}" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ModuleLabel}"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Quiz de Economia"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                    <Label Text="{Binding ProgressLabel}"
                           FontSize="13"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <ProgressBar Progress="{Binding Progress}"
                             ProgressColor="{StaticResource Primary}"
                             HeightRequest="6" />

                <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1A1C1C" Opacity="0.05" Radius="24" Offset="0,6" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{Binding QuestionText}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               LineHeight="1.35" />
                        <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="📜" FontSize="16" VerticalTextAlignment="Center" />
                                <Label Text="Contexto Histórico"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:QuizOptionCard">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectOptionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryFixed}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Text}"
                                       FontSize="15"
                                       TextColor="{StaticResource OnSurface}"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Ranking preview -->
                <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Ranking Regional" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource OnSurface}" />
                            <Label Grid.Column="1" Text="Ver todos" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Text="1º" FontAttributes="Bold" TextColor="{StaticResource ActionYellow}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Luanda" TextColor="{StaticResource OnSurface}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="15.4k pts" TextColor="{StaticResource OnSurfaceVariant}" FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Text="2º" FontAttributes="Bold" TextColor="{StaticResource Gray400}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Huambo" TextColor="{StaticResource OnSurface}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="12.1k pts" TextColor="{StaticResource OnSurfaceVariant}" FontSize="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Tertiary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ℹ️  Dica de Especialista:"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="{StaticResource OnTertiary}" />
                        <Label Text="O café representou quase 50% das exportações totais de Angola por décadas, impulsionando o desenvolvimento infraestrutural da época."
                               FontSize="12"
                               TextColor="{StaticResource OnTertiaryContainer}"
                               LineHeight="1.35" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Próximo  →"
                        Command="{Binding NextQuestionCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="8"
                        Padding="16,16" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNav Grid.Row="1" ActiveTab="jogar" />
    </Grid>
</ContentPage>
