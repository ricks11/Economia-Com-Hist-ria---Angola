<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:models="clr-namespace:ECHA.Mobile.Models"
             x:Class="ECHA.Mobile.Pages.RankingPage"
             x:DataType="pageModels:RankingPageModel"
             Title="Ranking">

    <CollectionView ItemsSource="{Binding Rankings}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:RankingItemDto">
                <HorizontalStackLayout Spacing="10" Padding="10">
                    <Label Text="{Binding NomeEstudante}" FontAttributes="Bold" />
                    <Label Text="{Binding Pontuacao}" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
