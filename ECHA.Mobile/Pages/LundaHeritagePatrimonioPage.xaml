<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.LundaHeritagePatrimonioPage"
             x:DataType="pageModels:LundaHeritagePatrimonioPageModel"
             Title="O Meu Progresso"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Padding="24">
        <VerticalStackLayout Spacing="24">
            <Label Text="O Meu Progresso"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurface}"/>

            <!-- Progress Card -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="24">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Jornada Académica"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnPrimary}"/>
                    
                    <Label Text="{Binding ProgressoTexto}"
                           FontSize="14"
                           TextColor="{StaticResource OnPrimary}"
                           Opacity="0.8"/>
                    
                    <ProgressBar Progress="{Binding ProgressoPercent}" 
                                 ProgressColor="{StaticResource ActionYellow}" 
                                 HeightRequest="8"/>
                </VerticalStackLayout>
            </Border>

            <!-- Completed Modules Section -->
            <Label Text="Módulos Completados" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource OnSurface}" 
                   Margin="0,8,0,0"/>

            <CollectionView ItemsSource="{Binding ModulosCompletados}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pageModels:LundaHeritagePatrimonioPageModel+Modulo">
                        <Border BackgroundColor="{StaticResource SurfaceContainerLowest}" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 12" 
                                Padding="16" 
                                Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, *">
                                <!-- Check Icon -->
                                <Border Grid.Column="0" 
                                        WidthRequest="32" 
                                        HeightRequest="32" 
                                        BackgroundColor="{StaticResource SurfaceContainerLow}" 
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 16" 
                                        Margin="0,0,16,0"
                                        VerticalOptions="Center">
                                    <Label Text="✓" 
                                           TextColor="{StaticResource Primary}" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           FontAttributes="Bold"/>
                                </Border>
                                
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource OnSurface}"/>
                                    <Label Text="{Binding Descricao}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource OnSurfaceVariant}" 
                                           Margin="0,4,0,4"/>
                                    <Label Text="{Binding DataConclusao}" 
                                           FontSize="10" 
                                           TextColor="{StaticResource Primary}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
