<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.LundaHeritageArquivosPage"
             x:DataType="pageModels:LundaHeritageArquivosPageModel"
             Title="Arquivos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Padding="24">
        <VerticalStackLayout Spacing="24">
            <Label Text="Arquivos"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurface}"/>

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Arquivos}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pageModels:LundaHeritageArquivosPageModel/ArquivoItem">
                        <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                Stroke="{StaticResource OutlineVariant}"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
                            <HorizontalStackLayout Spacing="12">
                                <Border WidthRequest="48"
                                        HeightRequest="48"
                                        BackgroundColor="{StaticResource SurfaceContainerLow}"
                                        StrokeShape="RoundRectangle 8">
                                    <Label Text="{Binding Icon}"
                                           FontSize="24"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource OnSurface}"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{StaticResource OnSurfaceVariant}"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
