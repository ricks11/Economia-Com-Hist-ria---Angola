<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.NotificationsPage"
             x:DataType="pageModels:NotificationsPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Content>
        <ScrollView Padding="24">
            <VerticalStackLayout Spacing="24">
                <Label 
                    Text="Notificações"
                    FontAttributes="Bold"
                    FontSize="32"
                    TextColor="{StaticResource OnSurface}"/>
                <Label 
                    Text="Em breve, suas notificações aparecerão aqui!"
                    FontSize="16"
                    TextColor="{StaticResource OnSurfaceVariant}"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
