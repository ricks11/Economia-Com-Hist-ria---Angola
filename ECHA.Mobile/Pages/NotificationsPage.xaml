<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:controls="clr-namespace:ECHA.Mobile.Controls"
             x:Class="ECHA.Mobile.Pages.NotificationsPage"
             x:DataType="pageModels:NotificationsPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" Padding="24,16,24,24" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="←" FontSize="24" TextColor="{StaticResource OnSurface}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1"
                           Text="Notificações"
                           FontAttributes="Bold"
                           FontSize="20"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{StaticResource OnSurface}" />
                    <Label Grid.Column="2" Text="⚙️" FontSize="20" />
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Todas"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="16"
                                Padding="16,8" />
                        <Button Text="Comunidade"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="12"
                                CornerRadius="16"
                                Padding="16,8" />
                        <Button Text="Aprendizagem"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="12"
                                CornerRadius="16"
                                Padding="16,8" />
                        <Button Text="Sistema"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="12"
                                CornerRadius="16"
                                Padding="16,8" />
                    </HorizontalStackLayout>
                </ScrollView>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Notifications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:NotificationCard">
                            <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="#1A1C1C" Opacity="0.04" Radius="16" Offset="0,4" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border WidthRequest="44" HeightRequest="44"
                                            BackgroundColor="{StaticResource SurfaceContainerLow}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22">
                                        <Label Text="{Binding Icon}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               FontSize="18" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource OnSurface}" />
                                        <Label Text="{Binding Body}" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" LineHeight="1.35" />
                                        <Label Text="{Binding TimeAgo}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding ShowActions}" Margin="0,4,0,0">
                                            <Button Text="Aceitar"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="8"
                                                    Padding="14,8" />
                                            <Button Text="Recusar"
                                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                                    TextColor="{StaticResource OnSurface}"
                                                    FontSize="12"
                                                    CornerRadius="8"
                                                    Padding="14,8" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNav Grid.Row="1" ActiveTab="inicio" />
    </Grid>
</ContentPage>
