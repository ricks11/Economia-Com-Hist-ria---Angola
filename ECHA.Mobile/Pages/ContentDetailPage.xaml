<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:converters="clr-namespace:ECHA.Mobile.Converters"
             x:Class="ECHA.Mobile.Pages.ContentDetailPage"
             x:DataType="pageModels:ContentDetailPageModel"
             Title="{Binding Conteudo.Titulo}">

    <ContentPage.Resources>
        <converters:BoolToFavoritoConverter x:Key="BoolToFavoritoConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            <Label Text="{Binding Conteudo.Titulo}" FontSize="24" FontAttributes="Bold" />
            
            <!-- Media Player Placeholder -->
            <BoxView HeightRequest="200" Color="Gray" />
            
            <Label Text="{Binding Conteudo.Descricao}" />
            
            <Picker Title="Selecionar Língua" 
                    ItemsSource="{Binding Conteudo.Traducoes}"
                    ItemDisplayBinding="{Binding Lingua}"
                    SelectedIndexChanged="OnLanguageChanged" />
            
            <Button Text="{Binding Conteudo.IsFavorito, Converter={StaticResource BoolToFavoritoConverter}}"
                    Command="{Binding ToggleFavoritoCommand}" />
        </StackLayout>
    </ScrollView>
</ContentPage>
