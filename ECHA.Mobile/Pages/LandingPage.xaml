<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:controls="clr-namespace:ECHA.Mobile.Controls"
             x:Class="ECHA.Mobile.Pages.LandingPage"
             x:DataType="pageModels:LandingPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto">
        <Image Grid.RowSpan="2"
               Source="https://lh3.googleusercontent.com/aida-public/AB6AXuBs15Sv1Id7SIzXyTKDEsDMWLo4-bbKouMKVL0wLZ-Pqx_NRU8e2fUpRiuKDXsNPzUzSwXzTa2UA0pHHWV0RiLqFrEzDZrzpevBv4pMS8K58lW60VuqfLnoozyHJcGa8g1uXlYYOpySFNF-PziOZNPvfhYiCOUCJbVemChEYhIxewuUIyGXUZeUnuetsQD_QCAfD-tzv3fgqMnTfZugqRnQpePc1fClft98sjdRhWIl1gCT2zAoftMyQPLoTn3mjbo6ptuUVHKb2USg"
               Aspect="AspectFill"
               Opacity="0.05"
               InputTransparent="True" />

        <ScrollView Grid.Row="0" Padding="24,16,24,24" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="48">
                <!-- Top bar -->
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                    <Label Text="☰" FontSize="24" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                    <Label Grid.Column="1"
                           Text="THE SOVEREIGN ARCHIVE"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold"
                           FontSize="12"
                           CharacterSpacing="2"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                    <Border Grid.Column="2"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuBwFkjKQE1BEDorMg80k01mDTDVRkLWA0s4yIK9ORvv6xgNm1_SjZbY4itbttLz68PcN7U5WnPpVXj2b1pfcC_8WgTIpTNZ4dYCUlkwzibM1rb_HQK0ofEmAh9619-fHGGeyv9HMFgxWcpT7JSsgk7EOmtBcIF-DGEz1e-DkCV_DXt6mQgGMLUEnlUnOBRS22N8wbqgf2XVsiup9nRbvcF96vB3d1rSjEn_4dXZ_ACIpjzRxt2yxIzORNiX5xl8DtvAOXOkS0vhDYoW"
                               Aspect="AspectFill" />
                    </Border>
                </Grid>

                <!-- Hero -->
                <VerticalStackLayout Spacing="20" Padding="8,16,16,0">
                    <Label FontSize="36" FontAttributes="Bold" LineHeight="1.15">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Desvende a&#10;" TextColor="{StaticResource OnSurface}" />
                                <Span Text="História Económica" TextColor="{StaticResource Primary}" />
                                <Span Text="&#10;de Angola." TextColor="{StaticResource OnSurface}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding Subtitle}"
                           FontSize="16"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           LineHeight="1.45" />
                    <Button Text="COMEÇAR JORNADA"
                            Command="{Binding StartJourneyCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CharacterSpacing="1"
                            CornerRadius="6"
                            Padding="24,18"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>

                <!-- Hero image -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="320"
                        BackgroundColor="{StaticResource SurfaceContainerLow}">
                    <Border.Shadow>
                        <Shadow Brush="#1A1C1C" Opacity="0.06" Radius="32" Offset="0,8" />
                    </Border.Shadow>
                    <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuDr29F1nVqcD55AlvPNxwKVBpCb-4tn4l5Nyc9YkziylVq0UZdng0VGYXnLY0dhMmxFaZoFKNg3jYIllsASSz1NgkKgwjt-Ar6QFnN3FKcc90Lbn-Xdg5oA0UJm7HdsI7bKYJNsQTytMeyv3cdCqEhgj4J3pL55aExrhgW2n9RN-CWm3HsxgjNKcKixyE4yTohH3W4Ydq5B2vV8Qkb6b-AfSp00vqF-feWwv84VeNGGn-RiLnoYjS8AnRwPAOLx1eaz_tZ_gT2xDMel"
                           Aspect="AspectFill" />
                </Border>

                <!-- Pillars -->
                <VerticalStackLayout Spacing="24">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Os Pilares do Conhecimento"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}" />
                        <Label Text="Metodologia estruturada para uma compreensão profunda."
                               FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="24">
                        <Border.Shadow>
                            <Shadow Brush="#1A1C1C" Opacity="0.06" Radius="32" Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="20">
                            <Border WidthRequest="48" HeightRequest="48"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="📚" FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Educação Estruturada" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource OnSurface}" />
                                <Label Text="Módulos curatoriais focados em dados económicos reais e contexto histórico rigoroso, apresentados em formato editorial."
                                       FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" LineHeight="1.4" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="24">
                        <VerticalStackLayout Spacing="20">
                            <Border WidthRequest="48" HeightRequest="48"
                                    BackgroundColor="{StaticResource Surface}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Border.Shadow>
                                    <Shadow Brush="#1A1C1C" Opacity="0.06" Radius="16" Offset="0,4" />
                                </Border.Shadow>
                                <Label Text="🎮" FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Gamificação Subtil" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource OnSurface}" />
                                <Label Text="Avalie o seu conhecimento através de interações inteligentes e desbloqueie marcos históricos ao longo da sua jornada."
                                       FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" LineHeight="1.4" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="24">
                        <Border.Shadow>
                            <Shadow Brush="#1A1C1C" Opacity="0.06" Radius="32" Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="20">
                            <Border WidthRequest="48" HeightRequest="48"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="👥" FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Comunidade de Curadores" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource OnSurface}" />
                                <Label Text="Participe em debates qualificados, partilhe perspetivas e contribua para o arquivo coletivo do conhecimento económico angolano."
                                       FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" LineHeight="1.4" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CTA -->
                <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="32">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Label Text="Pronto para explorar o Arquivo?"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Aceda a artigos exclusivos, dados interativos e análises profundas."
                               FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="CRIAR CONTA"
                                Command="{Binding CreateAccountCommand}"
                                BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                TextColor="{StaticResource OnSurface}"
                                FontAttributes="Bold"
                                FontSize="13"
                                CharacterSpacing="1"
                                CornerRadius="6"
                                Padding="24,14"
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNav Grid.Row="1" ActiveTab="inicio" />
    </Grid>
</ContentPage>
