<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:controls="clr-namespace:ECHA.Mobile.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ECHA.Mobile.Pages.ForumPage"
             x:DataType="pageModels:ForumPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadTopicosCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,16,24,100" Spacing="24">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🗺️" FontSize="22" VerticalTextAlignment="Center" />
                        <Label Text="Economia com História"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               FontSize="18"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="🔔" FontSize="22" VerticalTextAlignment="Center" />
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Fórum"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                    <Label Text="Participe nas discussões sobre o legado económico de Angola."
                           FontSize="15"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- Filters -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Tudo"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource OnPrimary}"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="18,8" />
                        <Button Text="Era Colonial"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="18,8" />
                        <Button Text="Pós-Independência"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="18,8" />
                        <Button Text="Petróleo e Diamantes"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="18,8" />
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Topics (design sample + API) -->
                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding DisplayTopics}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:ForumTopicCard">
                            <Border BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="20">
                                <Border.Shadow>
                                    <Shadow Brush="#1A1C1C" Opacity="0.05" Radius="24" Offset="0,6" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border WidthRequest="36" HeightRequest="36"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18"
                                                BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                            <Label Text="{Binding AvatarEmoji}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Author}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource OnSurface}" />
                                            <Label Text="{Binding TimeAgo}" FontSize="11" TextColor="{StaticResource OnSurfaceVariant}" CharacterSpacing="0.5" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding IsJindungo}"
                                                BackgroundColor="#1AFFD700"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,4"
                                                VerticalOptions="Start">
                                            <Label Text="🔥 Jindungo" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource OnActionYellow}" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource OnSurface}" LineHeight="1.3" />
                                    <Label Text="{Binding Summary}" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" MaxLines="3" LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16" Margin="0,4,0,0">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="💬" FontSize="14" />
                                            <Label Text="{Binding Comments}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" VerticalTextAlignment="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="❤️" FontSize="14" />
                                            <Label Text="{Binding Likes}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" VerticalTextAlignment="Center" />
                                        </HorizontalStackLayout>
                                        <Button Grid.Column="3"
                                                Text="VER DISCUSSÃO →"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Primary}"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenTopicCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- FAB -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,24,24"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="#570013" Opacity="0.3" Radius="16" Offset="0,6" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CreateTopicCommand}" />
            </Border.GestureRecognizers>
            <Label Text="＋" FontSize="28" TextColor="White"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Border>

        <controls:AppBottomNav Grid.Row="1" ActiveTab="participar" />
    </Grid>
</ContentPage>
