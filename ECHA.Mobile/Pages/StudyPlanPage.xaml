<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.StudyPlanPage"
             x:DataType="pageModels:StudyPlanPageModel"
             Title="Plano de Estudo">

    <CollectionView ItemsSource="{Binding Sugestoes}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10">
                    <StackLayout>
                        <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                        <Label Text="{Binding Prioridade}" />
                    </StackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
