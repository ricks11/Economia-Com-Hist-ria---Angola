<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:dtos="clr-namespace:EconomiaComHistoria.Core.DTOs;assembly=ECHA.Core"
             x:Class="ECHA.Mobile.Pages.TeacherDashboardPage"
             x:DataType="pageModels:TeacherDashboardPageModel"
             Title="Painel do Professor">

    <CollectionView ItemsSource="{Binding Alunos}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dtos:RankingEntradaDto">
                <VerticalStackLayout Padding="10">
                    <Label Text="{Binding NomeUtilizador}" FontAttributes="Bold" />
                    <Label Text="{Binding Pontos, StringFormat='Pontos: {0}'}" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
