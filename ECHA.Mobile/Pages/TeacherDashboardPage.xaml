<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.TeacherDashboardPage"
             x:DataType="pageModels:TeacherDashboardPageModel"
             Title="Painel do Professor">

    <CollectionView ItemsSource="{Binding Alunos}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <VerticalStackLayout Padding="10">
                    <Label Text="{Binding NomeEstudante}" FontAttributes="Bold" />
                    <Label Text="{Binding ProgressoGeral, StringFormat='Progresso: {0:P}'}" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
