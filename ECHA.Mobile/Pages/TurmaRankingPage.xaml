<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ECHA.Mobile.Pages.TurmaRankingPage"
             x:DataType="pageModels:TurmaRankingPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadRankingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="24,20,24,10" BackgroundColor="{StaticResource Background}">
            <ImageButton Source="back_icon.png" 
                         Command="{Binding GoBackCommand}"
                         WidthRequest="24" 
                         HeightRequest="24"
                         VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="-24,0,0,0">
                <Label Text="Ranking da Turma"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}"
                       HorizontalOptions="Center" />
                <Label Text="Turma 10A"
                       FontSize="13"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Padding="24,16,24,24" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24">
                
                <!-- Podium -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HeightRequest="190" VerticalOptions="End">
                    <!-- 2nd Place -->
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="6" HorizontalOptions="Center">
                        <Grid>
                            <Border WidthRequest="40" HeightRequest="40"
                                    Stroke="{StaticResource OutlineVariant}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,10">
                                <Label Text="{Binding SecondPlace.Initials}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource SurfaceContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="4,2"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="0,0,-8,0">
                                <Label Text="2" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource OnSurface}"/>
                            </Border>
                        </Grid>
                        <Label Text="{Binding SecondPlace.NomeUtilizador}" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding SecondPlace.Pontos, StringFormat='{0} pts'}" FontSize="11" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    
                    <!-- 1st Place -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="6" HorizontalOptions="Center">
                        <Label Text="👑" FontSize="22" HorizontalTextAlignment="Center" />
                        <Grid>
                            <Border WidthRequest="56" HeightRequest="56"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 28"
                                    BackgroundColor="{StaticResource PrimaryContainer}"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,10">
                                <Label Text="{Binding FirstPlace.Initials}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="18" TextColor="{StaticResource Primary}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6,2"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="0,0,-8,0">
                                <Label Text="1" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                            </Border>
                        </Grid>
                        <Label Text="{Binding FirstPlace.NomeUtilizador}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding FirstPlace.Pontos, StringFormat='{0} pts'}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                    
                    <!-- 3rd Place -->
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="End" Spacing="6" HorizontalOptions="Center">
                        <Grid>
                            <Border WidthRequest="40" HeightRequest="40"
                                    Stroke="{StaticResource OutlineVariant}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,10">
                                <Label Text="{Binding ThirdPlace.Initials}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource SurfaceContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="4,2"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="0,0,-8,0">
                                <Label Text="3" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource OnSurface}"/>
                            </Border>
                        </Grid>
                        <Label Text="{Binding ThirdPlace.NomeUtilizador}" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding ThirdPlace.Pontos, StringFormat='{0} pts'}" FontSize="11" HorizontalTextAlignment="Center" TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Segmented Tabs -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Stroke="{StaticResource Primary}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource Primary}"
                            Padding="0">
                        <Button Text="Geral"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="8,8" />
                    </Border>
                    <Border Grid.Column="1"
                            Stroke="{StaticResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            Padding="0">
                        <Button Text="Por Quiz"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="8,8" />
                    </Border>
                    <Border Grid.Column="2"
                            Stroke="{StaticResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            Padding="0">
                        <Button Text="Semanal"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                FontSize="13"
                                CornerRadius="20"
                                Padding="8,8" />
                    </Border>
                </Grid>

                <!-- Ranking List -->
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding DisplayRankings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:TurmaRankingItemViewModel">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16,12"
                                    BackgroundColor="{StaticResource SurfaceContainerLowest}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrentUser}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerLow}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <Grid ColumnDefinitions="30, 40, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Label Grid.Column="0" 
                                           Text="{Binding Posicao}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalTextAlignment="Center"
                                           HorizontalTextAlignment="Center" />
                                           
                                    <Border Grid.Column="1" 
                                            WidthRequest="40" HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource SurfaceContainer}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Initials}" 
                                               FontAttributes="Bold" 
                                               HorizontalTextAlignment="Center" 
                                               VerticalTextAlignment="Center" 
                                               FontSize="14" 
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding NomeUtilizador}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource OnSurface}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrentUser}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="Luanda" FontSize="11" TextColor="{StaticResource OnSurfaceVariant}" />
                                    </VerticalStackLayout>
                                    
                                    <Label Grid.Column="3" 
                                           Text="{Binding Pontos, StringFormat='{0} pts'}" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           TextColor="{StaticResource OnSurface}" 
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCurrentUser}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Footer Incentive Card -->
                <Border BackgroundColor="{StaticResource Tertiary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Torne-se o Número 1!"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="White" />
                        <Label Text="Complete os desafios desta semana para ganhar pontos extras e subir no ranking da turma."
                               FontSize="13"
                               TextColor="#E0F2F1" /> <!-- Light cyan for contrast -->
                        <!-- Primary Gradient Button Mock -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Primary}"
                                Padding="0"
                                HorizontalOptions="Start">
                             <Button Text="Aprender Agora"
                                     BackgroundColor="Transparent"
                                     TextColor="White"
                                     FontAttributes="Bold"
                                     FontSize="13"
                                     Padding="20,12" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
