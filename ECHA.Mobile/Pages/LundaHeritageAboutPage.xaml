<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ECHA.Mobile.PageModels"
             x:Class="ECHA.Mobile.Pages.LundaHeritageAboutPage"
             x:DataType="pageModels:LundaHeritageAboutPageModel"
             Title="Sobre o Projecto"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Padding="24">
        <VerticalStackLayout Spacing="24">
            <Label Text="Sobre o Projecto"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurface}"/>

            <VerticalStackLayout Spacing="16">
                <Label Text="Economia com História – Angola é um arquivo digital dedicado à preservação da trajetória económica nacional."
                       FontSize="16"
                       TextColor="{StaticResource OnSurfaceVariant}"/>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Missão"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Disponibilizar fontes para investigadores e cidadãos interessados na história económica angolana."
                           FontSize="16"
                           TextColor="{StaticResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
